NODE_ENV=production
PORT=3000
BACKEND_PORT=3100
PUBLIC_BASE_URL=https://test.yunshecun.com
UPLOAD_BASE_URL=/uploads
CORS_ORIGIN=https://test-admin.yunshecun.com

MYSQL_DATABASE=yunshecun_test
