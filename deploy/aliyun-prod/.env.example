NODE_ENV=production
PORT=3000
BACKEND_PORT=3101
DATA_SOURCE=snapshot
# 已有生产卷需要在备份后显式同步。
SYNC_CONTENT=0
SYNC_UPLOADS=0
PUBLIC_BASE_URL=https://你的正式域名
UPLOAD_BASE_URL=/uploads
CORS_ORIGIN=https://你的后台域名

MYSQL_DATABASE=yunshecun_prod
MYSQL_USER=yunshecun
MYSQL_PASSWORD=change_this_mysql_password
MYSQL_ROOT_PASSWORD=change_this_root_password
DATABASE_URL=mysql://yunshecun:change_this_mysql_password@mysql:3306/yunshecun_prod

# 当前云主机报告核实的支付证书目录；正式商户证书不同则填写实际目录。
CERTIFICATE_DIR=/home/project-2026/certs/test
MIGRATION_BACKUP_DIR=/home/project-2026/deploy-backups/yunshecun-migration-YYYYMMDD
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PAY_CERT_PATH=/app/certs/apiclient_cert.pem

JWT_SECRET=replace_with_a_random_long_secret
ADMIN_JWT_SECRET=replace_with_a_different_random_long_secret
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=/api/notify/payOk
WECHAT_PAY_PAY_NOTIFY_URL=/api/notify/payOk
WECHAT_PAY_TICKET_NOTIFY_URL=/api/notify/payTicketOk
WECHAT_PAY_REFUND_NOTIFY_URL=/api/notify/refundOk
