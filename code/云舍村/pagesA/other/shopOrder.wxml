<view class="so-wrap">
  <!-- 收货信息 -->
  <view class="so-card">
    <view class="so-card-title" style="display:flex;justify-content:space-between">
      <text>收货信息</text>
      <text class="so-addr-btn" bindtap="chooseAddress">从地址簿选择 ›</text>
    </view>
    <!-- 已选地址展示 -->
    <view class="so-selected-addr" wx:if="{{selectedAddr}}" bindtap="chooseAddress">
      <view class="so-addr-name">{{selectedAddr.name}} {{selectedAddr.phone}}</view>
      <view class="so-addr-detail">{{selectedAddr.province}}{{selectedAddr.city}}{{selectedAddr.district}} {{selectedAddr.address}}</view>
    </view>
    <view class="so-field">
      <text class="so-label">收件人 *</text>
      <input class="so-input" value="{{form.contactName}}" placeholder="请输入姓名" bindinput="onInput" data-key="contactName"/>
    </view>
    <view class="so-field">
      <text class="so-label">手机号 *</text>
      <input class="so-input" type="number" value="{{form.contactPhone}}" placeholder="请输入手机号" bindinput="onInput" data-key="contactPhone" maxlength="11"/>
    </view>
    <view class="so-field">
      <text class="so-label">省份</text>
      <input class="so-input" value="{{form.province}}" placeholder="如：四川省" bindinput="onInput" data-key="province"/>
    </view>
    <view class="so-field">
      <text class="so-label">城市</text>
      <input class="so-input" value="{{form.city}}" placeholder="如：成都市" bindinput="onInput" data-key="city"/>
    </view>
    <view class="so-field">
      <text class="so-label">详细地址 *</text>
      <input class="so-input" value="{{form.address}}" placeholder="街道、门牌号等" bindinput="onInput" data-key="address"/>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="so-card">
    <view class="so-card-title">商品信息</view>
    <view class="so-goods-row">
      <view class="so-goods-name">{{productName}}</view>
      <view class="so-goods-qty">× {{qty}}</view>
    </view>
    <view class="so-field">
      <text class="so-label">留言备注</text>
      <input class="so-input" value="{{form.notes}}" placeholder="选填，如有特殊要求请备注" bindinput="onInput" data-key="notes"/>
    </view>
  </view>

  <!-- 价格汇总 -->
  <view class="so-card so-summary">
    <view class="so-summary-row">
      <text>商品金额</text><text>¥{{price}}</text>
    </view>
    <view class="so-summary-row">
      <text>运费</text><text style="color:#27ae60">免运费</text>
    </view>
    <view class="so-summary-row so-summary-total">
      <text>合计</text><text style="color:#e05d44;font-weight:700">¥{{price}}</text>
    </view>
  </view>

  <!-- 提交 -->
  <view class="so-bottom">
    <view class="so-my-orders" bindtap="goMyOrders">查看我的订单</view>
    <view class="so-submit-btn {{(submitting||paying)?'disabled':''}}" bindtap="submit">{{submitting ? '提交中...' : paying ? '支付中...' : '提交并支付'}}</view>
  </view>
  <view style="height:100rpx"></view>
</view>
