page { background: #f5f5f5; }
.diy-wrap { min-height: 100vh; }
.diy-hero { background: linear-gradient(135deg, #1a1a1a 0%, #3a3a3a 100%); padding: 60rpx 40rpx 50rpx; }
.diy-hero-title { font-size: 44rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }
.diy-hero-desc { font-size: 26rpx; color: rgba(255,255,255,.7); margin-top: 16rpx; line-height: 1.6; }
.diy-content-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 28rpx 32rpx; }
.diy-form-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 28rpx 32rpx; }
.diy-form-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 24rpx; }
.diy-field { margin-bottom: 24rpx; }
.diy-field-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.flex1 { flex: 1; }
.diy-label { font-size: 26rpx; color: #555; margin-bottom: 8rpx; }
.diy-input { background: #f8f8f8; border-radius: 10rpx; padding: 18rpx 24rpx; font-size: 28rpx; color: #1a1a1a; width: 100%; }
.diy-textarea { background: #f8f8f8; border-radius: 10rpx; padding: 18rpx 24rpx; font-size: 28rpx; color: #1a1a1a; width: 100%; min-height: 160rpx; }
.diy-divider { height: 1rpx; background: #f0f0f0; margin: 28rpx 0; }
.diy-submit-wrap { padding: 20rpx 40rpx 0; }
.diy-submit-btn { background: #1a1a1a; color: #fff; text-align: center; font-size: 32rpx; font-weight: 700; padding: 28rpx; border-radius: 60rpx; letter-spacing: 2rpx; }
.diy-submit-btn.disabled { background: #aaa; }
.diy-tip { text-align: center; font-size: 22rpx; color: #aaa; margin-top: 16rpx; }
