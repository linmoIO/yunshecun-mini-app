page { background: #f7f4ee; color: #302e29; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.diy-wrap { min-height: 100vh; padding-bottom: 180rpx; background: #f7f4ee; }
.diy-hero { height: 430rpx; overflow: hidden; position: relative; }
.diy-hero-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.diy-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(25,20,14,.08), rgba(25,20,14,.72)); }
.diy-hero-copy { position: absolute; left: 40rpx; right: 40rpx; bottom: 40rpx; color: #fff; z-index: 2; }
.diy-hero-title { font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 50rpx; font-weight: 600; line-height: 1.25; letter-spacing: 1rpx; }
.diy-hero-desc { font-size: 28rpx; color: rgba(255,255,255,.9); margin-top: 16rpx; line-height: 1.8; }
.diy-content-card, .diy-form-card { background: #fff; margin: 24rpx 32rpx; border-radius: 10rpx; padding: 30rpx 32rpx; box-shadow: 0 6rpx 24rpx rgba(55,46,32,.06); }
.diy-form-title { font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 34rpx; font-weight: 600; color: #4d473e; margin-bottom: 24rpx; }
.diy-field { margin-bottom: 24rpx; }
.diy-field-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.flex1 { flex: 1; }
.diy-label { font-size: 28rpx; color: #6b6358; margin-bottom: 8rpx; }
.diy-input, .diy-textarea { background: #f5f1ea; border: 1rpx solid #e5dfd5; border-radius: 6rpx; padding: 18rpx 24rpx; font-size: 30rpx; color: #302e29; width: 100%; box-sizing: border-box; }
.diy-textarea { min-height: 220rpx; line-height: 1.7; padding-top: 22rpx; padding-bottom: 22rpx; }
.diy-divider { height: 1rpx; background: #f0f0f0; margin: 28rpx 0; }
.diy-submit-wrap { padding: 20rpx 40rpx 0; }
.diy-submit-btn { background: #6f5639; color: #fff; text-align: center; font-size: 32rpx; font-weight: 600; padding: 28rpx; border-radius: 6rpx; letter-spacing: 1rpx; }
.diy-submit-btn.disabled { background: #aaa; }
.diy-tip { text-align: center; font-size: 26rpx; color: #776f63; margin-top: 16rpx; line-height: 1.6; }
