page { background: #f5f5f5; }
.so-wrap { padding: 20rpx; }
.so-card { background: #fff; border-radius: 16rpx; padding: 28rpx 32rpx; margin-bottom: 20rpx; }
.so-card-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f5f5f5; }
.so-field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f9f9f9; }
.so-label { font-size: 26rpx; color: #555; width: 160rpx; flex-shrink: 0; }
.so-input { flex: 1; font-size: 26rpx; color: #1a1a1a; }
.so-goods-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.so-goods-name { font-size: 26rpx; color: #333; flex: 1; }
.so-goods-qty { font-size: 26rpx; color: #999; flex-shrink: 0; }
.so-summary {}
.so-summary-row { display: flex; justify-content: space-between; padding: 14rpx 0; font-size: 26rpx; color: #666; border-bottom: 1rpx solid #f9f9f9; }
.so-summary-total { font-size: 28rpx; color: #1a1a1a; font-weight: 600; border-bottom: none; padding-top: 20rpx; }
.so-bottom { padding: 0 20rpx; }
.so-submit-btn { background: #1a1a1a; color: #fff; text-align: center; font-size: 32rpx; font-weight: 600; padding: 28rpx; border-radius: 60rpx; letter-spacing: 2rpx; }
.so-submit-btn.disabled { background: #aaa; }
.so-my-orders { color: #666; font-size: 26rpx; text-align: center; padding: 10rpx 0; margin-bottom: 12rpx; text-decoration: underline; }
.so-addr-btn { font-size: 24rpx; color: #2196f3; }
.so-selected-addr { background: #f0f7ff; border-radius: 10rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx; }
.so-addr-name { font-size: 26rpx; font-weight: 600; color: #333; }
.so-addr-detail { font-size: 22rpx; color: #666; margin-top: 4rpx; }
