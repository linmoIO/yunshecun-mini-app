<view class="chat-wrap">
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:if="{{messages.length === 0 && !loading}}" class="empty-tip">
      <text>您好，欢迎联系云舍村客服\n我们将尽快为您解答</text>
    </view>
    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.showTime}}" class="time-label">{{item.timeLabel}}</view>
      <view class="msg-item {{item.fromAdmin ? 'admin' : 'user'}}">
        <image wx:if="{{item.fromAdmin}}" class="avatar" src="/static/images/kf_avatar.png" mode="aspectFill"></image>
        <view class="bubble">{{item.content}}</view>
        <image wx:if="{{!item.fromAdmin}}" class="avatar" src="{{userAvatar}}" mode="aspectFill"></image>
      </view>
    </block>
    <view id="msgEnd"></view>
  </scroll-view>
  <view class="input-bar">
    <textarea class="input-box" value="{{inputVal}}" bindinput="onInput" placeholder="输入消息..." auto-height maxlength="500" confirm-type="send" bindconfirm="sendMsg" adjust-position></textarea>
    <view class="send-btn {{!inputVal.trim() ? 'disabled' : ''}}" bindtap="sendMsg">发送</view>
  </view>
</view>
