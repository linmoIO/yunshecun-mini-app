page { background: #f5f5f5; }
.pd-wrap {}
.pd-swiper { width: 100%; height: 560rpx; background: #eee; }
.pd-main { background: #fff; margin-top: 16rpx; padding: 28rpx 32rpx 24rpx; }
.pd-price-row { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.pd-price { font-size: 48rpx; color: #e05d44; font-weight: 700; }
.pd-price-ori { font-size: 26rpx; color: #bbb; text-decoration: line-through; }
.pd-stock { font-size: 22rpx; color: #999; margin-left: auto; }
.sold-out { color: #e05d44; }
.pd-name { font-size: 32rpx; color: #1a1a1a; font-weight: 700; margin-top: 16rpx; line-height: 1.4; }
.pd-desc { font-size: 26rpx; color: #888; margin-top: 12rpx; line-height: 1.6; }
.pd-qty-row { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #f5f5f5; }
.pd-label { font-size: 28rpx; color: #555; }
.pd-stepper { display: flex; align-items: center; gap: 0; border: 1rpx solid #e0e0e0; border-radius: 8rpx; overflow: hidden; }
.step-btn { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: #333; background: #f9f9f9; }
.step-num { width: 80rpx; text-align: center; font-size: 30rpx; color: #1a1a1a; font-weight: 600; background: #fff; height: 68rpx; line-height: 68rpx; }
.pd-section { background: #fff; margin-top: 16rpx; padding: 28rpx 32rpx; }
.pd-sec-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 16rpx; }
.pd-sec-content { font-size: 26rpx; color: #555; line-height: 1.7; }
.pd-bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1rpx solid #f0f0f0; padding: 20rpx 32rpx; display: flex; align-items: center; gap: 20rpx; z-index: 100; }
.pd-total { flex: 1; font-size: 26rpx; color: #555; }
.pd-buy-btn { background: #1a1a1a; color: #fff; font-size: 30rpx; padding: 22rpx 60rpx; border-radius: 50rpx; font-weight: 600; }
.pd-buy-btn.disabled { background: #ccc; }
.pd-loading { text-align: center; padding: 80rpx; color: #bbb; font-size: 28rpx; }
/* 评价区域 */
.pd-review { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.pd-review:last-child { border-bottom: none; }
.pd-review-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.pd-review-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.pd-review-avatar-ph { background: #1a1a2e; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.pd-review-info { flex: 1; }
.pd-review-name { font-size: 26rpx; color: #333; font-weight: 500; }
.pd-review-stars { display: flex; gap: 4rpx; margin-top: 4rpx; }
.pd-star { font-size: 24rpx; color: #ddd; }
.pd-star.on { color: #f4b400; }
.pd-review-content { font-size: 26rpx; color: #555; line-height: 1.6; margin-bottom: 12rpx; }
.pd-review-imgs { white-space: nowrap; }
.pd-review-img { width: 160rpx; height: 160rpx; border-radius: 10rpx; object-fit: cover; margin-right: 12rpx; display: inline-block; vertical-align: top; }
