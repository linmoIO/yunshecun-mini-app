page{background:#f5f5f5}.bp-wrap{padding:20rpx}.bp-tip{background:#e3f2fd;padding:16rpx 24rpx;border-radius:10rpx;font-size:24rpx;color:#1565c0;margin-bottom:20rpx}.bp-card{background:#fff;border-radius:16rpx;padding:24rpx 28rpx;margin-bottom:16rpx}.bp-row{display:flex;align-items:center;gap:16rpx}.bp-avatar{width:80rpx;height:80rpx;border-radius:50%;flex-shrink:0}.bp-info{flex:1}.bp-name{font-size:28rpx;font-weight:700;color:#1a1a1a}.bp-phone{font-size:24rpx;color:#888}.bp-del{font-size:24rpx;color:#e05d44;padding:8rpx 20rpx;border:1rpx solid #e05d44;border-radius:20rpx}.bp-empty{text-align:center;padding:60rpx;color:#bbb;font-size:28rpx}.bp-add-card{background:#fff;border-radius:16rpx;padding:28rpx;margin-bottom:16rpx}.bp-add-title{font-size:28rpx;font-weight:700;margin-bottom:20rpx}.bp-field{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #f5f5f5}.bp-lbl{width:140rpx;font-size:26rpx;color:#555;flex-shrink:0}.bp-inp{flex:1;font-size:28rpx;color:#1a1a1a}.bp-add-btn{background:#1a1a1a;color:#fff;text-align:center;padding:24rpx;border-radius:50rpx;font-size:28rpx;font-weight:600;margin-top:20rpx}.bp-add-btn.dis{background:#aaa}.bp-note{font-size:22rpx;color:#aaa;text-align:center;line-height:1.6}
