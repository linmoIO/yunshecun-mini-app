/* pagesA/member/setting.wxss */
page { background: #f5f5f5; }
.setting-wrap { height: 100vh; background: #f5f5f5; }
.setting-section { margin: 24rpx 20rpx 0; background: #fff; border-radius: 16rpx; overflow: hidden; }
.setting-group-title { padding: 20rpx 32rpx 10rpx; font-size: 26rpx; color: #776f63; }
.setting-item { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 32rpx; border-bottom: 1rpx solid #f0f0f0; }
.setting-item:last-child { border-bottom: none; }
.setting-item-left { display: flex; align-items: center; gap: 18rpx; }
.setting-icon { font-size: 36rpx; width: 44rpx; text-align: center; }
.setting-label { font-size: 30rpx; color: #302e29; }
.setting-arrow { font-size: 36rpx; color: #ccc; font-weight: 300; }
