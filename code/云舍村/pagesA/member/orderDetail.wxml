<scroll-view class="od-wrap" scroll-y>
  <view wx:if="{{loading}}" class="od-loading">加载中...</view>
  <block wx:elif="{{!order}}" >
    <view class="od-empty">订单信息不存在</view>
  </block>
  <block wx:else>
    <!-- 状态 -->
    <view class="od-status-card">
      <view class="od-status-text">{{order.orderStaDesc || order.status || '—'}}</view>
      <view class="od-order-no">订单号：{{order.orderNo}}</view>
    </view>

    <!-- 旅游/酒店订单信息 -->
    <view class="od-card" wx:if="{{type!=='shop'}}">
      <view class="od-card-title">产品信息</view>
      <view class="od-row"><text class="od-label">产品名称</text><text class="od-val">{{order.title || order.product.title || '—'}}</text></view>
      <view class="od-row" wx:if="{{order.channel}}"><text class="od-label">订单类型</text><text class="od-val">{{order.channel === 'room' ? '酒店' : '旅游套餐'}}</text></view>
      <view class="od-row"><text class="od-label">订单金额</text><text class="od-val" style="color:#e05d44">¥{{order.price || order.totalAmount || 0}}</text></view>
    </view>

    <!-- 联系信息 -->
    <view class="od-card" wx:if="{{order.contactName || order.guestName}}">
      <view class="od-card-title">联系信息</view>
      <view class="od-row"><text class="od-label">联系人</text><text class="od-val">{{order.contactName || order.guestName}}</text></view>
      <view class="od-row" wx:if="{{order.contactPhone || order.guestPhone}}"><text class="od-label">手机号</text><text class="od-val">{{order.contactPhone || order.guestPhone}}</text></view>
    </view>

    <!-- 时间信息 -->
    <view class="od-card">
      <view class="od-card-title">时间信息</view>
      <view class="od-row" wx:if="{{order.startDate || order.checkIn}}">
        <text class="od-label">{{type==='hotel'?'入住日期':'出发日期'}}</text>
        <text class="od-val">{{order.startDate || order.checkIn}}</text>
      </view>
      <view class="od-row" wx:if="{{order.endDate || order.checkOut}}">
        <text class="od-label">{{type==='hotel'?'退房日期':'结束日期'}}</text>
        <text class="od-val">{{order.endDate || order.checkOut}}</text>
      </view>
      <view class="od-row"><text class="od-label">下单时间</text><text class="od-val">{{order.createdAt}}</text></view>
    </view>

    <!-- 风物订单信息 -->
    <view class="od-card" wx:if="{{type==='shop'&&order.items&&order.items.length}}">
      <view class="od-card-title">商品信息</view>
      <view class="od-shop-item" wx:for="{{order.items}}" wx:key="id">
        <image wx:if="{{item.product&&item.product.coverImage}}" src="{{item.product.coverImage}}" mode="aspectFill" class="od-item-img"/>
        <view class="od-item-info">
          <view class="od-item-name">{{item.productName}}</view>
          <view class="od-item-price">¥{{item.price}} × {{item.quantity}}</view>
        </view>
      </view>
      <view class="od-row"><text class="od-label">合计</text><text class="od-val" style="color:#e05d44">¥{{order.totalAmount}}</text></view>
      <view class="od-row" wx:if="{{order.trackingNo}}"><text class="od-label">运单号</text><text class="od-val" style="color:#2196f3">{{order.trackingNo}}</text></view>
    </view>

    <!-- 备注 -->
    <view class="od-card" wx:if="{{order.notes}}">
      <view class="od-card-title">备注</view>
      <view class="od-notes">{{order.notes}}</view>
    </view>

    <!-- 操作按钮 -->
    <view class="od-actions">
      <view class="od-btn od-btn-ghost" bindtap="goChat">联系客服</view>
      <view class="od-btn od-btn-back" bindtap="goBack">返回</view>
    </view>
  </block>
  <view style="height:80rpx"></view>
</scroll-view>
