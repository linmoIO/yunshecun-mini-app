/* pagesA/member/memberInfo.wxss */
page{background:#f5f5f5}
.mi-wrap{height:100vh}
.mi-section{background:#fff;border-radius:16rpx;margin:20rpx;overflow:hidden}
.mi-item{display:flex;align-items:center;justify-content:space-between;padding:28rpx 32rpx;border-bottom:1rpx solid #f5f5f5;min-height:100rpx}
.mi-item:last-child{border-bottom:none}
.mi-label{font-size:28rpx;color:#333;flex-shrink:0;width:140rpx}
.mi-val-right{display:flex;align-items:center;gap:12rpx;flex:1;justify-content:flex-end}
.mi-val{font-size:28rpx;color:#888}
.mi-arrow{font-size:32rpx;color:#ccc}
.mi-link{font-size:26rpx;color:#1a1a2e;font-weight:500}
.mi-avatar{width:96rpx;height:96rpx;border-radius:50%;object-fit:cover}
.mi-avatar-ph{background:#1a1a2e;color:#fff;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:600}
.mi-gender{display:flex;gap:12rpx}
.mi-gender-btn{padding:8rpx 20rpx;border:1.5rpx solid #e0e0e0;border-radius:20rpx;font-size:26rpx;color:#666}
.mi-gender-btn.active{border-color:#1a1a2e;background:#1a1a2e;color:#fff}
/* 绑定手机弹层 */
.mi-modal-mask{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100}
.mi-modal{position:fixed;left:32rpx;right:32rpx;bottom:0;background:#fff;border-radius:24rpx 24rpx 0 0;padding:40rpx 32rpx;z-index:101}
.mi-modal-title{font-size:32rpx;font-weight:700;color:#333;text-align:center;margin-bottom:32rpx}
.mi-field{margin-bottom:20rpx}
.mi-field-label{font-size:26rpx;color:#888;margin-bottom:8rpx;display:block}
.mi-field-input{width:100%;height:80rpx;border:1.5rpx solid #e0e0e0;border-radius:10rpx;padding:0 20rpx;font-size:28rpx;box-sizing:border-box}
.mi-field-code{position:relative}
.mi-field-code .mi-field-input{padding-right:200rpx}
.mi-send-btn{position:absolute;right:0;bottom:0;height:80rpx;background:#1a1a2e;color:#fff;border-radius:0 10rpx 10rpx 0;padding:0 24rpx;font-size:24rpx;display:flex;align-items:center}
.mi-send-btn.dis{background:#ccc}
.mi-modal-btns{display:flex;gap:20rpx;margin-top:32rpx}
.mi-modal-cancel{flex:1;text-align:center;padding:24rpx;border:1.5rpx solid #e0e0e0;border-radius:50rpx;font-size:28rpx;color:#666}
.mi-modal-confirm{flex:1;text-align:center;padding:24rpx;background:#1a1a2e;border-radius:50rpx;font-size:28rpx;color:#fff;font-weight:600}
