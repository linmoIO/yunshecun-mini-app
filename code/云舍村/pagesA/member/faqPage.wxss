page{background:#f5f5f5}.faq-wrap{min-height:100vh}.faq-loading,.faq-empty{text-align:center;padding:80rpx;color:#bbb;font-size:28rpx}.faq-item{background:#fff;margin:16rpx;border-radius:16rpx;overflow:hidden}.faq-q{display:flex;align-items:flex-start;padding:24rpx 28rpx;gap:16rpx;cursor:pointer}.faq-icon{width:36rpx;height:36rpx;background:#1a1a1a;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:700;flex-shrink:0;line-height:36rpx;text-align:center}.faq-qtext{flex:1;font-size:28rpx;font-weight:600;color:#1a1a1a;line-height:1.5}.faq-arrow{font-size:24rpx;color:#aaa;flex-shrink:0;margin-top:4rpx}.faq-a{display:flex;gap:16rpx;padding:0 28rpx 24rpx;background:#f9f9f9}.faq-aicon{width:36rpx;height:36rpx;background:#e8f5e9;color:#27ae60;border-radius:50%;font-size:20rpx;font-weight:700;flex-shrink:0;line-height:36rpx;text-align:center}.faq-atext{flex:1;font-size:26rpx;color:#555;line-height:1.7}.faq-contact{text-align:center;padding:30rpx;font-size:26rpx;color:#888;margin:16rpx}.faq-contact-btn{color:#2196f3;font-weight:600}
