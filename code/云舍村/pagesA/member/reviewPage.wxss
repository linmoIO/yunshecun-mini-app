page{background:#f5f5f5}
.rv-wrap{height:100vh}
.rv-product-card{background:#fff;padding:24rpx 32rpx;margin-bottom:16rpx}
.rv-product-name{font-size:30rpx;font-weight:600;color:#333}
.rv-order-no{font-size:22rpx;color:#aaa;margin-top:6rpx}
.rv-section{background:#fff;padding:28rpx 32rpx;margin-bottom:16rpx}
.rv-section-title{font-size:28rpx;font-weight:600;color:#333;margin-bottom:20rpx}
.rv-stars{display:flex;align-items:center;gap:16rpx}
.rv-star{font-size:56rpx;color:#ddd;transition:.2s}
.rv-star.active{color:#f4b400}
.rv-rating-label{font-size:26rpx;color:#888;margin-left:8rpx}
.rv-textarea{width:100%;min-height:180rpx;font-size:28rpx;color:#333;line-height:1.7;border:1.5rpx solid #e0e0e0;border-radius:10rpx;padding:16rpx;box-sizing:border-box}
.rv-word-count{text-align:right;font-size:22rpx;color:#bbb;margin-top:8rpx}
.rv-imgs{display:flex;flex-wrap:wrap;gap:16rpx}
.rv-img-item{position:relative;width:180rpx;height:180rpx}
.rv-img{width:180rpx;height:180rpx;border-radius:12rpx;object-fit:cover}
.rv-img-del{position:absolute;top:-10rpx;right:-10rpx;background:#333;color:#fff;width:36rpx;height:36rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22rpx}
.rv-add-img{width:180rpx;height:180rpx;border:2rpx dashed #ddd;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx}
.rv-add-icon{font-size:56rpx;color:#ccc}
.rv-add-text{font-size:22rpx;color:#bbb}
.rv-submit{margin:20rpx;background:#1a1a2e;color:#fff;border-radius:50rpx;text-align:center;padding:28rpx;font-size:30rpx;font-weight:500}
.rv-submit.dis{opacity:.5}
