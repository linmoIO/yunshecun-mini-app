page{background:#f5f5f5}
.od-wrap{height:100vh;background:#f5f5f5}
.od-loading,.od-empty{text-align:center;padding:80rpx;color:#aaa;font-size:28rpx}
.od-status-card{background:#1a1a2e;padding:48rpx 32rpx;margin:0 0 20rpx}
.od-status-text{font-size:40rpx;font-weight:700;color:#fff;margin-bottom:12rpx}
.od-order-no{font-size:24rpx;color:rgba(255,255,255,.6)}
.od-card{background:#fff;border-radius:16rpx;margin:0 20rpx 20rpx;padding:28rpx 32rpx}
.od-card-title{font-size:28rpx;font-weight:600;color:#333;margin-bottom:20rpx;padding-bottom:16rpx;border-bottom:1rpx solid #f0f0f0}
.od-row{display:flex;justify-content:space-between;align-items:center;padding:10rpx 0;font-size:28rpx}
.od-label{color:#888}
.od-val{color:#333;max-width:60%;text-align:right;word-break:break-all}
.od-notes{font-size:26rpx;color:#666;line-height:1.6}
.od-shop-item{display:flex;gap:20rpx;padding:12rpx 0;border-bottom:1rpx solid #f5f5f5}
.od-item-img{width:100rpx;height:100rpx;border-radius:10rpx;object-fit:cover;flex-shrink:0}
.od-item-info{flex:1}
.od-item-name{font-size:28rpx;color:#333;margin-bottom:8rpx}
.od-item-price{font-size:26rpx;color:#888}
.od-actions{display:flex;gap:20rpx;padding:20rpx 20rpx 0}
.od-btn{flex:1;text-align:center;padding:24rpx;border-radius:50rpx;font-size:28rpx;font-weight:500}
.od-btn-ghost{border:1.5rpx solid #1a1a2e;color:#1a1a2e}
.od-btn-back{background:#1a1a2e;color:#fff}
