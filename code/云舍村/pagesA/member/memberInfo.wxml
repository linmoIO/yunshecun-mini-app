<scroll-view class="mi-wrap" scroll-y>
  <!-- 头像 -->
  <view class="mi-section">
    <view class="mi-item" bindtap="changeAvatar">
      <text class="mi-label">头像</text>
      <view class="mi-val-right">
        <image wx:if="{{info.avatar||info.headPortraitUrl}}" src="{{info.avatar||info.headPortraitUrl}}" mode="aspectFill" class="mi-avatar"/>
        <view wx:else class="mi-avatar mi-avatar-ph">{{info.nickname&&info.nickname.length?info.nickname[0]:'云'}}</view>
        <text class="mi-arrow">›</text>
      </view>
    </view>

    <view class="mi-item" bindtap="editNickname">
      <text class="mi-label">昵称</text>
      <view class="mi-val-right">
        <text class="mi-val">{{info.nickname||'未设置'}}</text>
        <text class="mi-arrow">›</text>
      </view>
    </view>

    <view class="mi-item">
      <text class="mi-label">性别</text>
      <view class="mi-val-right mi-gender">
        <view class="mi-gender-btn {{info.gender===1?'active':''}}" bindtap="selectGender" data-val="1">男</view>
        <view class="mi-gender-btn {{info.gender===2?'active':''}}" bindtap="selectGender" data-val="2">女</view>
        <view class="mi-gender-btn {{!info.gender?'active':''}}" bindtap="selectGender" data-val="0">保密</view>
      </view>
    </view>

    <view class="mi-item">
      <text class="mi-label">生日</text>
      <picker mode="date" value="{{info.birthday}}" start="1930-01-01" bindchange="onBirthdayChange">
        <view class="mi-val-right">
          <text class="mi-val">{{info.birthday||'未设置'}}</text>
          <text class="mi-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 账号信息 -->
  <view class="mi-section">
    <view class="mi-item">
      <text class="mi-label">手机号</text>
      <view class="mi-val-right">
        <text class="mi-val">{{info.phone||info.mobile||'未绑定'}}</text>
        <text class="mi-link" bindtap="showPhoneBind">{{(info.phone||info.mobile)?'更换':'绑定'}}›</text>
      </view>
    </view>
    <view class="mi-item">
      <text class="mi-label">会员等级</text>
      <text class="mi-val">{{info.cardLevel||'普通会员'}}</text>
    </view>
    <view class="mi-item">
      <text class="mi-label">积分</text>
      <text class="mi-val">{{info.points||0}}</text>
    </view>
    <view class="mi-item">
      <text class="mi-label">会员编号</text>
      <text class="mi-val mi-id">{{info.memberId||'未登录'}}</text>
    </view>
  </view>

  <!-- 绑定手机号弹出层 -->
  <view class="mi-modal-mask" wx:if="{{bindingPhone}}" bindtap="cancelBind"></view>
  <view class="mi-modal" wx:if="{{bindingPhone}}">
    <view class="mi-modal-title">绑定/更换手机号</view>
    <view class="mi-field">
      <text class="mi-field-label">手机号</text>
      <input class="mi-field-input" type="number" placeholder="请输入手机号" value="{{phoneForm.phone}}" bindinput="onPhoneInput" maxlength="11"/>
    </view>
    <view class="mi-field mi-field-code">
      <text class="mi-field-label">验证码</text>
      <input class="mi-field-input" type="number" placeholder="请输入验证码" value="{{phoneForm.code}}" bindinput="onCodeInput" maxlength="6"/>
      <view class="mi-send-btn {{(sendingCode||countdown>0)?'dis':''}}" bindtap="sendCode">
        {{countdown>0?countdown+'s重发':'获取验证码'}}
      </view>
    </view>
    <view class="mi-modal-btns">
      <view class="mi-modal-cancel" bindtap="cancelBind">取消</view>
      <view class="mi-modal-confirm" bindtap="bindPhone">确认绑定</view>
    </view>
  </view>

  <view style="height:60rpx"></view>
</scroll-view>
