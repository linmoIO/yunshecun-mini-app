page{background:#f5f5f5}
.as-wrap{height:100vh}
.as-card{background:#fff;border-radius:16rpx;margin:20rpx;padding:32rpx}
.as-title{font-size:28rpx;font-weight:600;color:#333;margin-bottom:20rpx}
.as-order-no{font-size:26rpx;color:#666;font-family:monospace}
.as-reason{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid #f5f5f5;font-size:28rpx;color:#333}
.as-reason:last-child{border-bottom:none}
.as-reason.active{color:#1a1a2e;font-weight:600}
.as-check{font-size:32rpx;color:#ccc;width:32rpx}
.as-reason.active .as-check{color:#1a1a2e}
.as-textarea{width:100%;min-height:160rpx;font-size:28rpx;color:#333;line-height:1.6;border:1.5rpx solid #e0e0e0;border-radius:10rpx;padding:16rpx;box-sizing:border-box}
.as-submit{margin:20rpx;background:#1a1a2e;color:#fff;border-radius:50rpx;text-align:center;padding:28rpx;font-size:30rpx;font-weight:500}
.as-submit.dis{opacity:.5}
