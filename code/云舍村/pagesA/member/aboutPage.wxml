<scroll-view class="about-wrap" scroll-y>
  <view class="about-hero">
    <image wx:if="{{logoUrl}}" src="{{logoUrl}}" mode="aspectFit" class="about-logo"/>
    <view class="about-brand">云舍村</view>
    <view class="about-version">Ver {{version}}</view>
  </view>
  <view class="about-content" wx:if="{{content}}">
    <rich-text nodes="{{content}}"></rich-text>
  </view>
  <view class="about-content" wx:else>
    <view class="about-section">
      <view class="about-sec-title">品牌理念</view>
      <view class="about-sec-text">云舍村以《桃花源记》与《陋室铭》为意境，致力于保护和传承东方村落文明，让民间工艺与智慧在当代生活中焕发新生。</view>
    </view>
    <view class="about-section">
      <view class="about-sec-title">村落生活</view>
      <view class="about-sec-text">六十余栋湖湘民居院落掩映于茂林修竹之间。到访者可体验院落住宿、茶饮、地方风味、农事与民间手艺。</view>
    </view>
    <view class="about-section">
      <view class="about-sec-title">联系我们</view>
      <view class="about-sec-text">地址：湖南省常德市桃花源风景区\n咨询电话：0736-7070666</view>
    </view>
  </view>
  <view class="about-links">
    <view class="about-link" bindtap="goPage" data-url="/pagesA/member/policy">预约须知</view>
    <view class="about-sep">|</view>
    <view class="about-link" bindtap="goPage" data-url="/pagesA/member/privacy">隐私政策</view>
    <view class="about-sep">|</view>
    <view class="about-link" bindtap="goPage" data-url="/pagesA/member/faqPage">常见问题</view>
    <view class="about-sep">|</view>
    <view class="about-link" bindtap="goChat">联系客服</view>
  </view>
  <view style="height:60rpx"></view>
</scroll-view>
