<scroll-view class="inv-wrap" scroll-y>
  <view class="inv-tabs">
    <view class="inv-tab {{tab===0?'active':''}}" bindtap="setTab" data-t="0">申请开票</view>
    <view class="inv-tab {{tab===1?'active':''}}" bindtap="setTab" data-t="1">开票记录</view>
  </view>

  <block wx:if="{{tab===0}}">
    <view class="inv-section">
      <view class="inv-section-title">选择需要开票的订单（可多选）</view>
      <view wx:if="{{ordersLoading}}" class="inv-loading">加载中...</view>
      <view wx:elif="{{!orders.length}}" class="inv-empty">暂无可开票订单</view>
      <view wx:else>
        <view class="inv-order {{item.selected?'selected':''}}" wx:for="{{orders}}" wx:key="orderNo" bindtap="toggleOrder" data-idx="{{index}}">
          <view class="inv-check">{{item.selected ? '✓' : '○'}}</view>
          <view class="inv-order-info">
            <view class="inv-order-name">{{item.typeName}} · {{item.name}}</view>
            <view class="inv-order-meta">¥{{item.amountText}} · {{item.shortNo}}</view>
          </view>
        </view>
        <view class="inv-total" wx:if="{{selectedAmount > 0}}">已选 ¥{{selectedAmount}}</view>
      </view>
    </view>

    <view class="inv-section">
      <view class="inv-section-title">发票信息</view>
      <view class="inv-field">
        <text class="inv-label">发票类型</text>
        <view class="inv-type-btns">
          <view class="inv-type-btn {{invType==='personal'?'active':''}}" bindtap="setInvType" data-t="personal">个人/普通</view>
          <view class="inv-type-btn {{invType==='company'?'active':''}}" bindtap="setInvType" data-t="company">企业/增值税</view>
        </view>
      </view>
      <view class="inv-field">
        <text class="inv-label">发票抬头 *</text>
        <input class="inv-input" value="{{invTitle}}" placeholder="个人填姓名，企业填公司名" bindinput="onInputTitle"/>
      </view>
      <view class="inv-field" wx:if="{{invType==='company'}}">
        <text class="inv-label">税号 *</text>
        <input class="inv-input" value="{{invTaxNo}}" placeholder="企业税号" bindinput="onInputTaxNo"/>
      </view>
      <view class="inv-field">
        <text class="inv-label">接收邮箱</text>
        <input class="inv-input" value="{{invEmail}}" placeholder="发票发送邮箱" bindinput="onInputEmail"/>
      </view>
      <view class="inv-field">
        <text class="inv-label">手机号</text>
        <input class="inv-input" type="number" value="{{invPhone}}" placeholder="联系手机号" bindinput="onInputPhone" maxlength="11"/>
      </view>
    </view>

    <view class="inv-submit-btn {{submitting?'disabled':''}}" bindtap="submitInvoice">{{submitting?'提交中...':'提交开票申请'}}</view>
  </block>

  <block wx:if="{{tab===1}}">
    <view wx:if="{{recordsLoading}}" class="inv-loading">加载中...</view>
    <view wx:elif="{{!records.length}}" class="inv-empty">暂无开票记录</view>
    <view class="inv-record" wx:for="{{records}}" wx:key="id">
      <view class="inv-record-header">
        <text class="inv-record-title">{{item.title}}</text>
        <view class="inv-record-status {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="inv-record-meta">¥{{item.amountText}} · {{item.invoiceType==='company'?'企业发票':'普通发票'}}</view>
      <view class="inv-record-meta" wx:if="{{item.email}}">邮箱：{{item.email}}</view>
      <view class="inv-imgs" wx:if="{{item.imgs&&item.imgs.length}}">
        <image wx:for="{{item.imgs}}" wx:key="index" wx:for-item="img" src="{{img}}" mode="aspectFill" class="inv-img" bindtap="previewImg" data-url="{{img}}" data-urls="{{item.imgs}}"></image>
      </view>
      <view class="inv-note" wx:if="{{item.adminNote}}">{{item.adminNote}}</view>
      <view class="inv-reject" wx:if="{{item.rejectReason}}">拒绝原因：{{item.rejectReason}}</view>
      <view class="inv-record-date">申请时间：{{item.createdAtFmt}}</view>
    </view>
  </block>

  <view style="height:60rpx"></view>
</scroll-view>
