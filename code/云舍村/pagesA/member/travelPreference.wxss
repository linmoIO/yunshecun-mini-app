/* pagesA/member/travelPreference.wxss */
page { background: #f5f5f5; }
.tp-wrap { height: 100vh; }
.tp-loading { text-align: center; padding: 80rpx; color: #aaa; }
.tp-section { margin: 24rpx 20rpx; background: #fff; border-radius: 16rpx; padding: 32rpx; }
.tp-section-title { font-size: 28rpx; color: #666; margin-bottom: 20rpx; }
.tp-empty { color: #bbb; font-size: 28rpx; text-align: center; padding: 20rpx 0; }
.tp-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.tp-tag-label { font-size: 26rpx; color: #999; }
.tp-tag { background: #f0f0f0; border-radius: 20rpx; padding: 8rpx 20rpx; font-size: 26rpx; color: #555; }
.tp-label { font-size: 28rpx; color: #333; margin-bottom: 16rpx; }
.tp-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tp-option { border: 1rpx solid #ddd; border-radius: 30rpx; padding: 12rpx 28rpx; font-size: 28rpx; color: #555; }
.tp-option.active { border-color: #8B6F4E; background: #8B6F4E; color: #fff; }
.tp-save { margin: 40rpx 20rpx; background: #8B6F4E; color: #fff; border-radius: 50rpx; text-align: center; padding: 28rpx; font-size: 30rpx; }
.tp-save.dis { opacity: 0.6; }
