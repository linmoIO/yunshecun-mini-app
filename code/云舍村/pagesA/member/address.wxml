<view class="addr-wrap">
  <!-- 地址列表 -->
  <view wx:if="{{addresses.length}}">
    <view class="addr-card {{item.isDefault?'default':''}}" wx:for="{{addresses}}" wx:key="id">
      <!-- 选择模式：整张卡片点击即选择 -->
      <view class="addr-info" bindtap="{{selectMode?'selectAddr':'editAddr'}}" data-idx="{{index}}">
        <view class="addr-top">
          <text class="addr-name">{{item.name}}</text>
          <text class="addr-phone">{{item.phone}}</text>
          <view class="addr-default-tag" wx:if="{{item.isDefault}}">默认</view>
          <view class="addr-select-tag" wx:if="{{selectMode}}" style="background:#1a1a2e;color:#fff;border-radius:6rpx;padding:2rpx 12rpx;font-size:22rpx;margin-left:8rpx">使用</view>
        </view>
        <view class="addr-detail">{{item.province}}{{item.city}}{{item.district}} {{item.address}}</view>
      </view>
      <!-- 非选择模式才显示操作按钮 -->
      <view class="addr-actions" wx:if="{{!selectMode}}">
        <view wx:if="{{!item.isDefault}}" class="addr-set-default" bindtap="setDefault" data-id="{{item.id}}" data-idx="{{index}}">设为默认</view>
        <view class="addr-edit" bindtap="editAddr" data-idx="{{index}}">编辑</view>
        <view class="addr-del" bindtap="delAddr" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="addr-empty">暂无收货地址</view>

  <!-- 新增/编辑表单 -->
  <view class="addr-form-card" id="addrForm">
    <view class="addr-form-title">{{editId ? '编辑地址' : '新增地址'}}</view>
    <view class="addr-field">
      <text class="addr-label">收件人 *</text>
      <input class="addr-input" value="{{form.name}}" placeholder="收件人姓名" bindinput="onInput" data-key="name"/>
    </view>
    <view class="addr-field">
      <text class="addr-label">手机号 *</text>
      <input class="addr-input" type="number" value="{{form.phone}}" placeholder="收件人手机号" bindinput="onInput" data-key="phone" maxlength="11"/>
    </view>
    <view class="addr-field">
      <text class="addr-label">省份</text>
      <input class="addr-input" value="{{form.province}}" placeholder="如：四川省" bindinput="onInput" data-key="province"/>
    </view>
    <view class="addr-field">
      <text class="addr-label">城市</text>
      <input class="addr-input" value="{{form.city}}" placeholder="如：成都市" bindinput="onInput" data-key="city"/>
    </view>
    <view class="addr-field">
      <text class="addr-label">区/县</text>
      <input class="addr-input" value="{{form.district}}" placeholder="如：武侯区" bindinput="onInput" data-key="district"/>
    </view>
    <view class="addr-field">
      <text class="addr-label">详细地址 *</text>
      <input class="addr-input" value="{{form.address}}" placeholder="街道门牌号等" bindinput="onInput" data-key="address"/>
    </view>
    <view class="addr-field addr-default-row">
      <text class="addr-label">设为默认</text>
      <switch checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#1a1a1a" style="transform:scale(.8)"/>
    </view>
    <view class="addr-btns">
      <view class="addr-cancel-btn" bindtap="cancelEdit">取消</view>
      <view class="addr-save-btn {{saving?'disabled':''}}" bindtap="saveAddr">{{saving?'保存中...':'保存地址'}}</view>
    </view>
  </view>

  <!-- 底部新增按钮 -->
  <view class="addr-add-btn" bindtap="newAddr">＋ 新增收货地址</view>
  <view style="height:40rpx"></view>
</view>
