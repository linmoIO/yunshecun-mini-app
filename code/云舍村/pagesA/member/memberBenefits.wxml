  <view wx:if="{{loading}}" style="text-align:center;padding:40px;color:#aaa">加载中...</view>
  <view wx:elif="{{content}}" style="padding:16px"><rich-text nodes="{{content}}"></rich-text></view>
  <view wx:else style="text-align:center;padding:60px;color:#aaa"><text>暂无内容</text></view>
</view>
