/* pagesA/member/aboutPage.wxss */
page { background: #f7f4ee; color: #302e29; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.about-wrap { height: 100vh; padding-bottom: 80rpx; box-sizing: border-box; }
.about-hero { display: flex; flex-direction: column; align-items: center; padding: 72rpx 0 40rpx; }
.about-logo { width: 160rpx; height: 160rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.about-brand { font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 50rpx; font-weight: 600; color: #4d473e; letter-spacing: 3rpx; }
.about-version { font-size: 25rpx; color: #8b8378; margin-top: 12rpx; }
.about-content { margin: 0 32rpx; padding: 32rpx; background: #fff; border: 1rpx solid #e5dfd5; border-radius: 10rpx; box-shadow: 0 6rpx 24rpx rgba(55,46,32,.06); }
.about-section { margin-bottom: 36rpx; }
.about-sec-title { font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 34rpx; font-weight: 600; color: #6f5639; margin-bottom: 16rpx; }
.about-sec-text { font-size: 30rpx; color: #4d473e; line-height: 1.9; white-space: pre-line; }
.about-phone { margin-top: 18rpx; font-size: 28rpx; color: #6f5639; }
.about-links { display: flex; justify-content: center; align-items: center; padding: 40rpx 0; gap: 20rpx; }
.about-link { font-size: 28rpx; color: #6f5639; }
.about-sep { color: #b8ad9e; }
