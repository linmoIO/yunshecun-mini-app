/* pagesA/member/aboutPage.wxss */
page { background: #1a1a1a; color: #eee; }
.about-wrap { height: 100vh; }
.about-hero { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0 40rpx; }
.about-logo { width: 160rpx; height: 160rpx; border-radius: 24rpx; margin-bottom: 24rpx; }
.about-brand { font-size: 48rpx; font-weight: bold; color: #fff; letter-spacing: 6rpx; }
.about-version { font-size: 24rpx; color: #888; margin-top: 12rpx; }
.about-content { margin: 0 30rpx; padding: 32rpx; background: #2a2a2a; border-radius: 16rpx; }
.about-section { margin-bottom: 36rpx; }
.about-sec-title { font-size: 30rpx; font-weight: bold; color: #D9CDB3; margin-bottom: 16rpx; }
.about-sec-text { font-size: 26rpx; color: #bbb; line-height: 1.7; white-space: pre-line; }
.about-links { display: flex; justify-content: center; align-items: center; padding: 40rpx 0; gap: 20rpx; }
.about-link { font-size: 26rpx; color: #D9CDB3; }
.about-sep { color: #555; }
