page{background:#f5f5f5}
.sp-wrap{padding:20rpx}
.sp-balance-card{background:linear-gradient(135deg,#1a1a1a,#3a3a3a);border-radius:20rpx;padding:40rpx;margin-bottom:24rpx;text-align:center}
.sp-balance-label{color:rgba(255,255,255,.7);font-size:24rpx;margin-bottom:12rpx}
.sp-balance-val{color:#fff;font-size:60rpx;font-weight:700}
.sp-form-card{background:#fff;border-radius:16rpx;padding:28rpx;margin-bottom:24rpx}
.sp-tip{font-size:24rpx;color:#888;margin-bottom:20rpx;line-height:1.6;background:#f8f8f8;padding:14rpx 18rpx;border-radius:8rpx}
.sp-field{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #f5f5f5}
.sp-lbl{width:160rpx;font-size:26rpx;color:#555;flex-shrink:0}
.sp-inp{flex:1;font-size:28rpx;color:#1a1a1a}
.sp-submit{background:#1a1a1a;color:#fff;text-align:center;padding:28rpx;border-radius:60rpx;font-size:30rpx;font-weight:700;margin-bottom:16rpx}
.sp-submit.dis{background:#aaa}
.sp-note{font-size:22rpx;color:#aaa;text-align:center;line-height:1.6}