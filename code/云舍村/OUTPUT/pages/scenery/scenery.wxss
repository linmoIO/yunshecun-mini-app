page { background: #f5f5f5; height: 100%; }

.scenery-page { display: flex; flex-direction: column; height: 100vh; }
.scenery-wrap { flex: 1; overflow: hidden; background: #f5f5f5; }

/* 顶部轮播 */
.top-swiper { width: 100%; height: 420rpx; display: block; }
.top-gap { height: 24rpx; background: #f5f5f5; }

/* 分类 tabs */
.cat-tabs { display: flex; overflow-x: auto; white-space: nowrap; background: #fff; padding: 0 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.cat-tabs::-webkit-scrollbar { display: none; }
.cat-tab { display: inline-block; padding: 20rpx 28rpx; font-size: 26rpx; color: #888; flex-shrink: 0; position: relative; }
.cat-tab.active { color: #1a1a1a; font-weight: 700; }
.cat-tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 32rpx; height: 4rpx; background: #1a1a1a; border-radius: 2rpx; }

/* 商品网格 */
.goods-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; padding: 20rpx; }
.goods-card { background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06); }
.goods-card-img { width: 100%; height: 280rpx; display: block; }
.goods-card-info { padding: 16rpx 20rpx 20rpx; }
.goods-name { font-size: 26rpx; color: #1a1a1a; font-weight: 600; line-height: 1.4; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.goods-desc { font-size: 22rpx; color: #999; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.goods-price { font-size: 30rpx; color: #e05d44; font-weight: 700; }
.goods-price-ori { font-size: 22rpx; color: #bbb; text-decoration: line-through; margin-left: 6rpx; }
.goods-btn { background: #1a1a1a; color: #fff; font-size: 22rpx; padding: 10rpx 22rpx; border-radius: 30rpx; }
.goods-stock { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }
.goods-stock.sold-out { color: #e05d44; }

/* 空状态 */
.empty-box { text-align: center; padding: 80rpx 40rpx; color: #bbb; }
.empty-box text { display: block; font-size: 26rpx; }

/* 加载更多 */
.load-more { text-align: center; padding: 30rpx; color: #bbb; font-size: 24rpx; }
