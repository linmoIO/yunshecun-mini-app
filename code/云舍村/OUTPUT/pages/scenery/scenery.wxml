<view class="scenery-page">
  <scroll-view class="scenery-wrap" scroll-y bindscrolltolower="loadMore" style="height:{{scrollH}}px">
    <!-- 顶部轮播（最多3张，后台Banner管理配置）-->
    <swiper class="top-swiper" autoplay circular indicator-dots wx:if="{{banners.length}}">
      <swiper-item wx:for="{{banners}}" wx:key="index">
        <image src="{{item.imageUrl||item.imgUrl}}" mode="aspectFill" style="width:100%;height:420rpx" bindtap="onBannerTap" data-url="{{item.linkUrl}}"></image>
      </swiper-item>
    </swiper>
    <view class="top-gap" wx:else></view>

    <!-- 分类 tabs -->
    <view class="cat-tabs" wx:if="{{categories.length}}">
      <view class="cat-tab {{activeCategory==='' ? 'active' : ''}}" bindtap="onCatTap" data-id="">全部</view>
      <view class="cat-tab {{activeCategory===item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="onCatTap" data-id="{{item.id}}">{{item.name}}</view>
    </view>

    <!-- 商品网格 -->
    <view class="goods-grid" wx:if="{{products.length}}">
      <view class="goods-card" wx:for="{{products}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image class="goods-card-img" src="{{item.coverImage||item.goodsMainPhoto}}" mode="aspectFill" lazy-load></image>
        <view class="goods-card-info">
          <view class="goods-name">{{item.name||item.goodsName}}</view>
          <view class="goods-desc" wx:if="{{item.description||item.goodsDesc}}">{{item.description||item.goodsDesc}}</view>
          <view class="goods-footer">
            <view>
              <text class="goods-price">¥{{item.price||item.minPrice}}</text>
              <text class="goods-price-ori" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
            </view>
            <view class="goods-btn">购买</view>
          </view>
          <view class="goods-stock" wx:if="{{item.stock>0}}">库存 {{item.stock}} 件</view>
          <view class="goods-stock sold-out" wx:elif="{{item.stock===0}}">已售罄</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-box" wx:if="{{!loading && !products.length}}">
      <text>暂无商品</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">加载中...</view>
    <view class="load-more" wx:elif="{{!hasMore && products.length}}">— 已加载全部商品 —</view>
    <view style="height:20rpx"></view>
  </scroll-view>

  <!-- 底部导航栏 -->
  <bottom-nav></bottom-nav>
</view>
