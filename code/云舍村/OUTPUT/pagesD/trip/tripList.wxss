/* === 新版tripList样式 === */
page { background: #f5f5f5; }
.tl-page { padding-bottom: 40rpx; }
.tl-tabs { display: flex; background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.tl-tab { flex: 1; text-align: center; padding: 28rpx 0; font-size: 28rpx; color: #888; }
.tl-tab.active { color: #1a1a1a; font-weight: 700; border-bottom: 4rpx solid #1a1a1a; }
.tl-add-btn { margin: 20rpx; background: #1a1a1a; color: #fff; text-align: center; padding: 24rpx; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
.tl-empty { text-align: center; padding: 80rpx 40rpx; color: #bbb; font-size: 28rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.tl-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }
.tl-resp-card { border-left: 6rpx solid #27ae60; }
.tl-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.tl-card-title { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.tl-status { font-size: 24rpx; padding: 4rpx 16rpx; background: #f5f5f5; border-radius: 20rpx; }
.tl-card-row { font-size: 26rpx; color: #555; margin-bottom: 10rpx; }
.tl-desc { color: #888; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.tl-card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; }
.tl-date { font-size: 22rpx; color: #aaa; }
.tl-view-btn { font-size: 24rpx; color: #2196f3; }
.tl-note { margin-top: 12rpx; padding: 12rpx 16rpx; background: #f0f7ff; border-radius: 8rpx; font-size: 24rpx; color: #555; }
.tl-resp-plan { margin: 16rpx 0; padding: 16rpx; background: #f9f9f9; border-radius: 8rpx; font-size: 26rpx; line-height: 1.7; color: #333; }
.tl-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.tl-img { width: 200rpx; height: 200rpx; border-radius: 8rpx; }

/* === 旧版保留（不删防止组件用到） === */
