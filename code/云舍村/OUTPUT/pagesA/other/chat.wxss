page { background: #f5f5f5; height: 100%; }
.chat-wrap { display: flex; flex-direction: column; height: 100vh; }
.msg-list { flex: 1; overflow-y: auto; padding: 16rpx 0 20rpx; }
.msg-item { display: flex; margin: 16rpx 24rpx; align-items: flex-end; }
.msg-item.admin { flex-direction: row; }
.msg-item.user { flex-direction: row-reverse; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; background: #ddd; }
.bubble { max-width: 60%; padding: 18rpx 24rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.msg-item.admin .bubble { background: #fff; color: #333; margin-left: 16rpx; border-top-left-radius: 4rpx; }
.msg-item.user .bubble { background: #1a1a1a; color: #fff; margin-right: 16rpx; border-top-right-radius: 4rpx; }
.time-label { text-align: center; color: #aaa; font-size: 22rpx; margin: 16rpx 0 8rpx; }
.input-bar { background: #fff; border-top: 1rpx solid #eee; padding: 16rpx 24rpx; display: flex; align-items: center; gap: 16rpx; }
.input-box { flex: 1; background: #f5f5f5; border-radius: 40rpx; padding: 14rpx 24rpx; font-size: 28rpx; max-height: 160rpx; }
.send-btn { background: #1a1a1a; color: #fff; border-radius: 40rpx; padding: 14rpx 32rpx; font-size: 28rpx; flex-shrink: 0; }
.send-btn.disabled { background: #ccc; }
.empty-tip { text-align: center; color: #bbb; font-size: 26rpx; padding: 60rpx 40rpx; line-height: 1.8; }
