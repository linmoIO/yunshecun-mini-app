<view class="pd-wrap" wx:if="{{product}}">
  <!-- 图片轮播 -->
  <swiper class="pd-swiper" autoplay circular indicator-dots>
    <swiper-item wx:for="{{images}}" wx:key="index">
      <image src="{{item}}" mode="aspectFill" style="width:100%;height:560rpx" bindtap="previewImg" data-src="{{item}}"></image>
    </swiper-item>
  </swiper>

  <!-- 价格 & 名称 -->
  <view class="pd-main">
    <view class="pd-price-row">
      <text class="pd-price">¥{{product.price}}</text>
      <text class="pd-price-ori" wx:if="{{product.originalPrice}}">¥{{product.originalPrice}}</text>
      <text class="pd-stock" wx:if="{{product.stock>0}}">库存{{product.stock}}件</text>
      <text class="pd-stock sold-out" wx:elif="{{product.stock===0}}">已售罄</text>
    </view>
    <view class="pd-name">{{product.name}}</view>
    <view class="pd-desc" wx:if="{{product.description}}">{{product.description}}</view>

    <!-- 数量 -->
    <view class="pd-qty-row">
      <text class="pd-label">数量</text>
      <view class="pd-stepper">
        <view class="step-btn" bindtap="decQty">－</view>
        <text class="step-num">{{qty}}</text>
        <view class="step-btn" bindtap="incQty">＋</view>
      </view>
    </view>
  </view>

  <!-- 详情描述 -->
  <view class="pd-section" wx:if="{{product.description}}">
    <view class="pd-sec-title">商品详情</view>
    <view class="pd-sec-content">{{product.description}}</view>
  </view>

  <!-- 底部操作栏 -->
  <view class="pd-bottom-bar">
    <view class="pd-total">合计 <text style="color:#e05d44;font-weight:700;font-size:36rpx">¥{{total}}</text></view>
    <view class="pd-buy-btn {{product.stock===0?'disabled':''}}" bindtap="goBuy">立即购买</view>
  </view>
  <view style="height:130rpx"></view>
</view>
<view class="pd-loading" wx:if="{{!product && loading}}">加载中...</view>
