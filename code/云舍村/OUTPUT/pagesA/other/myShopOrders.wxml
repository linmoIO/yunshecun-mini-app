<view class="mso-wrap">
  <view wx:if="{{loading && !orders.length}}" class="mso-loading">加载中...</view>
  <view wx:elif="{{!orders.length}}" class="mso-empty">暂无订单</view>

  <view class="mso-card" wx:for="{{orders}}" wx:key="id">
    <view class="mso-card-header">
      <text class="mso-order-no">订单 {{item.orderNo.slice(-10)}}</text>
      <view class="mso-status {{item.statusClass}}">{{item.statusText}}</view>
    </view>

    <!-- 商品列表 -->
    <view class="mso-items">
      <view class="mso-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="oi">
        <image class="mso-item-img" src="{{oi.product.coverImage}}" mode="aspectFill" wx:if="{{oi.product&&oi.product.coverImage}}"></image>
        <view class="mso-item-info">
          <view class="mso-item-name">{{oi.productName}}</view>
          <view class="mso-item-price">¥{{oi.price}} × {{oi.quantity}}</view>
        </view>
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="mso-meta" wx:if="{{item.notes}}">{{item.notes}}</view>

    <!-- 物流信息 -->
    <view class="mso-tracking" wx:if="{{item.trackingNo}}">
      <text style="color:#2196f3">📦 快递运单号：{{item.trackingNo}}</text>
      <text class="mso-copy-btn" bindtap="copyTracking" data-no="{{item.trackingNo}}">复制</text>
    </view>
    <view class="mso-tracking-empty" wx:elif="{{item.status==='shipped'&&!item.trackingNo}}">
      <text style="color:#aaa">📦 已发货，暂无运单号</text>
    </view>

    <view class="mso-card-footer">
      <text class="mso-date">{{item.createdAtFmt}}</text>
      <text class="mso-total">合计 <text style="color:#e05d44;font-weight:700">¥{{item.totalAmount}}</text></text>
    </view>
  </view>
</view>
