<scroll-view class="diy-wrap" scroll-y>
  <!-- 顶部介绍 -->
  <view class="diy-hero">
    <view class="diy-hero-title">{{title}}</view>
    <view class="diy-hero-desc" wx:if="{{intro}}">{{intro}}</view>
  </view>

  <!-- 后台自定义内容区 -->
  <view class="diy-content-card" wx:if="{{content}}">
    <rich-text nodes="{{content}}"></rich-text>
  </view>

  <!-- 需求填写表单 -->
  <view class="diy-form-card">
    <view class="diy-form-title">📝 告诉我们您的需求</view>

    <view class="diy-field">
      <view class="diy-label">意向目的地</view>
      <input class="diy-input" placeholder="如：香格里拉、梅里雪山" value="{{form.destinations}}" bindinput="onInput" data-key="destinations"/>
    </view>

    <view class="diy-field">
      <view class="diy-label">期望出发日期</view>
      <input class="diy-input" placeholder="如：2026年7月初" value="{{form.startDate}}" bindinput="onInput" data-key="startDate"/>
    </view>

    <view class="diy-field-row">
      <view class="diy-field flex1">
        <view class="diy-label">出行天数</view>
        <input class="diy-input" placeholder="如：7天" value="{{form.duration}}" bindinput="onInput" data-key="duration"/>
      </view>
      <view class="diy-field flex1">
        <view class="diy-label">出行人数</view>
        <input class="diy-input" type="number" placeholder="如：2人" value="{{form.persons}}" bindinput="onInput" data-key="persons"/>
      </view>
    </view>

    <view class="diy-field">
      <view class="diy-label">预算范围（元/人）</view>
      <input class="diy-input" placeholder="如：5000-8000" value="{{form.budget}}" bindinput="onInput" data-key="budget"/>
    </view>

    <view class="diy-field">
      <view class="diy-label">其他需求说明</view>
      <textarea class="diy-textarea" placeholder="出行偏好、特殊要求、需要安排的事项等..." value="{{form.requirements}}" bindinput="onInput" data-key="requirements" auto-height maxlength="500"/>
    </view>

    <view class="diy-divider"></view>
    <view class="diy-form-title">📞 联系方式</view>

    <view class="diy-field">
      <view class="diy-label">您的姓名</view>
      <input class="diy-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-key="name"/>
    </view>

    <view class="diy-field">
      <view class="diy-label">手机号码 *</view>
      <input class="diy-input" type="number" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onInput" data-key="phone" maxlength="11"/>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="diy-submit-wrap">
    <view class="diy-submit-btn {{submitting?'disabled':''}}" bindtap="submit">{{submitting ? '提交中...' : '提交定制需求'}}</view>
    <view class="diy-tip">提交后，我们的专属顾问将在1个工作日内与您联系</view>
  </view>
  <view style="height:60rpx"></view>
</scroll-view>
