page { background: #f5f5f5; }
.inv-wrap { min-height: 100vh; }
.inv-tabs { display: flex; background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.inv-tab { flex: 1; text-align: center; padding: 26rpx; font-size: 28rpx; color: #888; }
.inv-tab.active { color: #1a1a1a; font-weight: 700; border-bottom: 4rpx solid #1a1a1a; }
.inv-section { background: #fff; margin: 16rpx; border-radius: 16rpx; padding: 24rpx 28rpx; }
.inv-section-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; color: #1a1a1a; }
.inv-loading, .inv-empty { text-align: center; padding: 40rpx; color: #bbb; font-size: 26rpx; }
.inv-order { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; border: 1.5rpx solid #f0f0f0; border-radius: 10rpx; margin-bottom: 10rpx; }
.inv-order.selected { border-color: #1a1a1a; background: #f5f5f5; }
.inv-check { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #ccc; text-align: center; line-height: 34rpx; font-size: 22rpx; flex-shrink: 0; }
.inv-order.selected .inv-check { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
.inv-order-name { font-size: 26rpx; color: #333; }
.inv-order-meta { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.inv-total { text-align: right; font-size: 26rpx; font-weight: 700; color: #e05d44; margin-top: 12rpx; }
.inv-field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f9f9f9; }
.inv-label { width: 160rpx; font-size: 26rpx; color: #555; flex-shrink: 0; }
.inv-input { flex: 1; font-size: 26rpx; color: #1a1a1a; }
.inv-type-btns { display: flex; gap: 12rpx; }
.inv-type-btn { padding: 8rpx 24rpx; border: 1.5rpx solid #ddd; border-radius: 30rpx; font-size: 24rpx; color: #666; }
.inv-type-btn.active { border-color: #1a1a1a; color: #1a1a1a; font-weight: 600; }
.inv-submit-btn { margin: 20rpx; background: #1a1a1a; color: #fff; text-align: center; padding: 28rpx; border-radius: 60rpx; font-size: 30rpx; font-weight: 700; }
.inv-submit-btn.disabled { background: #aaa; }
.inv-record { background: #fff; margin: 16rpx; border-radius: 16rpx; padding: 24rpx 28rpx; }
.inv-record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.inv-record-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }
.inv-record-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; background: #f5f5f5; color: #666; }
.inv-record-status.done { background: #e8f5e9; color: #27ae60; }
.inv-record-status.pending { background: #fff8e1; color: #f39c12; }
.inv-record-status.processing { background: #e3f2fd; color: #2196f3; }
.inv-record-status.rejected { background: #fce4ec; color: #e91e63; }
.inv-record-meta { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.inv-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.inv-img { width: 200rpx; height: 200rpx; border-radius: 8rpx; }
.inv-note { font-size: 24rpx; color: #555; background: #f0f7ff; padding: 10rpx 14rpx; border-radius: 8rpx; margin-top: 10rpx; }
.inv-reject { font-size: 24rpx; color: #e91e63; margin-top: 8rpx; }
.inv-record-date { font-size: 22rpx; color: #aaa; margin-top: 10rpx; }
