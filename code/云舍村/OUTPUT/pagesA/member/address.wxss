page { background: #f5f5f5; }
.addr-wrap { padding: 20rpx; }
.addr-card { background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.addr-card.default { border: 2rpx solid #1a1a1a; }
.addr-top { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.addr-name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.addr-phone { font-size: 26rpx; color: #555; }
.addr-default-tag { background: #1a1a1a; color: #fff; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 20rpx; }
.addr-detail { font-size: 26rpx; color: #666; line-height: 1.5; }
.addr-actions { display: flex; gap: 20rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; justify-content: flex-end; }
.addr-set-default, .addr-edit, .addr-del { font-size: 24rpx; padding: 6rpx 20rpx; border-radius: 20rpx; }
.addr-set-default { color: #2196f3; border: 1rpx solid #2196f3; }
.addr-edit { color: #555; border: 1rpx solid #ddd; }
.addr-del { color: #e05d44; border: 1rpx solid #e05d44; }
.addr-empty { text-align: center; padding: 60rpx; color: #bbb; font-size: 28rpx; }
.addr-form-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.addr-form-title { font-size: 28rpx; font-weight: 700; margin-bottom: 20rpx; }
.addr-field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.addr-default-row { border-bottom: none; padding-bottom: 0; }
.addr-label { width: 140rpx; font-size: 26rpx; color: #555; flex-shrink: 0; }
.addr-input { flex: 1; font-size: 26rpx; color: #1a1a1a; }
.addr-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.addr-cancel-btn { flex: 1; border: 1.5rpx solid #ddd; text-align: center; padding: 22rpx; border-radius: 50rpx; font-size: 28rpx; color: #666; }
.addr-save-btn { flex: 2; background: #1a1a1a; color: #fff; text-align: center; padding: 22rpx; border-radius: 50rpx; font-size: 28rpx; font-weight: 600; }
.addr-save-btn.disabled { background: #aaa; }
.addr-add-btn { background: #fff; border: 1.5rpx dashed #ddd; text-align: center; padding: 28rpx; border-radius: 16rpx; font-size: 28rpx; color: #888; }
