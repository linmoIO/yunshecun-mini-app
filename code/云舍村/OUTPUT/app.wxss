.arrow:after {
    border-right: 1px solid #000;
    border-top: 1px solid #000;
    content: "";
    display: block;
    height: 12rpx;
    left: 100%;
    margin: 0 0 0 -20rpx;
    position: absolute;
    top: calc(50% - 6rpx);
    transform: rotate(45deg);
    transition: all .5s;
    width: 12rpx
}

