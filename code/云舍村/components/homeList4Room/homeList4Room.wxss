.wrap {
  padding: 0 30rpx 150rpx 20rpx;
  flex: 1;
  overflow-y: scroll;
  min-height: 0;
  color: #515151;
  background-color: #F0ECE0;
}

.flex {
  display: flex;
}

.spaceBetween {
  justify-content: space-between;
}

.homeList {
  position: relative;
  box-sizing: border-box;
  background-color: #F9F6EE;
  margin-bottom: 32rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.homePicSwiper {
  width: 100%;
  height: 420rpx;
  aspect-ratio: 400 / 620;
  display: block;
  overflow: hidden;
}

.homeList .homePic {
  width: 100%;
  aspect-ratio: 400 / 620;
  z-index: 0;
  display: block;
}

.homeInfo {
  font-size: 50rpx;
  padding: 35.7rpx;
}

.homeName {
  color: #664F2D;
  font-family: Tensentype TongSongJ;
  font-size: 36rpx;
  line-height: 43rpx;
  text-align: left;
  margin-bottom: 14rpx;
}

.maxPeople {
  font-size: 23rpx;
  font-family: 'Inter';
  height: 52.5rpx;
  display: flex;
  align-items: center;
  gap: 47.6rpx;
}

.homeListBg {
  width: 35%;
}

.homeListBg image {
  position: absolute;
  right: 30rpx;
  bottom: 45rpx;
  width: 102rpx;
  height: 50rpx;
}

.homeListBg .text {
  font-size: 24rpx;
  color: #ffffff;
  width: 200rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  position: absolute;
  bottom: 20rpx;
  right: 35rpx;
}

.orderStatus {
  margin-bottom: 25rpx;
  font-size: 37.5rpx;
}

.wrap :last-child {
  border: 0;
}

.cancel_payment {
  padding-top: 20rpx;
  display: flex;
  gap: 10rpx;
}

.cancel_payment button:nth-child(1) {
  width: 100rpx;
  height: 50rpx;
  font-size: 20rpx;
  background-color: #E4E4E4;
  font-family: '微软雅黑';
}

.cancel_payment button:nth-child(2) {
  width: 150rpx;
  height: 50rpx;
  font-size: 20rpx;
  background-color: #B09D73;
  font-family: '微软雅黑';
  color: #fff;
}

.homeRoomInfo {
  border-bottom: 1px solid #90816c3e;
  padding-bottom: 16rpx;
}

.roomLable {
  display: flex;
  align-items: center;
  gap: 15rpx;
  color: rgb(138,138,138);
}

.roomLable image {
  width: 30rpx;
  height: 30rpx;
}

.roomPrice {
  padding-top: 31.5rpx;
  font-family: Inter;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 30rpx;
  color: #977730;
}

  /**
    底部留白
  */
  .bottom_blank {
    display: block;
    width: 100%;
    height: 150rpx;
  }
