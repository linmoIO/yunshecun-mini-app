<view class="wrap">
  <view class="homeList" wx:for="{{ListInfo}}" wx:key="categoryId" data-id="{{item.id || item.categoryId}}"
    bind:tap="checkOrder">
    <view>
      <view style=" margin-top:{{ hidShowStatus == false ? '' : '60rpx'}};">
        <view>
          <view hidden="{{hidShowStatus==false}}"
            style="font-size: 25rpx; position: absolute; top: 40rpx;font-family:'Inter';">
            订单号： {{item.orderNo}}
          </view>
          <view hidden="{{hidShowStatus == false}}"
            style="font-size: 25rpx; position: absolute; top: 40rpx;right: 0;font-family:'Inter'; color:{{orderStatusEnum[item.orderStatus] == '已预约'? '#000000' : '#929292' }}">
            {{orderStatusEnum[item.orderStatus]}}
          </view>
          <view wx:if="{{hidShowStatus == true}}"
            style="font-size: 40rpx; color: #B09D73; position: absolute; bottom: 60rpx; right: 0; font-family: 'Inter'; display: flex; flex-direction: column; align-items: flex-end;">
            <text> ￥{{item.price}}</text>
            <view class="cancel_payment" wx:if="{{orderStatusEnum[item.orderStatus] == '待支付'}}">
              <button>取消</button><button catch:tap="continue_payment" data-id="{{item.orderNo}}">继续支付</button>
            </view>
          </view>
        </view>
        <swiper
          class="homePicSwiper"
          indicator-dots="{{true}}"
          indicator-color="rgba(255,255,255,0.5)"
          indicator-active-color="#fff"
          indicator-width="{{2}}"
          indicator-height="{{2}}"
          autoplay="{{false}}"
          duration="{{500}}"
          circular="{{true}}"
        >
          <swiper-item wx:for="{{item.imageList}}" wx:key="id">
            <image class="homePic" src="{{item}}" mode="aspectFill" style="z-index: 50;" />
          </swiper-item>
        </swiper>
        <view class="homeInfo" data-room-id="{{item.categoryId}}" data-user-num="{{item.peopleNum}}"
          data-room-name="{{item.categoryName}}" data-price="{{item.price}}"
          data-facilities="{{item.facilities}}"
          data-village="{{item.village}}"
          data-bathroom="{{item.bathroom}}"
          catch:tap="{{item.status === 0 ? '' : 'goOrderPage' }}">
          <view class="homeRoomInfo">
            <view class="homeName" style="font-family: 'I.PenCrane-s';">{{item.categoryName}}</view>
            <view class="maxPeople" wx:if="{{hidShowStatus==false}}">
              <div class="roomLable">
                <image src="https://yunshecun.oss-cn-guangzhou.aliyuncs.com/applet/img/popleIcon.png" />
                1~{{item.peopleNum}} 位
              </div>
              <div class="roomLable">
                <image src="https://yunshecun.oss-cn-guangzhou.aliyuncs.com/applet/img/frameIcon.png" />
                {{item.squareMeasure}}m²
              </div>
              <div class="roomLable">
                <image src="https://yunshecun.oss-cn-guangzhou.aliyuncs.com/applet/img/badIcon.png" />
                {{item.roomInfo}}
              </div>
            </view>
          </view>
          <view>
            <view class="roomPrice" style="font-family: 'Inter';"
              hidden="{{hidShowStatus}}">
              ￥ <span style="font-size: 31.5rpx; line-height: 30rpx">{{item.price}}</span> / 晚
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="homeListBg" hidden="{{hidShowStatus}}" data-room-id="{{item.categoryId}}"
      data-user-num="{{item.peopleNum}}" data-room-name="{{item.categoryName}}" data-price="{{item.price}}"
      data-facilities="{{item.facilities}}"
      data-village="{{item.village}}"
      data-bathroom="{{item.bathroom}}"
      catch:tap="{{item.status === 0 ? '' : 'goOrderPage' }}">
      <view class="text" style="pointer-events:{{item.status === 0 ? 'none' : 'auto'}}"
        style="background-color: {{item.status === 0 ? '#C4C4C4' : '#B09D73 '}};" data-room-id="{{item.categoryId}}"
        data-user-num="{{item.peopleNum}}" data-room-name="{{item.categoryName}}" data-price="{{item.price}}"
        data-village="{{item.village}}"
        data-facilities="{{item.facilities}}"
        data-bathroom="{{item.bathroom}}"
        catch:tap="{{item.status === 0 ? '' : 'goOrderPage' }}">
        {{item.status === 0 ? '满房' : '选择'}}
      </view>
    </view>
  </view>
  <view class="bottom_blank">
    </view>
</view>