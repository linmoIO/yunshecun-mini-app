<!--components/top-info/top-info.wxml-->
<view class="info" wx:if="{{notice.length > 0}}">
  <image class="info-img" src="/pages/images/bell.png" mode=""/>

  <swiper class="swiper_zi" vertical="true" autoplay="true" circular="true" interval="3000">
    <block wx:for="{{notice}}" wx:key="{{item.id}}">
    <swiper-item style="width: 50%;">

      <view class="info-text" bindtap="openPopup" data-index="1" data-id="{{item.id}}">{{item.title}}</view>
      <view class="page-fangke-btn" bindtap="openPopup" data-index="1" data-id="{{item.id}}">详情</view>
      
    </swiper-item>
  </block>
  </swiper>

</view>
<view class="popup-box" wx:if="{{showIndex=='1'}}" bindtap="closePopup"></view> 
<view class="info-center" wx:if="{{showIndex=='1'}}">
  <view class="info-content">
    <view class="row-info" style="width:90%;">
      <view class="info-close">
        <text>{{noticeDetail.title}}</text>
        <image bindtap="closePopup" src="/pages/images/close.png" mode=""/>
      </view>
      <view class="info-contents">

        <view class="info-content-list">
          <text>{{noticeDetail.content}}</text>
        </view>

        <view class="info-content-list">
          <text class="notification_bottom">{{noticeDetail.remark}}<text style="color: #977730;" bind:tap="makePhoneCall" data-tel="{{noticeDetail.remark2}}">{{noticeDetail.remark2}}</text>
          </text>
        </view>
      </view>
    </view>
  </view>
</view>