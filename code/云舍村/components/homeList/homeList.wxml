<view class="wrap">
  <view class="homeList" wx:for="{{ListInfo}}" wx:key="categoryId" data-id="{{item.id || item.categoryId}}" bind:tap="checkOrder">
    <view class="flex spaceBetween">
      <view class="flex column" style=" margin-top:{{ hidShowStatus == false ? '' : '60rpx'}};">
        <view>
          <view hidden="{{hidShowStatus==false}}" style="font-size: 25rpx; position: absolute; top: 40rpx;font-family:'Inter';">
            订单号： {{item.orderNo}}
          </view>
          <view hidden="{{hidShowStatus == false}}" style="font-size: 25rpx; position: absolute; top: 40rpx;right: 0;font-family:'Inter'; color:{{orderStatusEnum[item.orderStatus] == '已预约'? '#000000' : '#929292' }}">
            {{orderStatusEnum[item.orderStatus]}}
          </view>
          <view wx:if="{{hidShowStatus == true}}" style="font-size: 40rpx; color: #B09D73; position: absolute; bottom: 60rpx; right: 0; font-family: 'Inter'; display: flex; flex-direction: column; align-items: flex-end;">
            <text> ￥{{null == item.payAmount ? item.payableAmount : item.payAmount}}</text>
            <view class="cancel_payment" wx:if="{{orderStatusEnum[item.orderStatus] == '待支付'}}">
              <button>取消</button><button catch:tap="continue_payment" data-id="{{item.orderNo}}">继续支付</button>
            </view>
            <text class=" maxPeople"></text>
          </view>
        </view>
        <image class="homePic" style="width:{{ hidShowStatus == false ? '' : '160rpx'}};  height:{{ hidShowStatus == false ? '' : '132rpx'}}; margin-top:{{ hidShowStatus == false ? '' : '30rpx'}}; " src="{{item.imageList[0]}}" mode="aspectFill" />
        <view class="homeInfo" data-room-id="{{item.categoryId}}" data-user-num="{{item.peopleNum}}" data-room-name="{{item.categoryName}}" data-price="{{item.price}}" catch:tap="goOrderPage">
          <view style=" margin-top:{{ hidShowStatus == false ? '' : '20rpx'}}; ">
            <view class="homeName" style="color: #000000; font-family: 'I.PenCrane-s';">{{item.categoryName}}</view>
            <view class="maxPeople" style="font-family: 'Inter'; font-size: 24rpx;" wx:if="{{hidShowStatus==false}}">最多入住{{item.peopleNum}}人</view>
            <view class="maxPeople" style="font-family:'Inter';font-size: 25rpx; margin-top: 20rpx;line-height: 18px;" wx:else>{{item.roomNum}}间 {{item.days}}晚
            </view>
          </view>
          <view>
            <view style="font-size:25rpx; margin-top: 10rpx;" class="orderStatus" hidden="{{!hidShowStatus}}">
              <!-- {{item.status === 0 ? '待入住' : item.orderStatus === 1 ? '已退款' : '已退款' }} -->
              {{item.arriveDate}} 至 {{item.leaveDate}}
            </view>
            <view style="font-family: 'Inter'; font-size:30rpx; color: #977730; margin-top: 70rpx;" hidden="{{hidShowStatus}}">
              ￥{{item.price}}/晚
              <text class="maxPeople"></text>
            </view>
          </view>
        </view>
      </view>
      <view class="homeListBg" hidden="{{hidShowStatus}}" data-room-id="{{item.categoryId}}" data-user-num="{{item.peopleNum}}" data-room-name="{{item.categoryName}}" data-price="{{item.price}}" catch:tap="goOrderPage">
        <view class="text" style="pointer-events:{{item.status === 0 ? 'none' : 'auto'}}" style="background-color: {{item.status === 0 ? '#C4C4C4' : '#B09D73 '}};" data-room-id="{{item.categoryId}}" data-user-num="{{item.peopleNum}}" data-room-name="{{item.categoryName}}" data-price="{{item.price}}" catch:tap="goOrderPage">
          {{item.status === 0 ? '满房' : '选择'}}
        </view>
      </view>
    </view>
  </view>
</view> 