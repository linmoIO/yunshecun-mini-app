.wrap {
  padding: 0 30rpx 0rpx 20rpx;
  flex: 1;
  overflow-y: scroll;
  min-height: 0;
  color: #515151;
  background-color: #F0ECE0;
}

.flex {
  display: flex;
}

.spaceBetween {
  justify-content: space-between;
}

.homeList {
  position: relative;
  padding: 40rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.15);
}

.homeList .homePic {
  margin-right: 20rpx;
  width: 320rpx;
  height: 202rpx;
  border-radius: 10rpx;
  z-index: 0;
}

.homeInfo {
  width: 200rpx;
  font-size: 50rpx;
  display: flex;
  flex-direction: column;
}

.homeName {
  font-size: 40rpx;
}

.maxPeople {
  font-size: 30rpx;
}

.homeListBg {
  width: 35%;
}

.homeListBg image {
  position: absolute;
  right: 30rpx;
  bottom: 45rpx;
  width: 102rpx;
  height: 50rpx;
}

.homeListBg .text {
  font-size: 28rpx;
  color: #ffffff;
  width: 110rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
 position: absolute;
 bottom: 55rpx;
 right: 30rpx ; 
}

.orderStatus {
  margin-bottom: 25rpx;
  font-size: 37.5rpx;
}

.wrap :last-child {
  border: 0;
}

.cancel_payment {
  padding-top: 20rpx;
  display: flex;
  gap: 10rpx;
}

.cancel_payment button:nth-child(1) {
  width: 120rpx;
  height: 50rpx;
  font-size: 20rpx;
  background-color: #E4E4E4;
  font-family: '微软雅黑';

  padding: unset;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cancel_payment button:nth-child(2) {
  width: 150rpx;
  height: 50rpx;
  font-size: 20rpx;
  background-color: #B09D73;
  font-family: '微软雅黑';
  color: #fff;

  padding: unset;
  display: flex;
  justify-content: center;
  align-items: center;
}