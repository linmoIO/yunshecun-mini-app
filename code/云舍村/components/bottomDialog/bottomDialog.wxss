.popupWrapper {
  --td-popup-border-radius: 50px
}

.block {
  width: 100vw;
  background: #F4EFE2;
  border-top-left-radius: 50rpx;
  border-top-right-radius: 50rpx;
}

.wrapper {
  margin: 32rpx;
  display: block;

}

.header {
  display: flex;
  align-items: center;
  height: 116rpx;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-family: auto;
  font-weight: 600;
  position: relative;
  padding-left: 115rpx;
}

.btn {
  font-size: 32rpx;
  padding: 32rpx;
}

.btn--cancel {
  color: rgba(0, 0, 0, .6);
}

.btn--confirm {
  color: #0052d9;
}

.topBackground {
  width: 100vw;
  height: 100rpx;
  background-color: #F4EFE2;
  border-top-left-radius: 50rpx;
  border-top-right-radius: 50rpx;
}

.close {
  width: 40rpx;
  height: 40rpx;
  padding: 40rpx;
  /* margin-right: 40rpx; */
}

.content {
  display: flex;
  justify-content: space-between;
  padding: 0 50rpx;
  margin-top: 40rpx;
  box-sizing: border-box;
  margin-bottom: 50rpx; 
  font-family: auto;
  color: #000000;
}

.submit {
  padding: 0 50rpx;
  margin: 0 auto;
  width: 80%;
  text-align: center;
  font-size: 36rpx;
  line-height: 110rpx;
  color: #665952;
  background-color: #D9CDB3;
  border-top-left-radius:15rpx;
  border-top-right-radius:15rpx;
  border-bottom-left-radius:15rpx;
  border-bottom-right-radius:15rpx;
  font-family: 'Inter';
}