<t-popup visible="{{visible}}" bind:visible-change="onVisibleChange" placement="bottom" class="popupWrapper">
  <view class="block" style="height: 36vh;">
    <view class="topBackground">
      <view class="header">
        <view class="title">入住人数以及房间数</view>
        <view bind:tap="closePopup" >
          <image src="../../images/close.png" mode="" class="close"/>
        </view>
      </view>
    </view>
    <view class="content">
      <view>客房</view>
      <t-stepper defaultValue="{{ homeNumber }}" min="1" max="99" theme="filled" onchange="changeNumber" data-s="homeNumber" />
    </view>
    <view class="content">
      <view>成人 ( 每间 )</view>
      <t-stepper defaultValue="{{ adultNumber }}" min="1" max="99" theme="filled" onchange="changeNumber" data-s="adultNumber" />
    </view>
    
    <view class="content"> 
      <view>儿童 ( 每间 )</view>
      <t-stepper defaultValue="{{ childrenNumber }}"  min="0" max="1" theme="filled" onchange="changeNumber" data-s="childrenNumber" />
    </view>
  </view>
  <view class="submit" bind:tap="submit">确认</view>
</t-popup>