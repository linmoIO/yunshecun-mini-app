.tc { padding: 8rpx 32rpx 0; color: #302e29; }
.tc-section { margin-top: 40rpx; }
.tc-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20rpx; }
.tc-title { font-size: 36rpx; font-weight: 600; line-height: 1.4; color: #2b261f; }
.tc-more { font-size: 25rpx; color: #8a7559; }

.tc-term { padding: 32rpx 30rpx 28rpx; background: #f4efe6; border-radius: 12rpx; }
.tc-term-top { display: flex; align-items: baseline; margin-bottom: 18rpx; }
.tc-term-name { font-size: 44rpx; font-weight: 600; color: #59472f; }
.tc-term-date { margin-left: 18rpx; font-size: 25rpx; color: #8a7559; }
.tc-row { display: flex; margin-top: 12rpx; font-size: 27rpx; line-height: 1.65; }
.tc-label { flex: 0 0 40rpx; height: 40rpx; margin: 4rpx 18rpx 0 0; border-radius: 6rpx; background: #756044; color: #fff; font-size: 23rpx; line-height: 40rpx; text-align: center; }
.tc-text { flex: 1; color: #4c4840; }
.tc-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tc-next { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #e3d9c8; font-size: 24rpx; color: #8a7559; }

.tc-scroll { white-space: nowrap; }
.tc-card { display: inline-block; width: 300rpx; margin-right: 22rpx; vertical-align: top; white-space: normal; }
.tc-cover { display: block; width: 300rpx; height: 200rpx; border-radius: 10rpx; background: #ece5d9; }
.tc-card-body { padding: 14rpx 4rpx 0; }
.tc-card-title { font-size: 28rpx; font-weight: 600; line-height: 1.45; color: #2b261f; }
.tc-card-meta { margin-top: 6rpx; font-size: 23rpx; color: #8a7559; }
