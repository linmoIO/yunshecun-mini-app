
.nav {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  width: 100%;
  overflow: hidden;
}
.black{
    width: 100vw;
    overflow: hidden;
    z-index: 10;
    color: #ffffff;
    background: linear-gradient(180deg, #2b2b2d, #262626);
}
.nav-title {
  width: 100%;
  height: 45px;
  line-height: 45px;
  font-weight: 600;
  text-align: center;
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 10;
  font-family: PingFang-SC-Medium;
  font-size: 34rpx;
}

.back {
  width: 22px;
  height: 100%;
  padding-inline: 15px;
  object-fit: contain;
  z-index: 10;
}
.overflow {
  overflow: auto;
}

.hidden {
  overflow: hidden;
}

.wrap {
  box-sizing: border-box;
  overflow: hidden;
  padding: 40rpx 40rpx 0;
}
