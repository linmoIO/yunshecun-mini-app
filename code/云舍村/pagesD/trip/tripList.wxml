<view class="tl-page">
  <!-- 顶部 tabs -->
  <view class="tl-tabs">
    <view class="tl-tab {{activeTab===0?'active':''}}" bindtap="switchTab" data-idx="0">行程计划</view>
    <view class="tl-tab {{activeTab===1?'active':''}}" bindtap="switchTab" data-idx="1">我的行程</view>
  </view>

  <!-- 行程计划 tab：显示酒旅订单（用 hidden 避免切换时销毁视图导致空白）-->
  <view hidden="{{activeTab!==0}}">
    <view wx:if="{{ordersLoading}}" class="tl-empty">加载中...</view>
    <view wx:elif="{{!orders.length}}" class="tl-empty">
      <text>暂无酒旅订单</text>
      <text style="font-size:24rpx;color:#aaa;margin-top:8rpx">预订旅游套餐或酒店后订单将显示于此</text>
    </view>

    <view class="tl-card" wx:for="{{orders}}" wx:key="orderNo" bindtap="goOrderDetail" data-idx="{{index}}">
      <view class="tl-card-header">
        <view class="tl-card-title">{{item.channelText}} · {{item.title}}</view>
        <view class="tl-status">{{item.statusText}}</view>
      </view>
      <view class="tl-card-row" wx:if="{{item.link}}">
        <image src="{{item.link}}" mode="aspectFill" style="width:80rpx;height:60rpx;border-radius:8rpx;margin-right:12rpx;vertical-align:middle"/>
      </view>
      <view class="tl-card-footer">
        <text class="tl-date">订单号：{{item.orderNo}}</text>
        <text class="tl-price" style="color:#e05d44">¥{{item.price}}</text>
      </view>
    </view>
  </view>

  <!-- 我的行程 tab：DIY 行程方案（hidden 保持视图不销毁）-->
  <view hidden="{{activeTab!==1}}">
    <view class="tl-add-btn" bindtap="goNewPlan">＋ 提交新的定制需求</view>

    <view wx:if="{{responsesLoading}}" class="tl-empty">加载中...</view>
    <view wx:elif="{{!responses.length}}" class="tl-empty">
      <text>暂无行程方案</text>
      <text style="font-size:24rpx;color:#aaa;margin-top:8rpx">提交定制需求后，顾问将为您规划专属方案</text>
    </view>

    <view class="tl-card tl-resp-card" wx:for="{{responses}}" wx:key="id">
      <view class="tl-card-header">
        <view class="tl-card-title">专属行程方案</view>
        <view class="tl-status" style="color:#27ae60">已出方案</view>
      </view>
      <view class="tl-card-row">📍 {{item.destinations || '定制路线'}}</view>
      <view class="tl-resp-plan" wx:if="{{item.responsePlan}}">
        <rich-text nodes="{{item.responsePlan}}"></rich-text>
      </view>
      <view class="tl-imgs" wx:if="{{item.imgs.length}}">
        <image wx:for="{{item.imgs}}" wx:key="index" wx:for-item="img" src="{{img}}" mode="aspectFill" class="tl-img" bindtap="viewResponse" data-idx="{{index}}"></image>
      </view>
      <view class="tl-card-footer">
        <text class="tl-date">提交时间：{{item.createdAtFmt}}</text>
        <text wx:if="{{item.imgs.length}}" class="tl-view-btn" bindtap="viewResponse" data-idx="{{index}}">查看全图 →</text>
      </view>
      <view class="tl-note" wx:if="{{item.adminNote}}">💬 顾问备注：{{item.adminNote}}</view>
    </view>
  </view>
</view>
