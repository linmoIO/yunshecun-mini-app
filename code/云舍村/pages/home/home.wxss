@keyframes clearness-opacity {
  0% {
    opacity: 1;
  }

  100% {
    opacity: 0;
  }
}

.swiper-box {
  width: 100%;
}
@keyframes ScrollnavigateAnimation {
  0% {
    left: 100rpx;
  }

  45% {
    left: 0;
  }

  55% {
    left: 0;
  }

  100% {
    left: -100rpx;
  }
}

.loading-logo {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10001;
  width: 240rpx;
  height: 120rpx;
  pointer-events: none;
}

.text_auto {
  transition-duration: 1.5s;
  width: 100%;
  height: 0;
  position: absolute;
  bottom: 0;
  z-index: 7777;
  flex-direction: column;
  align-items: center;
  color: #FFFFFF;
  font-size: 30rpx;
  gap: 40rpx;
  opacity: 0;
  display: flex;
  font-family: 'I.PenCrane-s';  
  transform: translateY(0);
}

.text_auto_hover {
  height: 80%;
  transition-duration: 1.2s;
  opacity: 1;
  transform: translateY(15vh);
  z-index: 2;
  display: flex;
}

.home-text-mask {
  position: absolute;
  width: 100vw;
  height: 100vh;
  background-color: #000000;
  opacity: 0.2;
  z-index: 1;
}

.swiper-container {
  width: 100%;
  height: 100vh;
}

.special_character {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100vw;
  height: calc(100vh - var(--tabbar-height));
  opacity: 1;
  background-color: #66595280;
  /* backdrop-filter: blur(3vw); */
  z-index: 10000;
  pointer-events: none;
  animation: clearness-opacity 1s linear;
  animation-fill-mode: forwards;
  animation-delay: 2s;
}

.guide-loading {
  position: absolute;
  top: 50%;
  left: 0rpx;
  z-index: 1000;
  width: 100rpx;
  height: 1px;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.2);
}

.guide-loading::after {
  content: "";
  position: absolute;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: #fff;
  animation: ScrollnavigateAnimation 2s infinite cubic-bezier(0.77, 0, 0.18, 1)
}

.container {
  width: auto;
  height: 100vh;
}

.top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: calc((100vh - var(--tabbar-height)) * 0.009);
  z-index: 100;
}

.bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: calc((100vh - var(--tabbar-height)) * 0.009);
  z-index: 100;
}

.first-screen-wrapper {
  position: relative;
  flex-shrink: 0;
  height: 100vh;
  z-index: 100;
  overflow: hidden;
}

.max_carousel2 {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  justify-content: center;
}

.max_carousel2 image {
  width: 100%;
  height: 90%;
}

.scroll-left {
  position: absolute;
  right: 0;
  top: 0;
  height: calc(100vh - var(--tabbar-height));
  z-index: 101;
}

.first-screen {
  display: block;
  /* width: calc((100vh - var(--tabbar-height)) * 0.462); */
  width: 140vw;
  height: calc(100vh - var(--tabbar-height));
  transition: opacity 0.8s linear;
}

.first-screen-1 {
  opacity: 0;
}

.imgCss {
  position: absolute;
  left: 0px;
  top: 0px;
  object-fit: cover;
  /* 保持原有尺寸比例。内容被缩放。 */
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: 3s;
  /* 淡入淡出过渡时间 */
}

.swiper {
  width: 100%;
  height: 100%;
  margin: 0;
}

.home-swiper {
  width: 100%;
  height: 100%;
  margin: 0;
}

.line_top {
  background-color: #ffffff;
  width: 3rpx;
  height: 110rpx;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 10%;
  overflow: hidden;
}

.line {
  width: 3rpx;
  height: 130rpx;
  background-color: #665952;
  transform-origin: center;
  animation: lineAnimation 4s ease-in-out infinite;
  overflow: hidden;
  /* infinite */
  /* position: absolute;
  left: 0; */
}

@keyframes lineAnimation {
  0% {
    height: 0rpx;
  }
  50% {
    height: 160rpx;
    background-color: #665952;
    margin-top: 0rpx;
  }
  100% {
    margin-top: 160rpx;
  }
}
.ShowCss {
  opacity: 1;
  transform: translateX(-7px);
  animation: move-left_2 7s linear;
}

@keyframes move-left_2 {
  0% {
    transform: translateX(0px);
  }
  100% {
    transform: translateX(-7px);
  }
}

.first-screen-text {
  transition-duration: 1s;
  position: absolute;
  top:30%;
  left: 45%;
  width: 124rpx;
  height: auto;
  z-index: 2;
}
.first-screen-text2{
  transition-duration: 0.7s;
  transform:translateY(calc(30% - 350rpx))
}
.first-screen_77 {
  width: 135rpx !important;
  height: 318rpx !important;
  position: absolute;
  right: 37%;
  margin-top: 17%;
  opacity: 0;
  animation: clearness-opacity-reverse 0.5s linear;
  animation-fill-mode: forwards;
  animation-delay: 3s;
}

.swiper-item {
  position: relative;
  flex-shrink: 0;
  height: calc(100vh - var(--tabbar-height));
  border-left: 1px solid #b6afa1;
  overflow: hidden;
}

.swiper-image {
  display: block;
  height: calc(100vh - var(--tabbar-height));
}

.content {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
}

.swiper-logo {
  position: absolute;
  width: 74rpx;
  top: 60rpx;
  right: 40rpx;
}

.banner-text-wrapper {
  position: absolute;
  right: calc((100vh - var(--tabbar-height)) * 0.122);
  top: calc((100vh - var(--tabbar-height)) * 0.037);
}

.banner-text {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 94rpx;
  letter-spacing: 5rpx;
}

.banner-text-bg {
  width: calc((100vh - var(--tabbar-height)) * 0.061);
  height: calc((100vh - var(--tabbar-height)) * 0.286);
}

.banner-text-content {
  position: absolute;
  top: 50%;
  left: 40%;
  width: calc((100vh - var(--tabbar-height)) * 0.021);
  font-size: 44rpx;
  transform: translate(-50%, -50%);
  color: var(--primary-color);
  word-break: break-all;
}

.banner-image {
  width: calc((100vh - var(--tabbar-height)) * 0.433);
  height: calc((100vh - var(--tabbar-height)) * 0.392);
  margin: calc((100vh - var(--tabbar-height)) * 0.364) auto 0;
  pointer-events: none;
}

.banner-image-wrapper {
  width: 100%;
  height: 100%;
}

.banner-image-pic {
  display: block;
  width: 100%;
  height: 100%;
}

.banner-image-pic:nth-child(2) {
  margin-top: calc((100vh - var(--tabbar-height)) * -0.392);
}

.banner-image-pic:nth-child(3) {
  margin-top: calc((100vh - var(--tabbar-height)) * -0.392);
}

.item-2 .banner-text {
  width: calc((100vh - var(--tabbar-height)) * 0.041);
}

.item-2 .banner-text-bg {
  width: calc((100vh - var(--tabbar-height)) * 0.041);
}

.item-2 .banner-text-content {
  width: calc((100vh - var(--tabbar-height)) * 0.013);
}

.swiper-controller {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 50rpx;
  margin-top: 50rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #6659524D;
  transition: all 0.5s linear;
}

.dot.active {
  width: 26rpx;
  height: 26rpx;
  background-color: #665952;
}

.subscribe {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  height: calc(100vh - var(--tabbar-height));
  overflow: hidden;
}

.subscribe-bg {
  display: block;
  height: 100%;
}

.subscribe-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.subscribe-text-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 55rpx;
  color: var(--primary-color);
}

.subscribe-text-bg {
  width: 100rpx;
  height: 242rpx;
}

.subscribe-text {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 55rpx;
  transform: translate(-50%, -50%);
}

.last-page {
  position: relative;
  flex-shrink: 0;
  width: calc((100vh - var(--tabbar-height)) * 0.592);
  height: calc(100vh - var(--tabbar-height));
  padding-bottom: 0;
  font-size: 30rpx;
  color: #C2BDA9;
}

.last-page-bg {
  display: block;
  width: 100%;
  height: 100%;
}

.last-page-text {
  position: absolute;
  top: 270px;
  left: 50%;
  transform: translateX(-50%);
  width: 450rpx;
}

.last-page .logo {
  position: absolute;
  top: 330rpx;
  right: 90rpx;
  width: 135rpx;
  z-index: 1;
}

.text-1 {
  position: absolute;
  top: 360rpx;
  left: 115rpx;
  width: 26rpx;
}

.text-2 {
  position: absolute;
  top: 360rpx;
  left: 152rpx;
  width: 26rpx;
}

.text-3 {
  position: absolute;
  top: 360rpx;
  left: 292rpx;
  width: 35rpx;
  font-size: 34rpx;
}

.text-4 {
  position: absolute;
  top: 360rpx;
  left: 334rpx;
  width: 26rpx;
}

.scroll-right {
  display: block;
  flex-shrink: 0;
  height: calc(100vh - var(--tabbar-height));
}

.seal {
  position: absolute;
  right: calc((100vh - var(--tabbar-height)) * 0.222);
  top: calc((100vh - var(--tabbar-height)) * 0.229);
  width: 40rpx;
}

