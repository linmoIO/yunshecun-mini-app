@keyframes move-left {
  100% {
    transform: translateX(-135px);
  }
}

.max_carousel {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  transform: translateX(0);
}

.max_carousel image {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.video_box {
  width: 100%;
  height: auto;
  position: fixed;
  top: 0;
  bottom: 0;
}

.video_list {
  width: 100%;
  height: 100vh;
  position: relative;
}

.video_list video {
  position: absolute;
  top: 50%;
  margin-top: -30vw;
  width: 100%;
  height: 56vw;
  padding: 0;
}