page { background: #f7f4ee; color: #2b2a25; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.guide-page { height: 100vh; }
.guide-hero { height: 500rpx; position: relative; overflow: hidden; }
.guide-hero-image { width: 100%; height: 100%; display: block; }
.guide-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.62)); }
.guide-hero-copy { position: absolute; left: 40rpx; right: 40rpx; bottom: 42rpx; color: #fff; }
.guide-kicker { font-size: 23rpx; letter-spacing: 4rpx; }
.guide-title { margin-top: 12rpx; font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 50rpx; font-weight: 600; line-height: 1.25; }
.guide-subtitle { margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; opacity: .92; }
.guide-highlights { display: flex; margin: 28rpx 24rpx 44rpx; padding: 26rpx 0; background: #fff; border-radius: 10rpx; box-shadow: 0 6rpx 24rpx rgba(55,46,32,.07); }
.guide-highlight { flex: 1; padding: 0 20rpx; border-right: 1rpx solid #e6e0d7; }
.guide-highlight:last-child { border-right: 0; }
.guide-highlight-title { font-size: 30rpx; font-weight: 600; color: #6f5639; }
.guide-highlight-text { margin-top: 10rpx; font-size: 24rpx; line-height: 1.55; color: #6d675e; }
.guide-sections { margin: 0 32rpx 38rpx; }
.guide-section-title { margin-bottom: 14rpx; font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 36rpx; font-weight: 600; line-height: 1.4; }
.guide-section-body { padding: 22rpx 24rpx; background: #fff; border-left: 5rpx solid #b59b76; border-radius: 4rpx; }
.guide-item { font-size: 29rpx; line-height: 1.8; color: #4e4b44; }
.guide-dot { display: inline-block; width: 28rpx; color: #a17e52; font-size: 34rpx; vertical-align: -2rpx; }
.guide-note { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #ece7de; font-size: 26rpx; line-height: 1.7; color: #817768; }
.guide-schedule-title, .guide-original-title { margin: 52rpx 32rpx 16rpx; font-size: 36rpx; font-weight: 600; }
.guide-schedule { margin: 0 32rpx 26rpx; padding: 22rpx 24rpx; background: #ede8de; border-radius: 8rpx; }
.guide-period { font-size: 28rpx; font-weight: 600; color: #72563c; }
.guide-schedule-item { margin-top: 10rpx; font-size: 26rpx; line-height: 1.7; color: #555047; }
.guide-original-note { margin: 0 32rpx 20rpx; font-size: 25rpx; line-height: 1.65; color: #817a70; }
.guide-original-list { padding: 0 24rpx; }
.guide-original-image { display: block; width: 100%; margin-bottom: 22rpx; border-radius: 8rpx; box-shadow: 0 6rpx 22rpx rgba(55,46,32,.1); background: #fff; }
.guide-end { padding: 26rpx 0 180rpx; text-align: center; color: #a19a90; font-size: 22rpx; }
.guide-empty { padding-top: 360rpx; text-align: center; color: #8b877e; }
