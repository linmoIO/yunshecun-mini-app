/* pages/orderConfirm/orderConfirm.wxss */
scroll-view{
  height: 100vh;
}
.bg-color1{
  padding-bottom: 0;
}
.page-content{
  padding: 40rpx 40rpx 40rpx;
}
.page-list{
  border: 1px #b09d73 solid;
  padding: 20px;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.page-list-title{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-list-subtitles,
.page-list-subtitle{
  font-size: 36rpx;
  color: #000;
  font-weight: bold;
  text-align: left;
}

.page-list-orderstatus{
  color: #666;
}
.page-list-ordertime{
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #666;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.page-list-ordernum{
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #666;
}
.page-list-price{
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px #d3ccbd solid;
  margin-top: 40rpx;
  padding-top: 40rpx;
  color: #666;
}
.page-list-priceall{
  display: flex;
  align-items: center;
}
.page-list-priceall-num{
  font-size: 36rpx;
  color: #666;
}
.page-pay-name{
  font-size: 36rpx;
  text-align: center;
  font-weight: bold;
  color: #000;
  padding: 70rpx 0;
}
.page-pay-list{
  margin-bottom: 420rpx;
}
.page-pay-list-type{
  color: #5b5b5a;
}
.page-pay-list-wechat{
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px #dfd5bf solid;
  padding: 20rpx 25rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
}
.page-pay-list-wechat-icon {
  color: #5b5b5a;
  display: flex;
  align-items: center;
}
.page-pay-list-wechat-icon image{
  display: block;
  width: 61rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

.page-shopping{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 0 0;
}
.price-num{
  color: #977730;
  font-size: 48rpx;
  
}
.price-btn{
  width: 300rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  color: #fff;
  background-color: #b09d73;
  border-radius: 6rpx;
  text-align: center;
  letter-spacing: 3rpx;
}
.popup-box{
  position: fixed;
  z-index: 9999;
  top: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.5);
  width: 100vw;
  height: 100vh;
}
.row-info{
  width: 100%;
  padding: 40rpx;
}
.info-center{
  position: fixed;
  height:100vh;
  top: 0;
  left: 0;
  z-index: 999900;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  width: 100%;
}
.info-content{
  background-color: #F4EFE2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(90% - 80rpx);
  padding: 0 40rpx;
}
.info-close{
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: calc(30 / 708 * 100vw);
  color: #000;
  margin-bottom: 40rpx;
}
.info-close image{
  display: block;
  width: calc(30 / 708 * 100vw);
  height: calc(30 / 708 * 100vw);
}
.info-contents{
  font-size: 24rpx;
  color: #000;
  
}
.info-content-list{
  width: 100%;
  line-height: calc(35 / 708 * 100vw);
  font-size: calc(20 / 708 * 100vw);
}
.page-fangke{
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #000;
  font-size: 30rpx;
  font-weight: bold;
}
.page-fangke .page-fangke-btn{
  background: none;
  border: 0;
  padding: 0;
  color: #977730;
  font-size: 24rpx;
  border-bottom: 1px #977730 solid;
}
.page-pay-name-intro{
  margin-top: 20rpx;
  font-size: 24rpx;
}
.mt-30{
  margin-top: 30rpx;
}
.mt-60{
  margin-top: 60rpx;
}
.page-form input{
  display: block;
  height: 100rpx;
  border: 0;
  border-bottom: 1px #D3CCBD solid;
}
.page-add{
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-top: 40rpx;
}
.page-haiwai{
  color: #666;
  font-size: 24rpx;
  margin: 90rpx 0;
}
.page-jieshou{
  font-size: 36rpx;
  color: #000;
  margin-bottom: 40rpx;
}
.page-mobile input{
  display: block;
  height: 100rpx;
  border: 0;
  border-bottom: 1px #D3CCBD solid;
}
.page-tiaokuan{
  width: 100%;
  line-height: 1.7;
  
  display: flex;
  align-items: flex-start;
  margin-top: 40rpx;
  overflow: hidden;
}
.page-tiaokuan radio{
  background-color: #F0ECE0;
  border-color: #665952;
  margin-right: 15rpx;
}
.page-tiaokuan-text view{
  display: contents;
  color: #666;
  font-size: calc(20 / 708 * 100vw);
}
.page-tiaokuan-text view.page-notice{
  color: #977730;
  border-bottom: 1px #977730 solid;
  font-size: calc(20 / 708 * 100vw);
}
.page-tiaokuan-text {
  width: 100%;
  margin-bottom: 10rpx;
  font-size: calc(20 / 708 * 100vw);
}
.agree{
  font-size: calc(20 / 708 * 100vw);
}