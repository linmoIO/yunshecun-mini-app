.header {
  width: 100%;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  width: 100vw;
  z-index: -1;
}

.title_top {
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-family: '微软雅黑';
  color: #977730;

}

radio .wx-radio-input {
  background-color: #E5DECC !important;
  border: 1px solid #C9B0A2 !important;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

radio .wx-radio-input.wx-radio-input-checked {
  /* 边框颜色 */
  border-color: #C9B0A2 !important;
}

/* 选中后的实心样式*/
radio .wx-radio-input.wx-radio-input-checked::before {
  content: '';
  width: 21rpx;
  height: 21rpx;
  border-radius: 50%;
  background-color: #665952;
}

.form {
  padding: 30rpx;
  color: #515151;
  height: calc(100vh - 480rpx);
  overflow-y: scroll;
  /* box-sizing: border-box; */
}
.booking_instructions {
  width: 100%;
  height: 800rpx;
}

@media screen and (min-width:768px) {
  .booking_instructions {
    width: 100%;
    height: 400rpx;
  }
}

.room-name {
  line-height: 45rpx;
  font-size: 40rpx;
}

.line {
  background: rgba(0, 0, 0, 0.15);
}

.order-overview {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 127rpx;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.basic_information {
  width: 100%;
  display: flex;
  justify-content: space-between;
}

.time_2 {
  width: 50%;
}

.time {
  display: flex;
  width: 400rpx;
  justify-content: center;
  align-items: center;
  line-height: 45rpx;
  font-size: 40rpx;
}

.instructions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 115rpx;
  margin-bottom: 100rpx;
  padding-inline: 40rpx;
  border: 1px solid #515151;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #B9693E;
}

.form-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 0 8rpx 30rpx;
  border-bottom: 1rpx solid rgba(102, 89, 82, 0.15);
  font-size: 32rpx;
}

.form-item-label {
  line-height: 40rpx;
}

.form-item-hidden {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 0 8rpx 30rpx;
  border-bottom: 1rpx solid rgba(102, 89, 82, 0.15);
  font-size: 32rpx;
  opacity: 1;
}

.form-item-hidden.show{
  display: block;
  animation: slidein 1s;
  opacity: 1;
}

@keyframes slidein {
  from {
    transform: translateY(-10%);
  }
  to {
    transform: translateY(0%);
  }
}

.form-item7 {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 0 8rpx 20rpx;
  font-size: 32rpx;
}

.form-item2 {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx 20rpx 20rpx;
  border: 1rpx solid rgba(102, 89, 82, 0.15);
  font-size: 28rpx;
}

.user-info {
  text-align: left;
  letter-spacing: 4rpx;
  font-family: "Inter";
}

.user-phone-info {
  text-align: left;
}

.input {
  text-align: left;
  font-family: "微软雅黑";
}

.input.left-spacing{
  /* margin-left: 10rpx; */  
}

.input-placeholder {
  font-family: "微软雅黑";
  color: rgba(0, 0, 0, 0.30);
}

.price-info-item {
  display: flex;
  gap: 50rpx;
  margin-bottom: 40rpx;
  padding-left: 65rpx;
  padding-right: 48rpx;
  line-height: 45rpx;
  font-size: 28rpx;
}

.price-info-content {
  flex: 1;
  border-bottom: 1rpx solid #665952;
  text-align-last: justify;
}

.price-amount {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
  padding-right: 44rpx;
  line-height: 45rpx;
  font-size: 28rpx;
  color: #515151;
}

.submit {
  width: 100vw;
  height: 200rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0rpx 55rpx 30rpx 20rpx;
  box-sizing: border-box;
  position: fixed;
  bottom: 10rpx;
  background-color: #E5DECC;
}

.price-number {
  line-height: 53rpx;
  color: #515151;
  display: flex;
  flex-direction: column;
}

.submit-button {
  width: 290rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  text-align: center;
}

.popup-box {
  position: fixed;
  z-index: 999;
  top: 0;
  background-color: rgba(0, 0, 0, 0.5);
  width: 100vw;
  height: 100vh;
  bottom: -100rpx;
  overflow: hidden;
  left: 0;
}

/* 下 */
.info-bottom {
  position: fixed;
  z-index: 999;
  width: 100%;
  height: 80%;
  bottom: 0;
  background-color: #F4EFE2;
  left: 0;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
}

.row-info {
  font-size: 32rpx;
  margin-left: 10%;
  margin-right: 10%;
}

.row-term-info {
  display: flex;
  flex-direction: column;
  align-items: left;
  font-size: 32rpx;
  padding: 0 25rpx;
}

.line {
  height: 1rpx;
}

.left-line {
  background-image: linear-gradient(to left, orange, white);
}

.right-line {
  background-image: linear-gradient(to right, orange, white);
}

.row-author {
  font-size: 24rpx;
  color: 515151;
}

.row-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: fixed;
  bottom: 5rpx;
  width: 100%;
  background-color: #F4EFE2;
}

.row-btn view {
  width: 100%;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 10rpx;
  font-size: 46rpx;
  border-radius: 100rpx;
}

.left-btn {
  width: 90% !important;
  background-color: #DDD9C9;
  color: #515151;
  border-radius: 50%;
}

.fixed {
  position: fixed;
  bottom: 0;
  width: 50%;
}
.detail_box {
  width: 100%;
  background-color: #F4EFE2;
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
  position: fixed;
  padding-bottom: 30rpx;
  bottom: -50%;
  left: 0;
  z-index: 99999;
  transition: all 0.3s;
}
.detail_box2{
  bottom: -50%;
}
@keyframes slidein {
    from {
      transform: translateY(-10%);
    }
    to {
      transform: translateY(0%);
    }
  }
.haner_box {
  font-family: '微软雅黑 ';
  background-color: #F4EFE2;
  width: 100%;
  /* padding-top: 20rpx; */
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  position: relative;
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
  /* box-sizing: border-box; */
}

.table_content {
  width: 100%;
  background-color: #F4EFE2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.table_hander {
  width: 86%;
  border-bottom: 1rpx solid rgba(102, 89, 82, 0.15);
  font-size: 28rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  font-size: 25rpx;
}

.table_hander view{
 line-height: 35rpx;
}
.table_hander text:nth-child(2){
    margin-left:175rpx;
}

.table_hander text:nth-child(3){
    margin-left:170rpx;
}

.table_hander_title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 60rpx !important;
}

.table_hander2 {
  width: 90%;
  display: flex;
  justify-content: center;
  gap: 250rpx;
  padding-top: 30rpx;
  border-bottom: 1rpx solid rgba(102, 89, 82, 0.15);
  padding-bottom: 30rpx;
