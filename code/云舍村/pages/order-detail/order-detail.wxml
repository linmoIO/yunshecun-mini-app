                    入村日期：
                </view>
            </view>
            <view class="time_2" style="text-align: right;">
                <view style="font-size: 25rpx; line-height: 1;font-family: '微软雅黑';">
                    {{startMonth}}-{{startDay}}
                </view>
            </view>
        </view>
        <view class="basic_information" style="margin-top: 30rpx;"  wx:if="{{DomTop}}">
            <view class="time_2">
                <view style="font-size:25rpx; line-height: 1;font-family: '微软雅黑';">
                    离村日期：
                </view>
            </view>
            <view class="time_2" style="text-align: right;"  wx:if="{{DomTop}}">
                <view style="font-size: 25rpx; line-height: 1;font-family: '微软雅黑';">
                    {{endMonth}}-{{endDay}}
                </view>
            </view>
        </view>
        <view class="basic_information" style="margin-top: 30rpx; font-family: '微软雅黑';">
            <view class="time_2">
                <view style="font-size: 25rpx; line-height: 1;">
                    入住晚数:
                </view>
            </view>
            <view class="time_2" style="text-align: right;">
                <view style="font-size: 25rpx; line-height: 1;font-family: '微软雅黑';">
                    {{days}}晚
                </view>
            </view>
        </view>
        <view class="basic_information" style="margin-top: 30rpx;font-family: '微软雅黑';">
            <view class="time_2">
                <view style="font-size: 25rpx; line-height: 1;">
                    房型:
                </view>
            </view>
            <view class="time_2" style="text-align: right;">
                <view style="font-size: 25rpx; line-height: 1;">
                    {{roomName}}
                </view>
            </view>
        </view>
        <view class="basic_information" style="margin-top: 30rpx;font-family: '微软雅黑';">
            <view class="time_2">
                <view style="font-size:25rpx; line-height: 1;">
                    人数:
                </view>
            </view>
            <view class="time_2" style="text-align: right;">
                <view style="font-size: 25rpx; line-height: 1;">
                    {{adultNumber + childrenNumber}}人
                </view>
            </view>
        </view>
        <view class="basic_information" style="margin-top: 30rpx;font-family: '微软雅黑';">
            <view class="time_2">
                <view style="font-size: 25rpx; line-height: 1;">
                    客房:
                </view>
            </view>
            <view class="time_2" style="text-align: right;">
                <view style="font-size: 25rpx; line-height: 1;">
                    {{homeNumber}}间
                </view>
            </view>
        </view>
        <view style="height: 50rpx;">
        </view>
        <view wx:if="{{orderId}}" style="border-top: 1px solid rgba(102, 89, 82, 0.15);height: 50rpx;"></view>
        <!-- <view style="margin-bottom: 40rpx ;" wx:if="{{!orderId}}">
        <label style="display: flex; align-items: center; justify-content: flex-end;">
          <text style="color: #000;font-family: '微软雅黑'; font-size: 25rpx;">记住我的入住人信息</text>
