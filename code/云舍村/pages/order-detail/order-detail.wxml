        <view class="popup-box" wx:if="{{showIndex=='2'}}" bindtap="closePopup" catchtouchmove="emptyFunction"></view>
        <!-- 订单表单项 -->
        <form>
            <label wx:if="{{!orderId}}" class="form-item" style="font-family: '微软雅黑'; font-size: 25rpx;">
                <text class="form-item-label">入住人:</text>
                <view style="display: flex;">
                    <input class="input left-spacing" placeholder="请输入姓名" placeholder-class="input-placeholder" bindinput="handleInputUsername" />
                    <view style="position: relative; left: 29rpx; width: 120rpx;"></view>
                    <view style="position: relative; left: 29rpx; width: 150rpx;"></view>
                </view>
            </label>
            <label wx:else class="form-item7" style="font-family: '微软雅黑'; font-size: 25rpx;">
                <text>入住人:</text>
                <text class="user-info">{{username}}</text>
            </label>
            <label wx:if="{{!orderId}}" class="form-item" style="font-family: '微软雅黑'; font-size: 25rpx;">
                <text class="form-item-label">手机号:</text>
                <view style="display: flex;">
                    <input class="input left-spacing" placeholder="请输入手机号" placeholder-class="input-placeholder" bindinput="handleInputPhone" />
                    <view style="position: relative;left: 29rpx; width: 120rpx; "></view>
                    <view bindtap="{{sendmsg == 'Sendafter'?'':'sendmessg'}}" style="font-family: '微软雅黑'; position: relative; bottom: -1rpx;left: 29rpx; width: 150rpx; font-size:25rpx;color: #977730;">{{getmsg}}</view>
                </view>
            </label>
            <label wx:else class="form-item7" style="font-family: '微软雅黑'; font-size: 25rpx;">
                <text style="font-family: '微软雅黑';">手机号:</text>
                <text class="user-phone-info">{{phone}}</text>
            </label>
            <label wx:if="{{orderId}}" class="form-item" style="font-family: '微软雅黑'; font-size: 25rpx;">
                <text style="font-family: '微软雅黑';">备注:</text>
                <text class="user-info">{{remark}}</text>
            </label>
            <label class="form-item" wx:if="{{!orderId}}" style="font-family: '微软雅黑'; font-size: 25rpx;">
                <text class="form-item-label">验证码:</text>
                <view wx:if="{{!orderId}}" style="display: flex;">
                    <input class="input left-spacing" placeholder="请输入验证码 " placeholder-class="input-placeholder" bindinput="handleInputCode" />
                    <view style="position: relative; left: 29rpx; width: 120rpx;"></view>
                    <view style="position: relative; left: 29rpx; width: 150rpx;"></view>
                </view>
                <text wx:else class="user-info">{{remark}}</text>
            </label>
            <label wx:if="{{!orderId}}">
                <view style="position: relative;display: flex; align-items: center; z-index: 5;">
                    <!-- <text style="font-size : 40rpx;">+ </text> -->
                    <text style="width: 10rpx;"></text>
                    <text style="font-family: '微软雅黑'; font-size: 25rpx;padding-bottom:0rpx;">备注(可选)</text>
                </view>
                <label wx:if="{{expand_notes == true}}" class="remark_input form-item-hidden" style="position: relative;font-size: 25rpx; padding-top: 50rpx; z-index: 1;">
                    <input 
                    wx:if="{{!orderId}}" 
                    data-class="remark_input" 
                    bindkeyboardheightchange="bindKeyBoardHeightChange" 
                    adjust-position="{{false}}" 
                    placeholder="有特殊需求请在此备注" 
                    style="width: 100%; text-align: left;" 
                    bind:focus="onscrollTo" 
                    bind:blur="onscrollTo2" 
                    bindinput="handleInputnotes" />
                    <text wx:else class="user-info">{{remark}}</text>
                </label>
            </label>
        </form>
        <view style="height: 30rpx;" wx:if="{{!orderId}}">
        </view>
        <view style="margin-bottom: 40rpx ;" wx:if="{{!orderId}}">
            <label style="display: flex; align-items: center;">
                <radio class="agree-radio" checked="{{radio2}}" bind:tap="remember" />
                <view style="width: 5rpx;"></view>
                <text style="color: #000;font-family: '微软雅黑'; font-size: 24rpx;">我已阅读并同意<text style="color:#977730;" bind:tap="termPopup">云舍村入住条款及细则</text>，包括退款和取消政策。</text>
            </label>
            <text wx:if="{{policyWaring}}" style="color: #BD3535;font-family: '微软雅黑'; font-size: 24rpx;margin-left: 44rpx;position: relative; top: 6rpx;">请确认您已同意接受条款与细则。</text>
        </view>
        <view style="height: 30rpx;" wx:if="{{!orderId}}">
        </view>

        <view class="popup-box" wx:if="{{showIndex=='3'}}" bind:tap="closePopup" catchtouchmove="emptyFunction"></view>
        <view class="info-box-term" style=" font-family:'微软雅黑';" wx:if="{{showIndex=='3'}}">
            <view class="term-close-icon"  bind:tap="closePopup">
                <image style="width: 30rpx; height: 30rpx;" src="https://yunshecun.oss-cn-guangzhou.aliyuncs.com/dev/images/Vector.png"></image>
            </view>
            <scroll-view class="termInfo" scroll-y="true">
                <view class="row-term-info">
                    <view class="term-header">
                        <view class="term-title">
                            <text>云舍村入住条款及细则</text>
                        </view>
                    </view>
                    <view class="">
                        <view class="term-item">
                            <view class="term-item-title">预订</view>
                            <view class="term-item-content">
                                <view class="term-item-content-item">
                                    <view>1、</view>
                                    <view>仅提供入住天数少于31天的客房预订。同一入住时间段，每位宾客最多可预订3间客房。对于桃花源·云舍村推出的套餐或客房优惠，桃花源·云舍村有权根据相关法律拒绝或接受任何预订或任何参与套餐或优惠的宾客。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>2、</view>
                                    <view>预订时需全额支付相应的村落维护费用。村落维护费不包括超出套餐额度的餐饮费、服务费和其他花费。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>3、</view>
                                    <view>所有价格均以人民币计算。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>4、</view>
                                    <view>桃花源·云舍村保留权利根据市场情况不定时调动客房价格（但不影响已确认的预定下已支付的价格）和/或根据适用税率或其他政府收费的变更而收取额外费用。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>5、</view>
                                    <view>收到订单确认号即代表预订已确认。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>6、</view>
                                    <view>预订的客房和套餐产品内容仅限宾客个人使用，不得转让、转售或用于旅行团、企业活动、营销、推广或其他商业目的。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>7、</view>
                                    <view>若桃花源·云舍村出现失误（包括但不限于房价错误或客房类型错误，若预订已被确认则会与宾客友好协商），或宾客在预订客房时涉及欺诈或欺骗行为（无论预订确认与否），桃花源·云舍村保留取消或修改客房预订的权利。</view>
                                </view>
                            </view>
                        </view>
                        <view class="term-item">
                            <view class="term-item-title">取消与变更</view>
                            <view class="term-item-content">
                                <view class="term-item-content-item">
                                    <view>1、</view>
                                    <view>如需取消预定，须至少于入住日期00:00的48小时前提交申请，方能获全额退款。如于入住日期00:00前的48小时内取消预定，则将收取宾客预订时支付的首晚房费（包含服务费和税费）。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>2、</view>
                                    <view>入住日期00:00起不得申请取消预订，但若入住当日宾客未办理入住（即未按照预订日期入住酒店），则宾客的预订自动取消，且将收取宾客预订时支付的首晚房费（包含服务费和税费）。一旦办理入住，则预订无法再取消。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>3、</view>
                                    <view>预订变更，包括但不限于入住时长或客房类型变更，视变更时的供应情况而定，且宾客应支付因变更而产生的差价。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>4、</view>
                                    <view>入住和/或退房日期的变更需至少于入住日期00:00的48小时前进行，且视供应情况、预订优惠条款和市场价格而定。晚于上述时间则不得进行变更。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>5、</view>
                                    <view>酒店前台入住手续需由预定姓名的本人到场办理。已确认的预订不允许更改姓名。</view>
                                </view>
                            </view>
                        </view>
                        <view class="term-item">
                            <view class="term-item-title">入住与退房</view>
                            <view class="term-item-content">
                                <view class="term-item-content-item">
                                    <view>1、</view>
                                    <view>所有入住酒店的宾客（包括儿童）以及入住期间的访客均须持有有效个人身份证明原件（中国内地游客，须携带《中华人民共和国居民身份证》；中国香港、中国澳门地区游客，须携带《港澳居民来往内地通行证》、《中华人民共和国旅行证》或《中华人民共和国港澳居民居住证》；中国台湾地区游客，须携带《台湾居民来往大陆通行证》、《中华人民共和国旅行证》或《中华人民共和国台湾居民居住证》；其他国家及地区游客，须携带有效护照或《中华人民共和国外国人永久居留身份证》）进行登记。每个房间需至少有一位成人宾客入住。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>2、</view>
                                    <view>入住时间最早为当日09:00，退房时间最晚为当日15:00。申请推迟退房时间可能需要支付额外费用。入住高峰时段，入住可能会有所延迟。入住高峰期间，请尽早到村并办理入住手续。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>3、</view>
                                    <view>入住后提早退房将不会退还宾客任何费用，除非由桃花源·云舍村认定为特殊情况，可退还部分费用。</view>
                                </view>
                            </view>
                        </view>
                        <view class="term-item">
                            <view class="term-item-title">住宿</view>
                            <view class="term-item-content">
                                <view class="term-item-content-item">
                                    <view>1、</view>
                                    <view>住宿人数不得超过客房最大可入住人数。如仍有空房，可为额外宾客加订房间。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>2、</view>
                                    <view>相邻客房、相连客房或客房位置需要申请，且视入住时的供应情况而定。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>3、</view>
                                    <view>每间客房最多容纳1名17岁及以下儿童，和成人共用现有床铺。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>4、</view>
                                    <view>客房不提供加床服务，如果入住人数超过客房的可入住人数，则必须增订客房。</view>
                                </view>
                                <view class="term-item-content-item">
                                    <view>5、</view>
                                    <view>不得携带宠物入住。</view>
                                </view>
                            </view>
                        </view>
                        <view class="term-item">
                            <view class="term-item-title">其他</view>
                            <view class="term-item-content">
