                </view>
            </view>
        </view>
    </view>
</view>
<view class="form" scroll-y="true" model:scroll-top="{{myScrollTop}}">
    <view class="form-content">
        <view class="title_top" wx:if="{{DomTop}}">
            <view style="font-size:35rpx;font-family: '微软雅黑'; color: black;">预约详情</view>
            <view class="project" bind:tap="travel_project" wx:if="{{!orderId}}">
                <text>房型详情</text>
                <view style="width: 15rpx;"></view>
                <image style="width: 20rpx; height: 18rpx; " src="https://yunshecun.oss-cn-guangzhou.aliyuncs.com/applet/img/icon_bottom.png" />
            </view>
            <!-- <view style="font-size:30rpx">最多入住{{userNum}}人</view> -->
        </view>
        <view class="line" style="margin-bottom: 20rpx" wx:if="{{DomTop}}"></view>
