                    <view style="width: 17rpx;"></view><text>晚安宵夜</text>
                </view>
                <view class="drop project_content_text" style="margin-bottom: 50rpx;">
                    <text style="font-size: 30rpx;position: relative;bottom: 0rpx;">·</text>
                    <view style="width: 17rpx;"></view><text>云舍村的游历票</text>
                </view>
                <div class="project_content_title">游历票项目：</div>
                <view class="drop project_content_text" wx:for="{{travel_project_all}}" wx:key="index">
