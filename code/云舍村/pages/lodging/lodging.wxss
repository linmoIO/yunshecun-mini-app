.swiper_zi {
  height: 50rpx;
  width: 100%;
}

.swiper_zi .zimubox {
  height: 100%;
  width: 100%;
  display: flex;
  /*横向布局*/
}

.swiper_zi .zimubox .swiper_item {
  font-size: 26rpx;
  overflow: hidden;
  /*隐藏溢出*/
  text-overflow: ellipsis;
  /*显示省略符号来代表被修剪的文本*/
  white-space: nowrap;
  /*强制文字不换行*/
  color:  #7E7E7E;
  line-height: 50rpx;
  text-decoration:underline;
}

