scroll-view{
  padding-bottom: 200rpx;
  width: 100vw;
  height: 100vh;
}
.line_left_right {
  width: 40rpx;
  height: 0rpx;
  /* background-color: #797979; */
  border: 2rpx solid #79797985;
}
.line_left_left{
    width: 40rpx;
  height: 0rpx;
  /* background-color: #797979; */
  border: 2rpx solid #79797989;
}
.nav_top {
  width: 100%;
  height: 70rpx;
  position: absolute;
  top: 0;
  left: 0;
  background-color: #F0ECE0;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  box-sizing: border-box;
  justify-content: space-between;
  font-family: '微软雅黑';
  font-size: 20rpx;
}

.query_box {
  width: 95%;
  background-color: #FBF8EF;
  position: absolute;
  left: 20rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 50rpx;
  top: 30%;
  padding-bottom: 80rpx;
}

.entering_and_leaving {
  width: 100%;
  height: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 50rpx auto;
  gap:60rpx;
}

.wrapper {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow-x: hidden;
  overflow-y: scroll;
  color: #515151;
}

.wrapper .datePart {
  font-size: 40rpx;
}

.wrapper .datePart .picker {
  display: flex;
  align-items: center;
}

.datePart-day {
  font-size: 50rpx;
  font-weight: 700;
  color: #977730;
}

.datePart-yearMonth {
  font-size: 30rpx;
}

.datePart .datePart-text {
  margin-left: 20rpx;
  font-size: 25rpx;
}

.few_nights {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wrapper .leaveDate {
  top: 420rpx;
}

.wrapper .totalDays {
  width: 110rpx;
  height: 40rpx;
  font-size:22rpx;
  border: 2rpx solid #79797989;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999494;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  width: 100vw;
  height: 14rpx;
}

.bottomPart {
  width: 90%;
  display: flex;
  gap: 100rpx;
  justify-content: space-around;
  border-radius: 6px;
  border: 1px solid rgba(0, 0, 0, 0.10);
  line-height: 120rpx;
}

.search {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 90%;
  padding: 0 1px;
  height: 92rpx;
  font-size: 35rpx;
  color: #515151;
  background-color: #D9CDB3;
  border-radius: 15rpx;
  position: relative;
  top: 0rpx;
}

.bottomPart .search image {
  position: absolute;
  width: 100rpx;
  height: 242rpx;
  z-index: -1;
}

.number,
.home {
  display: flex
}

.number .quantity,
.home .quantity {
  text-align: center;
  width: 83rpx;
  font-size: 100rpx;
}

.number image,
.home image {
  position: absolute;
  width: 51rpx;
  height: 115rpx;
  z-index: -1;
}

.text {
  text-align: center;
  font-size: 26rpx;
}

.relative {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #000;
  font-weight: 400;
}
.relative-item-first {
  margin-left: 40rpx;
}
.relative-item-last {
  margin-right: 40rpx;
}

/* 蒙层 */
.popup-box {
  position: absolute;
  z-index: 99;
  top: 0;
  background-color: rgba(0, 0, 0, 0.5);
  width: 100%;
  height: 100%;
}

/* 上 */
.info-top {
  position: fixed;
  z-index: 999;
  width: 100%;
  top: 0;
  background-color: white;
  border-bottom-left-radius: 5rpx;
  border-bottom-right-radius: 5rpx;
}

/* 中 */
.info-center {
  position: fixed;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  width: 100%;
  margin-left: 5%;
  margin-right: 5%;
}

/* 下 */
.info-bottom {
  position: fixed;
  z-index: 999;
  width: 100%;
  bottom: 0;
  background-color: white;
  border-top-left-radius: 10rpx;
  border-top-right-radius: 10rpx;
}

/* 左 */
.info-left {
  position: fixed;
  z-index: 999;
  width: 50%;
  height: 100%;
  top: 0;
  background-color: white;
  border-top-right-radius: 10rpx;
  border-bottom-right-radius: 10rpx;
}

/* 右 */
.info-right {
  position: fixed;
  z-index: 999;
  width: 50%;
  height: 100%;
  right: 0;
  top: 0;
  background-color: white;
  border-top-left-radius: 10rpx;
  border-bottom-left-radius: 10rpx;
}

/* 自定义内容（根据自己需求更改,可删除） */
button {
  margin: 15rpx 0;
}

.row-info {
  width: 100%;
  height: 100%;
  /* display: flex;
  flex-direction: column;
  align-items: center; */
  margin: 15rpx;
  font-size: 32rpx;
}

.row-info view {
  padding: 10rpx 0;
}

.row-info view:first-child {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.line {
  width: 100rpx;
  height: 1rpx;
}

.left-line {
  background-image: linear-gradient(to left, orange, white);
}

.right-line {
  background-image: linear-gradient(to right, orange, white);
}

.row-author {
  font-size: 24rpx;
  color: gray;
}

.row-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx dashed #f1f1f1;
}

.row-btn view {
  flex: 1;
  text-align: center;
  margin: 20rpx 10%;
  padding: 12rpx 0;
  font-size: 32rpx;
  border-radius: 10rpx;
}

.left-btn {
  background-color: #F4EFE2 !important;
  color: #8F847A !important;
  font-size: 50rpx;
  position: absolute;
  top: 40rpx;
  right: 50rpx;
}
.left-btn image{
  width: 30rpx;
  height: 30rpx;
  padding: 20rpx;
}
.notification_title {
  position: absolute;
  width: 75%;
  top: 60rpx;
  left: 70rpx;
  font-size:35rpx;
  font-family: '微软雅黑';
}

.notification_content {
  width: 80%;
  font-size: 25rpx;
  font-family: '微软雅黑';
  position: absolute;
  top: 180rpx;
  left: 70rpx;
  line-height: 40rpx;
}

.notification_bottom {
  font-size: 25rpx;
  font-family: '微软雅黑';
  position: absolute;
  bottom: 100rpx;
  left: 70rpx;
  line-height: 40rpx;
}

