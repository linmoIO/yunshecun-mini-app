page { background: #f7f4ee; color: #292822; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.part-page { height: 100vh; padding-bottom: 140rpx; box-sizing: border-box; }
.part-hero { position: relative; height: 470rpx; overflow: hidden; }
.part-hero-image { width: 100%; height: 100%; display: block; }
.part-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.62)); }
.part-hero-copy { position: absolute; left: 40rpx; right: 40rpx; bottom: 42rpx; color: #fff; }
.part-hero-title { font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 50rpx; line-height: 1.25; font-weight: 600; }
.part-hero-summary { margin-top: 14rpx; font-size: 28rpx; line-height: 1.65; opacity: .94; }
.part-flow { padding: 44rpx 40rpx 22rpx; }
.part-paragraph { margin-bottom: 28rpx; font-size: 30rpx; line-height: 1.85; text-align: justify; color: #3f3c35; }
.part-visuals { padding: 12rpx 24rpx 0; }
.part-visual { margin-bottom: 30rpx; }
.part-page-image { display: block; width: 100%; border-radius: 6rpx; box-shadow: 0 6rpx 22rpx rgba(55,46,32,.1); background: #fff; }
.part-caption { padding: 16rpx 10rpx 0; font-size: 29rpx; line-height: 1.8; color: #686258; }
.part-empty { padding-top: 360rpx; text-align: center; color: #8b877e; }
