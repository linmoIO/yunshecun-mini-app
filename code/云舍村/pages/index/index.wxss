page {
  background: #f5f1e8;
  padding-top: 0 !important;
}

.home-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.home-scroll {
  height: 100vh;
  padding-top: 0;
  box-sizing: border-box;
}

.hero-block {
  position: relative;
  width: 100%;
}

.hero-swiper {
  height: 900rpx;
  overflow: hidden;
}

.hero-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.16) 58%, rgba(0, 0, 0, 0.14));
}

.hero-text {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 64rpx;
  color: #fff;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.4;
  opacity: 0.95;
}

.hero-link {
  margin-top: 16rpx;
  font-size: 22rpx;
  opacity: 0.95;
}

.search-area {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  top: calc(env(safe-area-inset-top) + 114rpx);
  z-index: 5;
}

.hero-search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-box {
  flex: 1;
  height: 76rpx;
  background: rgba(95, 95, 95, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  color: #fff;
  font-size: 24rpx;
  line-height: 76rpx;
}

.hotel-pill {
  height: 76rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: rgba(95, 95, 95, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  color: #fff;
  font-size: 26rpx;
  line-height: 76rpx;
  text-align: center;
  box-sizing: border-box;
}

.hotel-pill-active {
  background: rgba(255, 255, 255, 0.24);
}

.notice-row {
  margin: 24rpx;
  height: 84rpx;
  border-radius: 14rpx;
  background: #1e1f24;
  color: #fff;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.notice-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
}

.notice-text {
  flex: 1;
  font-size: 23rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  opacity: 0.92;
}

.notice-action {
  width: 132rpx;
  height: 50rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #171717;
  font-size: 22rpx;
  line-height: 50rpx;
  text-align: center;
}

.member-card {
  margin: 0 24rpx;
  border-radius: 18rpx;
  padding: 24rpx;
  background: linear-gradient(120deg, #efe6d5, #f9f5eb 55%, #e8ddcb);
  border: 1rpx solid #deceb4;
}

.member-title {
  font-size: 30rpx;
  color: #362f26;
  font-weight: 600;
}

.member-subtitle {
  margin-top: 10rpx;
  color: #73614f;
  font-size: 23rpx;
  line-height: 1.45;
}

.member-btn {
  margin-top: 16rpx;
  width: 180rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #af3f2f;
  color: #fff;
  text-align: center;
  line-height: 56rpx;
  font-size: 24rpx;
}

.section {
  margin: 30rpx 24rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #231f1a;
}

.section-link {
  font-size: 24rpx;
  color: #7b6a57;
}

.destination-tabs {
  white-space: nowrap;
}

.destination-tab-inner {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 10rpx;
}

.destination-tab {
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #ece6dc;
  color: #7f7060;
  font-size: 22rpx;
}

.destination-tab-active {
  background: #2f80bf;
  color: #fff;
}

.destination-grid {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.destination-card {
  position: relative;
  width: calc(50% - 7rpx);
  height: 210rpx;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.destination-image {
  width: 100%;
  height: 100%;
}

.destination-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.15) 60%);
}

.destination-info {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  color: #fff;
}

.destination-name {
  font-size: 28rpx;
  font-weight: 600;
}

.destination-subtitle {
  margin-top: 6rpx;
  font-size: 20rpx;
  opacity: 0.94;
}

.package-scroll {
  white-space: nowrap;
}

.package-inner {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.package-card {
  width: 520rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #fff;
}

.package-image {
  width: 100%;
  height: 260rpx;
}

.package-info {
  padding: 16rpx;
}

.package-title {
  font-size: 27rpx;
  color: #1f1b17;
  font-weight: 600;
  line-height: 1.4;
}

.package-summary {
  margin-top: 8rpx;
  color: #6f6255;
  font-size: 22rpx;
  line-height: 1.45;
}

.package-price {
  margin-top: 10rpx;
  color: #141414;
  font-size: 28rpx;
  font-weight: 600;
}

.feature-section .feature-card {
  border-radius: 14rpx;
  border: 1rpx solid #e0d4c1;
  background: #fff;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.feature-name {
  font-size: 26rpx;
  color: #222;
  font-weight: 600;
}

.feature-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #786958;
}

.bottom-safe-space {
  height: 200rpx;
}

.promo-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
}

.promo-card {
  width: 540rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  position: relative;
}

.promo-image {
  width: 100%;
  height: 520rpx;
}

.promo-content {
  padding: 20rpx 20rpx 24rpx;
}

.promo-title {
  color: #191919;
  font-size: 30rpx;
  font-weight: 600;
}

.promo-subtitle {
  margin-top: 10rpx;
  color: #716558;
  font-size: 22rpx;
  line-height: 1.4;
}

.promo-btn {
  margin-top: 16rpx;
  height: 64rpx;
  border-radius: 12rpx;
  line-height: 64rpx;
  text-align: center;
  color: #fff;
  font-size: 26rpx;
  background: #2f80bf;
}

.promo-close {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  right: 16rpx;
  top: 16rpx;
  color: #fff;
  font-size: 34rpx;
  background: rgba(0, 0, 0, 0.35);
}
