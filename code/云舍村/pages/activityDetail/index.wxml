<navigation-bar title="活动详情" back="{{true}}" color="#111111" background="#F3EFE6"></navigation-bar>

<view class="detail-page" wx:if="{{activity}}">
  <scroll-view scroll-y class="detail-scroll">
    <view class="hero-area">
      <swiper
        class="hero-swiper"
        indicator-dots="{{true}}"
        indicator-active-color="#ffffff"
        indicator-color="rgba(255,255,255,0.35)"
        circular="{{true}}"
        autoplay="{{true}}"
        interval="{{4200}}"
      >
        <swiper-item wx:for="{{activity.gallery}}" wx:key="*this">
          <image class="hero-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <view class="hero-mask"></view>
      <view class="hero-content">
        <view class="hero-tags">
          <text wx:for="{{activity.tags}}" wx:key="*this" class="hero-tag">{{item}}</text>
        </view>
        <view class="hero-title">{{activity.title}}</view>
        <view class="hero-sub">{{activity.shortDesc}}</view>
      </view>
    </view>

    <view class="panel">
      <view class="panel-title">行程与团期</view>
      <scroll-view scroll-x class="date-scroll">
        <view class="date-inner">
          <view
            wx:for="{{activity.scheduleDates}}"
            wx:key="date"
            class="date-item {{selectedDateIndex == index ? 'date-item-active' : ''}}"
            data-index="{{index}}"
            bindtap="selectDate"
          >
            <view class="date-week">{{item.weekday}}</view>
            <view class="date-value">{{item.date}}</view>
            <view class="date-price">¥{{item.price}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="panel">
      <scroll-view scroll-x class="info-tabs">
        <view class="info-tab-inner">
          <view
            wx:for="{{infoTabs}}"
            wx:key="key"
            class="info-tab {{activeInfoTab == item.key ? 'info-tab-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="switchInfoTab"
          >{{item.name}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{activeInfoTab == 'highlight'}}" class="tab-panel">
        <view wx:for="{{activity.highlights}}" wx:key="title" class="highlight-card">
          <image class="highlight-image" src="{{item.image}}" mode="aspectFill" />
          <view class="highlight-title">{{item.title}}</view>
          <view class="highlight-desc">{{item.description}}</view>
        </view>
      </view>

      <view wx:if="{{activeInfoTab == 'detail'}}" class="tab-panel">
        <view class="detail-text">{{activity.detail}}</view>
      </view>

      <view wx:if="{{activeInfoTab == 'notice'}}" class="tab-panel">
        <view wx:for="{{activity.notices}}" wx:key="*this" class="notice-item">{{index + 1}}. {{item}}</view>
      </view>

      <view wx:if="{{activeInfoTab == 'qa'}}" class="tab-panel">
        <view wx:for="{{activity.qa}}" wx:key="q" class="qa-item">
          <view class="qa-q">Q：{{item.q}}</view>
          <view class="qa-a">A：{{item.a}}</view>
        </view>
      </view>
    </view>

    <view class="panel">
      <view class="panel-title">目的地套餐</view>
      <view wx:for="{{activity.packages}}" wx:key="id" class="package-item {{selectedPackageIndex == index ? 'package-item-active' : ''}}" data-index="{{index}}" bindtap="selectPackage">
        <view class="package-main">
          <view class="package-name">{{item.name}}</view>
          <view class="package-summary">{{item.summary}}</view>
          <view class="package-days">{{item.nights}}晚{{item.days}}天</view>
        </view>
        <view class="package-price">¥{{item.price}} / 套起</view>
      </view>
    </view>

    <view class="back-top" bindtap="backTop">^</view>
    <view class="bottom-space"></view>
  </scroll-view>

  <view class="subscribe-bar">
    <view class="subscribe-copy">
      <view class="subscribe-title">{{activity.heroNotice || '订阅活动通知'}}</view>
      <view class="subscribe-desc">不错过任何价格变动和限时活动</view>
    </view>
    <view class="subscribe-btn" bindtap="subscribeNotice">立即订阅</view>
  </view>

  <view class="booking-bar">
    <view class="booking-price">¥{{activity.priceFrom}} / 套起</view>
    <view class="booking-btn" bindtap="openBookingSheet">预订</view>
  </view>

  <view wx:if="{{bookingSheetVisible}}" class="sheet-mask" catchtap="closeBookingSheet">
    <view class="booking-sheet" catchtap="noop">
      <view class="sheet-header">
        <view class="sheet-title">选择预订套数</view>
        <view class="sheet-close" bindtap="closeBookingSheet">x</view>
      </view>
      <view class="sheet-package-name">{{activity.packages[selectedPackageIndex].name}}</view>
      <view class="sheet-package-price">¥{{activity.packages[selectedPackageIndex].price}} / 套</view>
      <view class="count-row">
        <view class="count-label">套数</view>
        <view class="count-control">
          <view class="count-btn" bindtap="decreasePackageCount">-</view>
          <view class="count-value">{{packageCount}}</view>
          <view class="count-btn" bindtap="increasePackageCount">+</view>
        </view>
      </view>
      <view class="count-hint">每套可供2人使用，不支持与陌生人拼团。</view>
      <view class="sheet-submit" bindtap="nextStep">下一步</view>
    </view>
  </view>
</view>
