page {
  background: #f5f1e8;
}

.detail-page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.detail-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-top: 132rpx;
}

.hero-area {
  margin: 0 24rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
  height: 560rpx;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.18) 55%);
}

.hero-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  color: #fff;
}

.hero-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hero-tag {
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 999rpx;
  background: rgba(18, 18, 18, 0.46);
  font-size: 20rpx;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  opacity: 0.95;
}

.panel {
  margin: 18rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
}

.panel-title {
  font-size: 30rpx;
  color: #1f1c18;
  font-weight: 600;
}

.date-scroll {
  margin-top: 14rpx;
  white-space: nowrap;
}

.date-inner {
  display: inline-flex;
  gap: 12rpx;
}

.date-item {
  width: 150rpx;
  border-radius: 12rpx;
  padding: 12rpx;
  background: #f4efe6;
  color: #6f6153;
}

.date-item-active {
  background: #2f80bf;
  color: #fff;
}

.date-week {
  font-size: 20rpx;
}

.date-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.date-price {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.info-tabs {
  white-space: nowrap;
}

.info-tab-inner {
  display: inline-flex;
  gap: 12rpx;
}

.info-tab {
  min-width: 130rpx;
  text-align: center;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  background: #efe9de;
  color: #7d6c5a;
  font-size: 22rpx;
}

.info-tab-active {
  background: #151515;
  color: #fff;
}

.tab-panel {
  margin-top: 16rpx;
}

.highlight-card {
  border: 1rpx solid #ece2d3;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.highlight-image {
  width: 100%;
  height: 240rpx;
}

.highlight-title {
  margin: 12rpx 12rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e1b17;
}

.highlight-desc {
  margin: 8rpx 12rpx 12rpx;
  color: #6a5d4f;
  font-size: 22rpx;
  line-height: 1.45;
}

.detail-text {
  color: #3b332a;
  font-size: 23rpx;
  line-height: 1.6;
}

.notice-item {
  color: #3b332a;
  font-size: 23rpx;
  line-height: 1.55;
  margin-bottom: 10rpx;
}

.qa-item {
  border-bottom: 1rpx solid #f0e5d5;
  padding: 12rpx 0;
}

.qa-q {
  color: #202020;
  font-size: 23rpx;
  font-weight: 600;
}

.qa-a {
  margin-top: 8rpx;
  color: #6f6153;
  font-size: 22rpx;
  line-height: 1.5;
}

.package-item {
  border: 1rpx solid #e8dccb;
  border-radius: 12rpx;
  padding: 14rpx;
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.package-item-active {
  border-color: #2f80bf;
  background: #f0f7fd;
}

.package-main {
  flex: 1;
}

.package-name {
  font-size: 25rpx;
  color: #1f1a15;
  font-weight: 600;
}

.package-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f6153;
}

.package-days {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8f7d6a;
}

.package-price {
  color: #151515;
  font-size: 28rpx;
  font-weight: 600;
}

.back-top {
  position: fixed;
  right: 24rpx;
  bottom: 260rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.15);
  text-align: center;
  line-height: 66rpx;
  color: #454545;
}

.bottom-space {
  height: 260rpx;
}

.subscribe-bar {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 124rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: rgba(15, 16, 18, 0.93);
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  z-index: 90;
}

.subscribe-copy {
  flex: 1;
  color: #fff;
}

.subscribe-title {
  font-size: 22rpx;
  font-weight: 600;
}

.subscribe-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: 0.85;
}

.subscribe-btn {
  width: 136rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #171717;
  text-align: center;
  line-height: 52rpx;
  font-size: 21rpx;
}

.booking-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  background: #efe8dc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
  z-index: 95;
}

.booking-price {
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: 600;
}

.booking-btn {
  width: 200rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: #141414;
  color: #fff;
  text-align: center;
  line-height: 72rpx;
  font-size: 28rpx;
}

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.42);
  z-index: 160;
  display: flex;
  align-items: flex-end;
}

.booking-sheet {
  width: 100%;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #fff;
  padding: 22rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sheet-title {
  font-size: 30rpx;
  color: #1d1916;
  font-weight: 600;
}

.sheet-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  color: #333;
  font-size: 34rpx;
}

.sheet-package-name {
  margin-top: 14rpx;
  color: #1e1a16;
  font-size: 25rpx;
}

.sheet-package-price {
  margin-top: 8rpx;
  color: #151515;
  font-size: 30rpx;
  font-weight: 600;
}

.count-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.count-label {
  color: #2a2621;
  font-size: 24rpx;
}

.count-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.count-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid #d7ccbd;
  text-align: center;
  line-height: 44rpx;
  color: #202020;
  font-size: 28rpx;
}

.count-value {
  min-width: 34rpx;
  text-align: center;
  color: #202020;
  font-size: 24rpx;
}

.count-hint {
  margin-top: 14rpx;
  color: #8b7a68;
  font-size: 21rpx;
}

.sheet-submit {
  margin-top: 18rpx;
  height: 74rpx;
  border-radius: 12rpx;
  background: #111;
  color: #fff;
  text-align: center;
  line-height: 74rpx;
  font-size: 27rpx;
}
