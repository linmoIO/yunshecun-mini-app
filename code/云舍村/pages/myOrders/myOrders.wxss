.wrapper {
  background-color: #e6dfcb;
}

.order_Continuation {
  width: 100%;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
  background-color: #F0ECE0;
  user-select: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: '微软雅黑';
  color: #665952;
  flex-direction: column;
  gap: 100rpx;
}
.payment_or_cancellation{
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.payment_or_cancellation button{
  width: 80%;
}

.no-order {
  font-family: 'I.PenCrane-s'; 
  font-size: 40rpx; 
  width: 100%;
  height:65vh; 
  align-items: center;
  justify-content: center;
  display: none;
}

.no-order-show {
  display: flex; 
}