<scroll-view class="login-page" scroll-y>
  <!-- 标题 -->
  <view class="login-header">
    <text class="login-title">云舍村</text>
    <text class="login-subtitle">欢迎登录</text>
  </view>

  <!-- 协议复选框 -->
  <view class="login-agreement">
    <view class="checkbox {{agreeTerms?'checked':''}}" bindtap="toggleAgree"></view>
    <text class="agreement-text">我已阅读并同意</text>
    <text class="agreement-link">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link">《隐私政策》</text>
  </view>

  <!-- 一键登录 -->
  <view wx:if="{{loginMode==='wechat'}}">
    <button class="login-btn btn-wechat" bindtap="wechatLogin" disabled="{{loading}}">
      {{loading?'登录中...':'一键微信登录'}}
    </button>
    <view class="login-divider">或</view>
    <button class="login-link-btn" data-mode="phone" bindtap="switchLoginMode">
      用手机号登录
    </button>
  </view>

  <!-- 手机号登录 -->
  <view wx:if="{{loginMode==='phone'}}">
    <view class="form-group">
      <input class="form-input" placeholder="请输入手机号" type="number" value="{{phone}}" bindinput="onPhoneInput" maxlength="11"/>
    </view>

    <view class="form-group">
      <view class="form-row">
        <input class="form-input flex" placeholder="请输入验证码" type="number" value="{{code}}" bindinput="onCodeInput" maxlength="6"/>
        <button class="form-send-btn {{codeCountdown>0?'disabled':''}}" bindtap="getCaptcha" wx:if="{{codeCountdown===0}}">
          先获取图形验证码
        </button>
        <view class="form-send-btn disabled" wx:if="{{codeCountdown>0}}">
          {{codeCountdown}}s后重试
        </view>
      </view>
    </view>

    <button class="login-btn btn-phone" bindtap="phoneLogin" disabled="{{loading||codeCountdown>0}}">
      {{loading?'登录中...':'登录'}}
    </button>

    <button class="login-link-btn" data-mode="wechat" bindtap="switchLoginMode">
      返回一键登录
    </button>
  </view>

  <!-- 图形验证码弹层 -->
  <view class="captcha-modal-mask" wx:if="{{showCaptchaModal}}" bindtap="closeCaptchaModal"></view>
  <view class="captcha-modal" wx:if="{{showCaptchaModal}}">
    <view class="captcha-header">
      <text class="captcha-title">图形验证码</text>
      <text class="captcha-close" bindtap="closeCaptchaModal">✕</text>
    </view>
    <view class="captcha-image">
      <image src="{{captchaImage}}" mode="widthFix"></image>
    </view>
    <view class="form-group">
      <input class="form-input" placeholder="请输入验证码" value="{{captchaCode}}" bindinput="onCaptchaInput" maxlength="6"/>
    </view>
    <view class="captcha-actions">
      <button class="btn-outline" bindtap="getCaptcha">重新获取</button>
      <button class="btn-primary" bindtap="sendCode">确认并发送短信</button>
    </view>
  </view>
</scroll-view>
