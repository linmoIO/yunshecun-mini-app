page { background: linear-gradient(180deg, #D9CDB3 0%, #f5f5f5 100%); }
.login-page { height: 100vh; padding: 40rpx 32rpx; }
.login-header { text-align: center; margin-bottom: 60rpx; margin-top: 60rpx; }
.login-title { font-size: 48rpx; font-weight: 700; color: #1a1a2e; display: block; }
.login-subtitle { font-size: 28rpx; color: #888; margin-top: 12rpx; display: block; }

/* 协议复选框 */
.login-agreement { display: flex; align-items: center; gap: 8rpx; margin-bottom: 40rpx; font-size: 24rpx; color: #666; flex-wrap: wrap; }
.checkbox { width: 28rpx; height: 28rpx; border: 2rpx solid #ccc; border-radius: 4rpx; flex-shrink: 0; }
.checkbox.checked { background: #1a1a2e; border-color: #1a1a2e; color: #fff; display: flex; align-items: center; justify-content: center; }
.checkbox.checked::after { content: '✓'; font-size: 18rpx; }
.agreement-link { color: #1a1a2e; font-weight: 500; text-decoration: underline; }

/* 按钮 */
.login-btn { width: 100%; height: 88rpx; border-radius: 50rpx; font-size: 32rpx; font-weight: 600; border: none; margin-bottom: 20rpx; }
.btn-wechat { background: #1a1a2e; color: #fff; }
.btn-phone { background: #D9CDB3; color: #1a1a2e; }
.login-link-btn { width: 100%; height: 60rpx; background: transparent; border: 1.5rpx solid #ccc; border-radius: 30rpx; font-size: 26rpx; color: #666; margin-top: 20rpx; }
.login-divider { text-align: center; color: #ccc; margin: 40rpx 0; font-size: 26rpx; }

/* 表单 */
.form-group { margin-bottom: 24rpx; }
.form-row { display: flex; gap: 12rpx; }
.form-input { width: 100%; height: 80rpx; border: 1.5rpx solid #ddd; border-radius: 10rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; background: #fff; }
.form-input.flex { flex: 1; }
.form-send-btn { width: 180rpx; height: 80rpx; background: #1a1a2e; color: #fff; border: none; border-radius: 10rpx; font-size: 24rpx; font-weight: 500; padding: 0; }
.form-send-btn.disabled { background: #ccc; }

/* 图形验证码弹层 */
.captcha-modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 100; }
.captcha-modal { position: fixed; left: 32rpx; right: 32rpx; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 40rpx 32rpx; z-index: 101; }
.captcha-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.captcha-title { font-size: 32rpx; font-weight: 700; color: #333; }
.captcha-close { font-size: 36rpx; color: #ccc; }
.captcha-image { margin-bottom: 24rpx; }
.captcha-image image { width: 100%; border: 1.5rpx solid #f0f0f0; border-radius: 10rpx; }
.captcha-actions { display: flex; gap: 12rpx; }
.btn-outline { flex: 1; height: 80rpx; background: #f5f5f5; border: 1.5rpx solid #ddd; border-radius: 10rpx; font-size: 28rpx; color: #666; }
.btn-primary { flex: 1; height: 80rpx; background: #1a1a2e; border: none; border-radius: 10rpx; font-size: 28rpx; color: #fff; font-weight: 600; }
