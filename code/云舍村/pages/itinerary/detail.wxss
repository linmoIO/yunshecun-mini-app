page { background: #f7f4ee; color: #302e29; }
.it-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.it-hero { position: relative; height: 560rpx; overflow: hidden; }
.it-cover { display: block; width: 100%; height: 100%; background: #ece5d9; }
.it-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.66)); }
.it-heading { position: absolute; left: 40rpx; right: 40rpx; bottom: 40rpx; color: #fff; }
.it-meta { font-size: 25rpx; opacity: .9; }
.it-title { margin-top: 10rpx; font-size: 46rpx; font-weight: 600; line-height: 1.3; }
.it-tags { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.it-tag { margin: 0 12rpx 10rpx 0; padding: 4rpx 16rpx; border: 1rpx solid rgba(255,255,255,.7); border-radius: 4rpx; font-size: 22rpx; }

.it-day { margin: 32rpx 32rpx 0; padding: 36rpx 32rpx 20rpx; background: #fff; border-radius: 12rpx; }
.it-day-title { font-size: 38rpx; font-weight: 600; color: #59472f; }
.it-day-sub { margin-top: 8rpx; font-size: 25rpx; color: #8a7559; }
.it-section { position: relative; display: flex; padding: 26rpx 0 6rpx; }
.it-dot { flex: 0 0 14rpx; height: 14rpx; margin: 14rpx 22rpx 0 0; border-radius: 50%; background: #9b7950; }
.it-section-body { flex: 1; min-width: 0; }
.it-label { font-size: 30rpx; font-weight: 600; line-height: 1.5; color: #2b261f; }
.it-item { margin-top: 12rpx; }
.it-item-name { font-size: 28rpx; line-height: 1.6; color: #4c4840; }
.it-item-desc { margin-top: 4rpx; font-size: 25rpx; line-height: 1.7; color: #817b71; }

.it-notice { margin: 32rpx 40rpx 0; font-size: 24rpx; line-height: 1.7; color: #817b71; }
.it-empty { padding-top: 360rpx; text-align: center; font-size: 28rpx; color: #817b71; }

.it-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #f7f4ee; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05); }
.it-btn { flex: 1; height: 88rpx; border-radius: 4rpx; font-size: 30rpx; line-height: 88rpx; text-align: center; }
.it-btn + .it-btn { margin-left: 20rpx; }
.it-btn-line { border: 1rpx solid #756044; color: #59472f; }
.it-btn-fill { background: #59472f; color: #fff; }
