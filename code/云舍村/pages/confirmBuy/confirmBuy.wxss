/* pages/confirmBuy/confirmBuy.wxss */
scroll-view{
  height: 100vh;
}
.page-content{
  padding: 40rpx 40rpx 0;
}
.page-list{
  border: 1px #b09d73 solid;
  padding: 20px;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.page-list-title{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-list-subtitles,
.page-list-subtitle{
  font-size: 36rpx;
  color: #000;
  font-weight: bold;
  text-align: left;
}

.page-list-orderstatus{
  color: #666;
}
.page-list-ordertime{
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #666;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.page-list-ordernum{
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #666;
}
.page-list-price{
  border-top: 1px #d3ccbd solid;
  margin-top: 40rpx;
  padding-top: 40rpx;
  color: #666;
}
.page-list-priceall{
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-list-priceall-num{
  font-size: 36rpx;
  color: #666;
}
.page-pay-name{
  font-size: 36rpx;
  text-align: center;
  font-weight: bold;
  color: #b09d73;
  padding: 70rpx 0 0;
}
.page-pay-name-intro{
  font-size: 24rpx;
  color: #666;
  text-align: center;
  margin-top: 15rpx;
  margin-bottom: 70rpx;
}
.page-pay-list{
  margin-bottom: 90rpx;
}
.page-pay-list-type{
  color: #5b5b5a;
}
.page-pay-list-wechat{
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px #dfd5bf solid;
  padding: 20rpx 25rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
}
.page-pay-list-wechat-icon {
  color: #5b5b5a;
  display: flex;
  align-items: center;
}
.page-pay-list-wechat-icon image{
  display: block;
  width: 61rpx;
  height: 50rpx;
  margin-right: 20rpx;
}
.now-pay{
  background: #d9cdb3;
  display: block;
  border: 1px #d9cdb3 solid;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #6d6058;
  border-radius: 10rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.old-pay{
  display: block;
  border: 1px #a8a59d solid;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #665952;
  border-radius: 10rpx;
  text-align: center;
}

.page-pay-intro{
  color: #515151;
  font-size: 24rpx;
  margin-top: 40rpx;
  padding-bottom: 200rpx;
}