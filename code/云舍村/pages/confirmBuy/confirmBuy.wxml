<!-- pages/payOrder/payOrder.wxml -->
<navigation-bar title="订单详情" back="{{true}}" color="black" background="#D9CDB3"></navigation-bar>
<view class="bg-color1">
  <scroll-view type="list" scroll-y>
    <view class="page-content">
      <view class="page-list" style="background-color: #e7dfc7;">
        <view class="page-list-title">
          <view class="page-list-subtitle">订单详情</view>
          <view class="page-list-orderstatus"></view>
        </view>
        <view class="page-list-ordertime">
          <text>游历日期</text>
          <text>{{formData.date}}</text>
        </view>
        <view class="page-list-subtitles">游历票</view>
        <view class="page-list-ordernum" wx:if="{{item.count > 0}}" wx:for="{{formData.priceList}}" wx:key="">
          <text>{{item.name}}</text>
          <text>X{{item.count}}</text>
        </view>
        <view class="page-list-price">
          <view class="page-list-priceall">
            <view class="page-list-priceall-text">总计：</view>
            <view class="page-list-priceall-num">￥ {{formData.totalAmount}}</view>
          </view>
        </view>
      </view>
      <view class="page-pay-name">等待您的支付</view>
      <view class="page-pay-name-intro">如果您已经付款，我们可能需要几分钟来处理您的购买。</view>
      <view class="page-pay-list">
        <text class="page-pay-list-type">支付方式</text>
        <view class="page-pay-list-wechat">
          <view class="page-pay-list-wechat-icon">
            <image src="/pages/images/aks3h-7ivnr.png" mode="" />
            <text>微信支付</text>
          </view>
          <radio checked="true" color="#665952" value="" />
        </view>
      </view>
      <view class="now-pay" bind:tap="toPay">立即支付</view>
      <navigator url="/pages/orderList/orderList" class="old-pay" target="self" hover-class="navigator-hover" open-type="redirect">
        已经支付
      </navigator>
      <view class="page-pay-intro">
        <view>请在30分钟内付款。未完成支付的订单将在30分钟后被自动取消。</view>
        <view>取消后，请重新添加商品。</view>
      </view>
    </view>
  </scroll-view>
</view>