<navigation-bar title="全部产品" back="{{true}}" color="#111111" background="#F3EFE6"></navigation-bar>

<view class="activity-page">
  <scroll-view scroll-y class="activity-scroll">
    <view class="search-block">
      <view class="search-input-wrapper">
        <input
          class="search-input"
          placeholder="搜索目的地 / 套餐 / 关键词"
          value="{{keyword}}"
          bindinput="bindKeywordInput"
          confirm-type="search"
          bindconfirm="submitKeyword"
        />
        <view class="search-action" bindtap="submitKeyword">搜索</view>
      </view>
      <view wx:if="{{keyword}}" class="clear-keyword" bindtap="clearKeyword">清空筛选</view>
    </view>

    <scroll-view scroll-x class="route-tabs">
      <view class="route-tab-inner">
        <view
          wx:for="{{routeTabs}}"
          wx:key="key"
          class="route-tab {{activeRouteKey == item.key ? 'route-tab-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchRoute"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view class="gallery-header">
      <view class="gallery-title">在地体验</view>
      <view class="gallery-link" bindtap="openHotel">查看酒店 ></view>
    </view>
    <swiper
      class="gallery-swiper"
      indicator-dots="{{true}}"
      indicator-active-color="#ffffff"
      indicator-color="rgba(255,255,255,0.4)"
      circular="{{true}}"
      autoplay="{{true}}"
      interval="{{4200}}"
      duration="{{500}}"
      bindchange="onGalleryChange"
    >
      <swiper-item wx:for="{{galleryItems}}" wx:key="id">
        <view class="gallery-card" data-id="{{item.id}}" bindtap="openActivityDetail">
          <image class="gallery-image" src="{{item.cover}}" mode="aspectFill" />
          <view class="gallery-mask"></view>
          <view class="gallery-content">
            <view class="gallery-tags">
              <text wx:for="{{item.tags}}" wx:key="*this" class="gallery-tag">{{item}}</text>
            </view>
            <view class="gallery-name">{{item.title}}</view>
            <view class="gallery-desc">{{item.shortDesc}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="activity-grid">
      <view
        wx:for="{{filteredActivities}}"
        wx:key="id"
        class="activity-card"
        data-id="{{item.id}}"
        bindtap="openActivityDetail"
      >
        <image class="activity-image" src="{{item.cover}}" mode="aspectFill" />
        <view class="activity-info">
          <view class="activity-name">{{item.title}}</view>
          <view class="activity-meta">{{item.destination}} · {{item.days}}</view>
          <view class="activity-desc">{{item.shortDesc}}</view>
          <view class="activity-footer">
            <view class="activity-price">¥{{item.priceFrom}} / 套起</view>
            <view class="activity-cta">查看详情</view>
          </view>
        </view>
      </view>

      <view wx:if="{{!filteredActivities.length}}" class="empty">
        暂无匹配活动，请调整筛选条件
      </view>
    </view>

    <view class="bottom-safe-space"></view>
  </scroll-view>
  <bottom-tab selected="{{1}}"></bottom-tab>
</view>
