<!--pages/orderList/orderList.wxml-->
<navigation-bar title="门票订单" back="{{true}}" color="black" background="#D9CDB3"></navigation-bar>
<view class="bg-color1">
  <view class='topTabSwiper'>
        <view class='tab  {{currentData == 0 ? "tabBorer" : ""}}' data-current="0" data-status="" bindtap='checkCurrent'>全部</view>
        <view class='tab  {{currentData == 1 ? "tabBorer" : ""}}' data-current="1" data-status="0" bindtap='checkCurrent'>待支付</view>
        <view class='tab  {{currentData == 2 ? "tabBorer" : ""}}' data-current="2" data-status="10" bindtap='checkCurrent'>已取消</view>
      </view>
  <view>
    <view class="page-content">
      <view class='swiper_con'>
            <!-- 0-已提交，待支付，1-支付完成，已预订，10-取消支付，取消订单，2-申请退款，3-已核销，30-已过期 -->
            <view class="page-list" wx:for="{{list}}" wx:key="index" style=" background-color:{{item.orderStatus == 30 ? '#e5e5e5;' : '#e7dfc7;'}} " bind:tap="toDetail" data-id="{{item.orderId}}">
              <view class="page-list-title">
                <view class="page-list-subtitle">订单详情</view>
                <view wx:if="{{item.orderStatus == 0}}" class="page-list-orderstatus">待支付</view>
                <view wx:elif="{{item.orderStatus == 1}}" class="page-list-orderstatus">已预订</view>
                <view wx:elif="{{item.orderStatus == 10}}" class="page-list-orderstatus">取消订单</view>
                <view wx:elif="{{item.orderStatus == 2}}" class="page-list-orderstatus">申请退款</view>
                <view wx:elif="{{item.orderStatus == 3}}" class="page-list-orderstatus">已核销</view>
                <view wx:else="{{item.orderStatus == 30}}" class="page-list-orderstatus">已过期</view>
              </view>
              <view class="page-list-ordertime">
                <text>订单日期</text>
                <text>{{item.orderTime}}</text>
              </view>
              <view class="page-list-subtitles">游历票</view>
              <view class="page-list-ordernum">
                <text>游历日期</text>
                <text>{{item.ticketDate}}</text>
              </view>
              <view wx:for="{{item.ticketDataList}}" wx:for-item="v" wx:key="i" class="page-list-ordernum">
                <text>{{v.name}}</text>
                <text>X{{v.num}}</text>
              </view>
              <view class="page-list-price">
                <view class="page-list-priceall">
                  <view class="page-list-priceall-text">
                    总计：
                  </view>
                  <view class="page-list-priceall-num">
                    ￥ {{item.orderAmount}}
                  </view>
                </view>
                <navigator wx:if="{{item.orderStatus == 0}}" url="/pages/toBePaid/toBePaid?id={{item.orderId}}" class="price-btn" target="self" hover-class="navigator-hover" data-id='{{index}}' bindtap='getTime' open-type="redirect">
                  继续支付 {{insertTime[index] == null ? "" : insertTime[index]}}
                </navigator>
              </view>
            </view>

