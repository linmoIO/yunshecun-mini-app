/* pages/toBePaid/toBePaid.wxss */
scroll-view{
  height: 100vh;
}
.page-content{
  padding: 80rpx 40rpx;
}
.page-time0{
  color: #b09d73;
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.page-time10{
  color: #000;
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}
.page-intro{
  color: #666;
  font-size: 24rpx;
  text-align: center;
}
.page-rqcode{
  display: block;
  width: 200rpx;
  height: 200rpx;
  margin: 40rpx auto;
}

.page-order-title{
  margin-top: 80rpx;
  font-size: 36rpx;
  color: #000;
  margin-bottom: 20rpx;
}
.page-order-text,
.page-order-detail-list{
  color: #666;
  line-height: 1.8;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-order-price{
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px #d3ccbd solid;
  border-bottom: 1px #d3ccbd solid;
  padding: 40rpx 0;
  margin: 40rpx 0;
  color: #666;
}
.page-order-detail{
  margin-bottom: 150rpx;
}
.now-pay{
  background: #d9cdb3;
  display: block;
  border: 1px #d9cdb3 solid;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #6d6058;
  border-radius: 10rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.old-pay{
  display: block;
  border: 1px #a8a59d solid;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #665952;
  border-radius: 10rpx;
  text-align: center;
  margin-bottom: 60rpx;
}
