<view class="culture-page">
  <coustom-head title="什么是云舍村" color="#000000" bgColor="#ffffff" nativeMode="{{true}}"></coustom-head>

  <view class="paper">
    <image wx:if="{{heroImage}}" class="hero-image" src="{{heroImage}}" mode="aspectFill" />

    <view class="section">
      <view class="section-title">{{title}}</view>
      <view class="section-text" wx:for="{{paragraphs}}" wx:key="*this">{{item}}</view>
    </view>

    <image wx:if="{{contentImage}}" class="content-image" src="{{contentImage}}" mode="aspectFill" />

    <view class="section" wx:if="{{gallery.length}}">
      <view class="section-title">村落画卷</view>
      <view class="gallery">
        <image wx:for="{{gallery}}" wx:key="*this" class="gallery-image" src="{{item}}" mode="aspectFill" />
      </view>
    </view>

    <view class="section contact-section">
      <view class="section-title">到访咨询</view>
      <view class="section-text">{{address}}</view>
      <view class="red-btn" bindtap="makePhoneCall">电话咨询 {{phone}}</view>
    </view>
  </view>

  <float-button-kf></float-button-kf>
  <bottom-nav></bottom-nav>
</view>
