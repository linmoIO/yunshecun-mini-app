page {
  background: #ececec;
}

.culture-page {
  background: #ececec;
  min-height: 100vh;
}

.paper {
  padding: 0 0 120rpx;
  background: #f4f4f1;
}

.hero-image {
  width: 100%;
  height: 420rpx;
}

.section {
  padding: 44rpx 56rpx 24rpx;
}

.section-title {
  text-align: center;
  font-size: 54rpx;
  font-weight: 600;
  color: #101010;
}

.section-text {
  margin-top: 30rpx;
  font-size: 34rpx;
  line-height: 1.75;
  color: #1a1a1a;
}

.map-image {
  width: 100%;
  height: 620rpx;
  margin-top: 12rpx;
}

.btn-list {
  padding: 52rpx 0 20rpx;
}

.red-btn {
  width: 430rpx;
  height: 92rpx;
  margin: 0 auto 32rpx;
  background: #a6372b;
  color: #ffffff;
  font-size: 42rpx;
  text-align: center;
  line-height: 92rpx;
}

.content-image {
  width: 100%;
  height: 510rpx;
  margin-top: 20rpx;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 32rpx;
}

.gallery-image {
  width: 100%;
  height: 250rpx;
  background: #e6e1d6;
}

.qrcode-group {
  padding: 56rpx 0 12rpx;
}

.qrcode-item {
  margin-bottom: 62rpx;
}

.qrcode-img {
  width: 220rpx;
  height: 220rpx;
  display: block;
  margin: 0 auto;
  border: 1rpx solid #cdcdcd;
  border-radius: 8rpx;
}

.qrcode-text {
  margin-top: 20rpx;
  text-align: center;
  color: #474747;
  font-size: 34rpx;
  line-height: 1.45;
  padding: 0 70rpx;
}
