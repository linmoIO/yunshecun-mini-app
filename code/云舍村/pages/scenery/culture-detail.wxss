page {
  background: #f7f4ee;
  color: #302e29;
}

.culture-page {
  background: #f7f4ee;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.paper {
  padding: 0 0 120rpx;
  background: #f7f4ee;
}

.hero-image {
  width: 100%;
  height: 500rpx;
}

.section {
  padding: 44rpx 40rpx 20rpx;
}

.section-title {
  font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #302e29;
}

.section-text {
  margin-top: 26rpx;
  font-size: 30rpx;
  line-height: 1.85;
  text-align: justify;
  color: #48443d;
}

.map-image {
  width: 100%;
  height: 620rpx;
  margin-top: 12rpx;
}

.btn-list {
  padding: 52rpx 0 20rpx;
}

.red-btn {
  height: 88rpx;
  margin: 36rpx 0 24rpx;
  background: #6f5639;
  color: #ffffff;
  border-radius: 4rpx;
  font-size: 29rpx;
  text-align: center;
  line-height: 88rpx;
}

.content-image {
  width: 100%;
  height: 500rpx;
  margin-top: 24rpx;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 32rpx;
}

.gallery-image {
  width: 100%;
  height: 250rpx;
  background: #e6e1d6;
  border-radius: 4rpx;
}

.qrcode-group {
  padding: 56rpx 0 12rpx;
}

.qrcode-item {
  margin-bottom: 62rpx;
}

.qrcode-img {
  width: 220rpx;
  height: 220rpx;
  display: block;
  margin: 0 auto;
  border: 1rpx solid #cdcdcd;
  border-radius: 8rpx;
}

.qrcode-text {
  margin-top: 20rpx;
  text-align: center;
  color: #474747;
  font-size: 34rpx;
  line-height: 1.45;
  padding: 0 70rpx;
}

.section-text { font-size: 30rpx; line-height: 1.85; }
