.bg-color1{
  padding-bottom: 0;
}
.banner{
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}
.banner swiper{
  display: block;
  width: 100%;
  height: 100%;
}

.slide-image {
  display: block;
  width: 100%;
  height: 100%;
}
.page-content{
  padding: 20rpx 40rpx 40rpx;
}
.page-notice{
  
  color: #000;
font-family: "HarmonyOS Sans SC";
font-size: calc(20 / 709 * 100vw);
font-style: normal;
font-weight: 400;
line-height: calc(28 / 709 * 100vw); /* 140% */
}
.page-ticket-num{
  margin-top: 40rpx;
  color: #000;
  font-size: calc(34 / 709 * 100vw);
  font-style: normal;
  font-weight: 500;
  line-height: 151.884%; /* 51.64px */
  padding-bottom: 40rpx;
  border-bottom: 1rpx #d3ccbd solid;
  margin-bottom: 40rpx;
}
.page-ticket-date{
  margin-bottom: 35rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-ticket-list{
  padding: 35rpx;
  background: #f0ece0;
  border: 1px #b09d73 solid;
  border-radius: 30rpx;
  margin-bottom: 15rpx;
}
.page-ticket-list-hover{
  background-color: #e7dfc7;
}
.page-ticket-list-title{
  display: block;
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}
.page-ticket-list-text{
  color: #666;
  display: block;
}
.page-ticket-list-content{
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-ticket-list-content-price{
  font-size: 34rpx;
  color: #666;
}
.page-ticket-list-content-num{
  display: flex;
  align-items: center;
  justify-content: center;
}
.page-ticket-list-content-num input{
  display: block;
  width: 100rpx;
  line-height: 60rpx;
  border: 0;
  text-align: center;
}
.page-ticket-list-content-num button{
  flex:0 0 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  color: #fff;
  background-color: #bbbbbb;
  border-radius: 6rpx;
  padding-bottom: 10rpx;
  text-align: center;
}
/* .page-ticket-list-content-num button.dec{
  background-color: #b09d73;
} */
.picker{
  color: #977730;
}

.page-shopping{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0 0;
}
.price-num{
  color: #977730;
  font-size: 48rpx;
  
}
.price-btn{
  width: 300rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  color: #fff;
  background-color: #b09d73;
  border-radius: 6rpx;
  text-align: center;
  letter-spacing: 3rpx;
}