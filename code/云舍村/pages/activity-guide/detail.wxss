page { background: #f7f4ee; color: #302e29; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.activity-page { height: 100vh; padding-bottom: 140rpx; box-sizing: border-box; }
.activity-hero { position: relative; height: 620rpx; overflow: hidden; }
.activity-image { display: block; width: 100%; height: 100%; }
.activity-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.04), rgba(0,0,0,.66)); }
.activity-heading { position: absolute; left: 40rpx; right: 40rpx; bottom: 48rpx; color: #fff; }
.activity-group { font-size: 25rpx; line-height: 1.5; opacity: .9; }
.activity-title { margin-top: 10rpx; font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 50rpx; line-height: 1.25; font-weight: 600; }
.activity-content { padding: 44rpx 40rpx 100rpx; }
.content-title { margin-bottom: 24rpx; font-family: "STKaiti", "KaiTi", "FZKai-Z03", "PingFang SC", sans-serif; font-size: 38rpx; font-weight: 600; line-height: 1.4; }
.activity-detail { display: flex; margin-bottom: 18rpx; font-size: 30rpx; line-height: 1.75; color: #4c4840; }
.activity-dot { flex: 0 0 28rpx; color: #9b7950; font-size: 36rpx; }
.guide-link { height: 88rpx; margin-top: 46rpx; border: 1rpx solid #756044; border-radius: 4rpx; color: #59472f; font-size: 29rpx; line-height: 88rpx; text-align: center; }
.activity-empty { padding-top: 360rpx; text-align: center; font-size: 28rpx; color: #817b71; }
