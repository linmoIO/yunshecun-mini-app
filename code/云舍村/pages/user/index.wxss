/* pages/user/index.wxss */
scroll-view{
  height: 100vh;
}
.page-content{
  padding: 0;
}
.page-icon{
  background-color: #d9d9d9;
  height: 350rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  
  text-align: center;
}
.page-icon image{
  display: block;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
}
.page-icon-name{
  font-size: 32rpx;
  color: #000;
  margin-top: 20rpx;
}

.page-order{
  width: 80%;
  margin: 80rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-order-list{
  flex: 0 0 50%;
  text-align: center;
}
.rpage-order-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 20rpx 0;
}

.rpage-order-btn image{
  display: block;
  width: 70rpx;
  height: 70rpx;
  
}
.page-order-name{
  font-size: 24rpx;
  color: #0f0f0e;
  margin-top: 20rpx;
}

.page-name{
  justify-content: space-between;
  color: #000;
  font-size: 30rpx;
  font-weight: bold;
  width: 80%;
  margin: 80rpx auto 0;
}
.page-mobile input{
  display: block;
  height: 100rpx;
  border: 0;
  border-bottom: 1px #D3CCBD solid;
}
.price-btn{
  width: 300rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  color: #fff;
  background-color: #b09d73;
  border-radius: 6rpx;
  text-align: center;
  letter-spacing: 3rpx;
  margin: 30rpx auto;
}
