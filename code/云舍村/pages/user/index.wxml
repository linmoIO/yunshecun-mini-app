<!--pages/user/index.wxml-->
<navigation-bar title="我的订单" back="{{true}}" color="black" background="#D9CDB3"></navigation-bar>
<view class="bg-color1">
  <scroll-view type="list" scroll-y>
    <view class="page-content">
      <view class="page-icon">
        <image src="/pages/images/avatar.png" mode=""/>
        <text class="page-icon-name">微信用户</text>
      </view>
      <view class="page-order">
        <view class="page-order-list">
          <navigator url="/pages/myOrders/myOrders" class="rpage-order-btn" target="self" hover-class="navigator-hover" open-type="navigate">
            <image src="/pages/images/cottage.png" mode=""/>
            <text class="page-order-name">村舍订单</text>
          </navigator>
        </view>
        <view class="page-order-list">
          <navigator url="/pages/orderList/orderList" class="rpage-order-btn" target="self" hover-class="navigator-hover" open-type="navigate">
            <image src="/pages/images/ticket.png" mode=""/>
            <text class="page-order-name">门票订单</text>
          </navigator>
        </view>

      </view>

      <view class="page-order" wx:if="{{userInfo.isManage == 1}}">
        <view class="page-order-list">
          <navigator url="/pages/scan-code/scan-code" class="rpage-order-btn" target="self" hover-class="navigator-hover" open-type="navigate">
            <image src="/pages/images/ticket.png" mode=""/>
            <text class="page-order-name">去核销</text>
          </navigator>
        </view>
      </view>

      <view wx:if="{{recommend == 1 && userInfo.isManage != 1}}" class="page-name mt-60">
        <view class="page-order-fkname">
          申请成为核销人员
        </view>
        <view class="page-mobile">
          <input type="text" placeholder="姓名" bindinput="bindname" value="{{name}}" />
        </view>
        <view class="price-btn" bind:tap="toManage">
          提交
        </view>

      </view>
    </view>
  </scroll-view>
  <bottom-tab selected='2'></bottom-tab>
</view>
