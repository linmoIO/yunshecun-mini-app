<view class="page">
  <view class="hero">
    <image class="hero-bg" mode="aspectFill" src="{{cover}}"></image>
    <view class="hero-mask"></view>
    <view class="top-nav">
      <view class="back" bindtap="onBack">‹</view>
      <view class="capsule"></view>
    </view>
    <view class="hero-title">{{title}}</view>
    <view class="hero-sub">{{subTitle}}</view>
  </view>

  <view class="content">
    <view class="section-title">出行建议</view>
    <view wx:for="{{tips}}" wx:key="title" class="tip-card">
      <view class="tip-title">{{item.title}}</view>
      <view class="tip-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="bottom-fixed">
    <view class="btn" bindtap="onCreatePlan">创建行程计划</view>
  </view>
</view>
