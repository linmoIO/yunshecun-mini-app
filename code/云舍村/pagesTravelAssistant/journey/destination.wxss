page {
  background: #f3f3f3;
}

.page {
  min-height: 100vh;
  background: #f3f3f3;
}

.top-nav {
  padding: 92rpx 32rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back {
  width: 56rpx;
  height: 56rpx;
  color: #111;
  font-size: 56rpx;
  line-height: 52rpx;
}

.capsule {
  width: 172rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f0f0f0;
  border: 1rpx solid #e5e5e5;
}

.page-title {
  margin: 42rpx 32rpx 26rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #111;
}

.route-scroll {
  white-space: nowrap;
  padding-left: 32rpx;
}

.route-row {
  display: inline-flex;
  gap: 18rpx;
  padding-right: 32rpx;
}

.route-card {
  width: 330rpx;
  height: 190rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.route-bg {
  width: 100%;
  height: 100%;
}

.route-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 20, 20, 0.15), rgba(20, 20, 20, 0.58));
}

.route-card.active .route-mask {
  background: linear-gradient(180deg, rgba(133, 33, 26, 0.58), rgba(133, 33, 26, 0.88));
}

.route-name {
  position: absolute;
  left: 16rpx;
  top: 18rpx;
  color: #fff;
  font-size: 50rpx;
  font-weight: 600;
}

.route-desc {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 20rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 34rpx;
  line-height: 42rpx;
}

.route-arrow {
  position: absolute;
  left: 146rpx;
  bottom: -10rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #85211a;
}

.list {
  margin: 18rpx 24rpx 0;
}

.item-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-image {
  width: 170rpx;
  height: 132rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.item-main {
  flex: 1;
}

.item-title {
  color: #111;
  font-size: 50rpx;
  font-weight: 600;
}

.item-desc {
  margin-top: 12rpx;
  font-size: 36rpx;
  line-height: 46rpx;
  color: #8c8c8c;
}

.radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #bbb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio.checked {
  border-color: #9d2f24;
}

.dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #b3352a;
}

.bottom-space {
  height: 236rpx;
}

.bottom-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f7f7f7;
  padding: 18rpx 24rpx 34rpx;
  box-shadow: 0 -4rpx 22rpx rgba(0, 0, 0, 0.04);
}

.selected-label {
  color: #777;
  font-size: 34rpx;
}

.selected-scroll {
  margin-top: 12rpx;
  white-space: nowrap;
}

.selected-row {
  display: inline-flex;
  gap: 16rpx;
}

.chip {
  height: 62rpx;
  border: 1rpx solid #ccc;
  border-radius: 10rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  color: #383838;
  font-size: 34rpx;
}

.chip-close {
  margin-left: 10rpx;
  color: #9f9f9f;
}

.submit-btn {
  margin-top: 16rpx;
  height: 94rpx;
  border-radius: 10rpx;
  background: #101010;
  color: #fff;
  font-size: 44rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
