page {
  background: #efefef;
}

.page {
  background: #efefef;
  min-height: 100vh;
}

.hero {
  height: 360rpx;
  position: relative;
  overflow: hidden;
}

.hero-bg {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(18, 77, 124, 0.85) 0%, rgba(18, 77, 124, 0.45) 48%, rgba(18, 77, 124, 0.12) 100%);
}

.hero-nav {
  position: absolute;
  top: 88rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
  text-align: center;
  line-height: 58rpx;
  font-size: 52rpx;
}

.capsule {
  width: 172rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
}

.hero-content {
  position: absolute;
  left: 32rpx;
  bottom: 42rpx;
  right: 32rpx;
}

.hero-title {
  color: #fff;
  font-size: 60rpx;
  font-weight: 600;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 34rpx;
  line-height: 48rpx;
}

.section {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}

.form-section {
  margin-top: -42rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.form-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e3e3e3;
  min-height: 96rpx;
}

.form-row:last-child {
  border-bottom: none;
}

.label {
  width: 150rpx;
  color: #161616;
  font-size: 38rpx;
}

.input {
  flex: 1;
  font-size: 38rpx;
  color: #222;
}

.date-wrap {
  display: flex;
  align-items: center;
  font-size: 38rpx;
  color: #111;
}

.split {
  margin: 0 12rpx;
  color: #777;
}

.tip {
  margin: 28rpx 28rpx 10rpx;
  color: #9a9a9a;
  font-size: 34rpx;
  line-height: 46rpx;
}

.section-title {
  font-size: 48rpx;
  color: #151515;
  font-weight: 600;
}

.group-title {
  margin-top: 26rpx;
  color: #1b1b1b;
  font-size: 42rpx;
}

.tag-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.tag-item {
  min-width: 156rpx;
  height: 74rpx;
  border-radius: 12rpx;
  border: 1rpx solid #c9c9c9;
  color: #212121;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}

.tag-item.active {
  border-color: #9d2f24;
  background: #a6372b;
  color: #fff;
}

.more-title {
  margin-top: 34rpx;
}

.remark {
  margin-top: 16rpx;
  width: 100%;
  height: 124rpx;
  border-radius: 14rpx;
  background: #fff;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 34rpx;
  color: #222;
}

.people-row {
  min-height: 94rpx;
  border-bottom: 1rpx solid #e3e3e3;
  display: flex;
  align-items: center;
}

.people-row.no-border {
  border-bottom: none;
}

.person-name {
  width: 154rpx;
  font-size: 42rpx;
  color: #111;
}

.person-tip {
  flex: 1;
  font-size: 34rpx;
  color: #b1b1b1;
}

.counter {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.op {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #d0d0d0;
  color: #c6c6c6;
  border-radius: 50%;
  text-align: center;
  line-height: 54rpx;
  font-size: 36rpx;
}

.op.active {
  color: #222;
  border-color: #7a7a7a;
}

.num {
  width: 44rpx;
  text-align: center;
  font-size: 48rpx;
  color: #222;
}

.city-row {
  min-height: 96rpx;
  border-top: 1rpx solid #e3e3e3;
  display: flex;
  align-items: center;
}

.city-label {
  width: 150rpx;
  color: #131313;
  font-size: 42rpx;
}

.city-value {
  flex: 1;
  text-align: right;
  color: #535353;
  font-size: 40rpx;
}

.bottom-space {
  height: 180rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f3f3f3;
  padding: 20rpx 24rpx 44rpx;
  display: flex;
  gap: 24rpx;
  z-index: 99;
}

.btn {
  flex: 1;
  height: 98rpx;
  border-radius: 12rpx;
  font-size: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn.ghost {
  background: #fff;
  border: 2rpx solid #111;
  color: #111;
}

.btn.primary {
  background: #101010;
  color: #fff;
}
