page,
.page {
  width: 100%;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100vh;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 12;
}

.top-nav {
  padding: 92rpx 32rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #121212;
  font-size: 56rpx;
  line-height: 52rpx;
  text-align: center;
}

.capsule {
  width: 172rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.85);
}

.tab-scroll {
  margin-top: 28rpx;
  white-space: nowrap;
  padding-left: 24rpx;
}

.tab-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.tab {
  width: 158rpx;
  height: 78rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #111;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab.active {
  background: #111;
  color: #fff;
}
