page {
  background: #f5f5f5;
}

.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.top-nav {
  padding: 92rpx 32rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back {
  width: 56rpx;
  height: 56rpx;
  color: #111;
  font-size: 56rpx;
  line-height: 52rpx;
}

.capsule {
  width: 172rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f0f0f0;
  border: 1rpx solid #e5e5e5;
}

.title {
  margin: 36rpx 32rpx 0;
  color: #111;
  font-size: 72rpx;
  font-weight: 700;
}

.sub {
  margin: 12rpx 32rpx 0;
  color: #8b8b8b;
  font-size: 34rpx;
}

.list {
  margin: 24rpx 24rpx 0;
}

.card {
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 420rpx;
}

.info {
  padding: 22rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #fff;
  background: #2f6840;
  display: flex;
  align-items: center;
}

.name {
  margin-top: 16rpx;
  color: #111;
  font-size: 50rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.sub-name {
  margin-top: 10rpx;
  color: #303030;
  font-size: 38rpx;
}

.desc {
  margin-top: 14rpx;
  color: #777;
  font-size: 34rpx;
  line-height: 48rpx;
}

.bottom-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #111;
  font-size: 50rpx;
  font-weight: 600;
}

.detail-btn {
  width: 190rpx;
  height: 74rpx;
  border: 2rpx solid #111;
  border-radius: 10rpx;
  color: #111;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-space {
  height: 176rpx;
}

.bottom-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx 34rpx;
  background: #f5f5f5;
}

.skip-btn {
  height: 96rpx;
  border-radius: 10rpx;
  background: #101010;
  color: #fff;
  font-size: 46rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
