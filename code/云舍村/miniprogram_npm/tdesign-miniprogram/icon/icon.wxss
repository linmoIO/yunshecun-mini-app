@import '../common/style/index.wxss';
.t-icon--image{width:100%;height:100%}
.t-icon__image{vertical-align:top;width:100%;height:100%}
.t-icon-base,.t-icon{display:block;text-align:center;line-height:1;font-style:normal}
.t-icon-close:before{content:'x'}
.t-icon-close-circle:before{content:'x'}
.t-icon-loading:before{content:'...'}
.t-icon-chevron-left:before{content:'<'}
.t-icon-chevron-right:before{content:'>'}
.t-icon-chevron-up:before{content:'^'}
.t-icon-chevron-down:before{content:'v'}
.t-icon-add:before{content:'+'}
.t-icon-check:before{content:'✓'}
