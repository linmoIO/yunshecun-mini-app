.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* padding-bottom: env(safe-area-inset-bottom); */
  padding-bottom: 15rpx;
  font-size: 24rpx;
  color: #665952;
  font-family: auto;
  height: 150rpx;
  z-index: 9999;
  background-size: 100% 100%;
  background-color: #D9CDB3;
}

.tab-bar-item {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  width: 230rpx;
  padding-bottom: 30rpx;
}

.tab-bar-item image {
  transform: scale(0.8);
}

.tabbarBg {
  position: absolute;
  z-index: -1;
  width: 100%;
}

.img0 {
  max-width: 53rpx;
  max-height: 50rpx;
  width: 53rpx;
  height: 50rpx;
}

.img1 {
  /* width: 74rpx; */
  height: 45rpx;
  max-width: 74rpx;
}

.img2 {
  /* width: 50rpx; */
  height: 50rpx;
  width: 50rpx;
}