generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id               Int                @id @default(autoincrement())
  memberId         String             @unique @default(cuid())
  memberToken      String?            @unique @db.VarChar(512)
  phone            String?            @unique
  email            String?
  wechatOpenId     String?            @unique
  nickname         String?
  avatar           String?
  realName         String?
  gender           Int?
  birthday         String?
  cardNo           String?            @unique
  cardLevel        String?            @default("普通会员")
  points           Int                @default(0)
  balance          Float              @default(0)
  status           Int                @default(1)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  travelOrders     TravelOrder[]
  hotelOrders      HotelOrder[]
  shopOrders       ShopOrder[]
  activityOrders   ActivityOrder[]
  addresses        ShippingAddress[]
  memberCoupons    MemberCoupon[]
  invoices         MemberInvoice[]
  guests           Guest[]
  pointTx          PointTransaction[]
  collections      GoodsCollection[]
  beneficiaries    Beneficiary[]      @relation("MemberBeneficiaries")
  beneficiaryOf    Beneficiary[]      @relation("BeneficiaryMember")
}

model TravelProduct {
  id            Int           @id @default(autoincrement())
  productCode   String        @unique @default(cuid())
  title         String
  subtitle      String?
  description   String?
  price         Float
  originalPrice Float?
  coverImage    String?
  images        String?       @db.Text
  videoUrl      String?
  videoThumb    String?
  videoLinkType String?       @default("upload")
  status        Int           @default(1)
  category      String?
  destination   String?
  duration      Int?
  minPersons    Int?
  maxPersons    Int?
  tags          String?       @db.Text
  itinerary     String?       @db.Text
  includes      String?       @db.Text
  excludes      String?       @db.Text
  notes         String?       @db.Text
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        TravelOrder[]
}

model Hotel {
  id           Int            @id @default(autoincrement())
  hotelCode    String         @unique
  hotelGroupCode String       @default("YUNSHECUN")
  name         String
  address      String?
  city         String?
  province     String?
  phone        String?
  description  String?
  coverImage   String?
  images       String?       @db.Text
  videoUrl     String?
  videoThumb   String?
  videoLinkType String?       @default("upload")
  latitude     Float?
  longitude    Float?
  starLevel    Int?
  facilities   String?       @db.Text
  checkInTime  String?
  checkOutTime String?
  status       Int            @default(1)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  roomTypes    RoomType[]
  orders       HotelOrder[]
  services     HotelService[]
}

model RoomType {
  id            Int          @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel        @relation(fields: [hotelId], references: [id])
  roomCode      String
  name          String
  description   String?
  price         Float
  originalPrice Float?
  area          Float?
  bedType       String?
  capacity      Int?
  images        String?      @db.Text
  amenities     String?      @db.Text
  stock         Int          @default(10)  // 余量/库存
  status        Int          @default(1)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        HotelOrder[]
}

model TravelOrder {
  id            Int            @id @default(autoincrement())
  orderNo       String         @unique @default(cuid())
  memberId      Int
  member        Member         @relation(fields: [memberId], references: [id])
  productId     Int?
  product       TravelProduct? @relation(fields: [productId], references: [id])
  status        String         @default("pending")
  totalAmount   Float
  paidAmount    Float?
  discount      Float?
  pointDed       Int?           @default(0)
  pointMoney     Float?         @default(0)
  pointEarned    Int?           @default(0)
  startDate     String?
  endDate       String?
  persons       Int?
  guestInfo     String?
  contactName   String?
  contactPhone  String?
  notes         String?
  cancelReason  String?
  paymentMethod String?
  paymentTime   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model HotelOrder {
  id            Int        @id @default(autoincrement())
  orderNo       String     @unique @default(cuid())
  memberId      Int
  member        Member     @relation(fields: [memberId], references: [id])
  hotelId       Int?
  hotel         Hotel?     @relation(fields: [hotelId], references: [id])
  roomTypeId    Int?
  roomType      RoomType?  @relation(fields: [roomTypeId], references: [id])
  status        String     @default("pending")
  checkIn       String?
  checkOut      String?
  nights        Int?
  rooms         Int?
  totalAmount   Float
  paidAmount    Float?
  pointDed       Int?       @default(0)
  pointMoney     Float?     @default(0)
  pointEarned    Int?       @default(0)
  guestName     String?
  guestPhone    String?
  notes         String?
  paymentMethod String?
  paymentTime   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model ShopProduct {
  id            Int             @id @default(autoincrement())
  productCode   String          @unique @default(cuid())
  name          String
  description   String?
  price         Float
  originalPrice Float?
  stock         Int             @default(0)
  coverImage    String?
  images        String?          @db.Text
  category      String?
  status        Int             @default(1)
  sortOrder     Int             @default(0)
  skuInfo       String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orderItems    ShopOrderItem[]
  collections   GoodsCollection[]
}

model ShopOrder {
  id            Int             @id @default(autoincrement())
  orderNo       String          @unique @default(cuid())
  memberId      Int
  member        Member          @relation(fields: [memberId], references: [id])
  status        String          @default("pending")
  totalAmount   Float
  paidAmount    Float?
  discount      Float?
  pointDed       Int?            @default(0)
  pointMoney     Float?          @default(0)
  pointEarned    Int?            @default(0)
  shippingFee   Float?
  addressId     Int?
  paymentMethod String?
  paymentTime   DateTime?
  trackingNo    String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         ShopOrderItem[]
}

model ShopOrderItem {
  id          Int          @id @default(autoincrement())
  orderId     Int
  order       ShopOrder    @relation(fields: [orderId], references: [id])
  productId   Int?
  product     ShopProduct? @relation(fields: [productId], references: [id])
  productName String
  price       Float
  quantity    Int
  skuInfo     String?
  createdAt   DateTime     @default(now())
}

model Activity {
  id            Int             @id @default(autoincrement())
  activityCode  String          @unique @default(cuid())
  title         String
  description   String?
  price         Float
  originalPrice Float?
  coverImage    String?
  images        String?          @db.Text
  videoUrl      String?
  videoThumb    String?
  videoLinkType String?         @default("upload")
  location      String?
  startDate     String?
  endDate       String?
  status        Int             @default(1)
  maxPersons    Int?
  category      String?
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        ActivityOrder[]
}

model ActivityOrder {
  id            Int       @id @default(autoincrement())
  orderNo       String    @unique @default(cuid())
  memberId      Int
  member        Member    @relation(fields: [memberId], references: [id])
  activityId    Int?
  activity      Activity? @relation(fields: [activityId], references: [id])
  status        String    @default("pending")
  quantity      Int?
  totalAmount   Float
  paidAmount    Float?
  pointDed       Int?      @default(0)
  pointMoney     Float?    @default(0)
  pointEarned    Int?      @default(0)
  contactName   String?
  contactPhone  String?
  activityDate  String?
  notes         String?
  paymentMethod String?
  paymentTime   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HotelService {
  id          Int            @id @default(autoincrement())
  hotelId     Int?
  hotel       Hotel?         @relation(fields: [hotelId], references: [id])
  serviceCode String         @unique @default(cuid())
  name        String
  description String?
  icon        String?
  type        String?
  price       Float?
  status      Int            @default(1)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      ServiceOrder[]
}

model ServiceOrder {
  id          Int           @id @default(autoincrement())
  orderNo     String        @unique @default(cuid())
  memberId    Int?
  serviceId   Int?
  service     HotelService? @relation(fields: [serviceId], references: [id])
  hotelCode   String?
  roomNo      String?
  status      String        @default("pending")
  details     String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Coupon {
  id             Int            @id @default(autoincrement())
  couponCode     String         @unique @default(cuid())
  name           String
  description    String?
  type           String?
  discountAmount Float?
  discountRate   Float?
  minAmount      Float?
  maxDiscount    Float?
  startDate      DateTime?
  endDate        DateTime?
  totalCount     Int?
  usedCount      Int            @default(0)
  status         Int            @default(1)
  applicableTo   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  memberCoupons  MemberCoupon[]
}

model MemberCoupon {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  couponNo  String   @unique @default(cuid())
  status    Int      @default(0)
  usedAt    DateTime?
  orderId   String?
  createdAt DateTime @default(now())
}

model PointTransaction {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      Member   @relation(fields: [memberId], references: [id])
  points      Int
  type        String?
  description String?
  orderId     String?
  createdAt   DateTime @default(now())
}

model ShippingAddress {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  name      String
  phone     String
  province  String?
  city      String?
  district  String?
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id          Int      @id @default(autoincrement())
  memberId    Int?
  member      Member?  @relation(fields: [memberId], references: [id])
  name        String
  phone       String?
  email       String?
  idType      String?
  idNumber    String?
  birthday    String?
  gender      Int?
  nationality String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MemberInvoice {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      Member   @relation(fields: [memberId], references: [id])
  type        String?
  title       String?
  taxNo       String?
  phone       String?
  email       String?
  bankName    String?
  bankAccount String?
  address     String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GoodsCollection {
  id        Int          @id @default(autoincrement())
  memberId  Int
  member    Member       @relation(fields: [memberId], references: [id])
  productId Int?
  product   ShopProduct? @relation(fields: [productId], references: [id])
  createdAt DateTime     @default(now())
}

model Beneficiary {
  id         Int      @id @default(autoincrement())
  memberId   Int
  member     Member   @relation("MemberBeneficiaries", fields: [memberId], references: [id])
  targetId   Int
  target     Member   @relation("BeneficiaryMember", fields: [targetId], references: [id])
  status     Int      @default(1)
  createdAt  DateTime @default(now())
}

model Payment {
  id              Int      @id @default(autoincrement())
  paymentNo       String   @unique @default(cuid())
  orderNo         String   // 普通字符串，不做外键约束（一条支付记录只属于一种订单类型）
  orderType       String?  // 'travel'|'hotel'|'shop'|'activity'
  memberId        Int?
  amount          Float
  originalAmount  Float?    @default(0)
  pointDed        Int?      @default(0)
  pointMoney      Float?    @default(0)
  pointEarned     Int?      @default(0)
  method          String?
  status          String   @default("pending")
  transactionId   String?
  paidAt          DateTime?
  refundedAt      DateTime?
  refundAmount    Float?
  extra           String?   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Banner {
  id        Int       @id @default(autoincrement())
  title     String?
  imageUrl  String
  linkUrl   String?
  linkType  String?
  position  String?
  sortOrder Int       @default(0)
  status    Int       @default(1)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MediaFile {
  id           Int      @id @default(autoincrement())
  name         String?
  originalName String?
  type         String?
  mimeType     String?
  url          String
  thumbnailUrl String?
  size         Int?
  width        Int?
  height       Int?
  duration     Float?
  category     String?
  tags         String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContentPage {
  id        Int      @id @default(autoincrement())
  pageCode  String   @unique
  title     String?
  content   String?  @db.LongText
  type      String?
  status    Int      @default(1)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SysConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?  @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  role        String    @default("admin")
  name        String?
  email       String?
  status      Int       @default(1)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model VerifyCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// 员工账号（超级管理员可管理）
model Staff {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  name        String
  email       String?
  phone       String?
  role        String    @default("staff")   // staff | manager
  permissions String?                       // JSON 数组，如 ["travel","hotel","shop"]
  status      Int       @default(1)         // 1启用 0禁用
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 客服会话与消息（n对1，每个用户独立会话）
model ChatConversation {
  id           Int           @id @default(autoincrement())
  memberId     String        @unique  // 每个用户最多一个活跃会话
  memberName   String?
  avatar       String?
  status       String        @default("open")
  lastMessage  String?
  unreadAdmin  Int           @default(0)
  unreadMember Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  content        String
  fromAdmin      Boolean          @default(false)
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
}

// DIY 定制行程需求（前端提交，后台管理）
model DiyTripRequest {
  id           Int      @id @default(autoincrement())
  memberId     String?
  nickname     String?
  phone        String
  name         String?
  destinations String?
  startDate    String?
  duration     String?
  persons      String?
  budget       String?
  requirements String?
  status       String   @default("new") // new|processing|done
  adminNote    String?  // 后台备注
  responsePlan String?  // 后台反馈的行程方案（富文本）
  responseImages String? // 后台反馈图片JSON数组
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 开票申请
model InvoiceRequest {
  id          Int      @id @default(autoincrement())
  memberId    Int
  orderNos    String   // JSON数组，关联的订单号
  invoiceType String   @default("personal") // personal|company
  title       String   // 发票抬头
  taxNo       String?  // 税号
  email       String?  // 接收邮箱
  phone       String?
  amount      Float    @default(0)
  status      String   @default("pending") // pending|processing|done|rejected
  rejectReason String?
  invoiceImages String? // 后台上传的发票图片JSON数组
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 售后申请
model AfterSalesRequest {
  id          Int      @id @default(autoincrement())
  memberId    Int
  orderNo     String
  reason      String
  detail      String?
  status      String   @default("pending") // pending|processing|approved|rejected
  adminNote   String?
  refundAmount Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 商品评价
model ProductReview {
  id        Int      @id @default(autoincrement())
  memberId  Int
  productId Int
  orderNo   String?
  rating    Int      @default(5)  // 1-5
  content   String?
  images    String?               // JSON 数组
  nickname  String?
  avatar    String?
  createdAt DateTime @default(now())
}

// 旅游套餐出发日期（后台可管理余量和价格）
model TravelDeparture {
  id            Int      @id @default(autoincrement())
  productId     Int      // 关联 TravelProduct.id
  productCode   String   // 冗余，方便查询
  departDate    String   // YYYY-MM-DD 出发日期
  endDate       String?  // 结束日期
  price         Float    @default(0)  // 该日期价格（覆盖产品默认价）
  stock         Int      @default(10) // 库存/余量
  status        Int      @default(1)  // 1上架 0下架
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DateInventory {
  id          Int      @id @default(autoincrement())
  type        String   // hotel_room | activity
  targetId    Int
  targetCode  String?
  date        String   // YYYY-MM-DD
  endDate     String?
  price       Float?
  stock       Int      @default(0)
  status      Int      @default(1)
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, targetId, date])
  @@index([type, targetCode, date])
}
